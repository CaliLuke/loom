openapi: 3.2.0
info:
    title: Collaboration Streams API
    description: Collaborative thread operations exposed through HTTP and SSE.
    license:
        name: Apache-2.0
        url: https://www.apache.org/licenses/LICENSE-2.0.html
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: collab-streams
      url: https://api.collab-streams.example.test
paths:
    /threads/{thread_id}:
        get:
            tags:
                - collabStreams
            summary: getThread collabStreams
            operationId: collab_streams.get_thread
            parameters:
                - $ref: '#/components/parameters/PathThreadID'
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/ThreadSummary'
                            example:
                                participants:
                                    - alice
                                    - bob
                                thread_id: thr_42
                                title: Release freeze follow-up
                "404":
                    description: 'not_found: Not Found response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
            security: []
    /threads/{thread_id}/events:
        get:
            operationId: collab_streams.watch_thread
            parameters:
                - $ref: '#/components/parameters/PathThreadID'
                - name: last_event_id
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: string
                  example: evt_7
            responses:
                "200":
                    description: OK response.
                    content:
                        text/event-stream:
                            itemSchema:
                                type: object
                                properties:
                                    data:
                                        type: string
                                        contentMediaType: application/json
                                        contentSchema:
                                            $ref: '#/components/schemas/WatchThreadResponseBody'
                                    id:
                                        type: string
                                required:
                                    - data
                                additionalProperties: false
                "429":
                    description: 'busy: Too Many Requests response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
            security: []
            summary: watchThread collabStreams
            tags:
                - collabStreams
            x-loom-async:
                direction: server
                handshake:
                    path: /threads/{thread_id}/events
                    request:
                        method: GET
                    response:
                        contentType: text/event-stream
                        status: 200
                messages:
                    outbound:
                        contentType: application/json
                        schema:
                            type: object
                            properties:
                                data:
                                    type: object
                                    properties:
                                        author:
                                            type: string
                                            example: alice
                                        preview:
                                            type: string
                                            example: Shipping the OpenAPI cleanup next.
                                    example:
                                        author: alice
                                        preview: Shipping the OpenAPI cleanup next.
                                    required:
                                        - author
                                        - preview
                                    additionalProperties: false
                                event:
                                    type: string
                                    example: thread.message_posted
                                id:
                                    type: string
                                    example: evt_8
                            example:
                                data:
                                    author: alice
                                    preview: Shipping the OpenAPI cleanup next.
                                event: thread.message_posted
                                id: evt_8
                            required:
                                - id
                                - event
                                - data
                            additionalProperties: false
                        sse:
                            dataField: null
                            eventField: null
                            idField: id
                            requestIDField: last_event_id
                            retryField: null
                transport: sse
components:
    schemas:
        Problem:
            type: object
            properties:
                code:
                    type: string
                    description: Code is the stable machine-readable problem code.
                    example: bad_request
                detail:
                    type: string
                    description: Detail is a human-readable explanation specific to this occurrence of the problem.
                    example: parameter 'p' must be an integer
                instance:
                    type: string
                    description: Instance identifies this specific occurrence of the problem.
                    example: urn:loom:error:123abc
                retry_hint:
                    type: string
                    description: Retry hint is concise guidance on how to correct the request or retry the operation.
                    example: Correct the payload and retry.
                status:
                    type: integer
                    description: Status is the HTTP status code generated for this occurrence of the problem.
                    example: 400
                    format: int64
                title:
                    type: string
                    description: Title is a short, human-readable summary of the problem type.
                    example: Bad Request
                type:
                    type: string
                    description: Type identifies the problem category using a URI reference.
                    example: https://github.com/CaliLuke/loom/problems/bad-request
            description: Problem response result type
            example:
                code: bad_request
                detail: parameter 'p' must be an integer
                instance: urn:loom:error:123abc
                retry_hint: Correct the payload and retry.
                status: 400
                title: Bad Request
                type: https://github.com/CaliLuke/loom/problems/bad-request
            required:
                - type
                - title
                - status
                - detail
                - instance
                - code
            additionalProperties: false
        ThreadSummary:
            type: object
            properties:
                participants:
                    type: array
                    items:
                        type: string
                        example: Cum nihil repudiandae aut quia.
                    example:
                        - alice
                        - bob
                thread_id:
                    type: string
                    example: thr_42
                    pattern: ^thr_[0-9]+$
                title:
                    type: string
                    example: Release freeze follow-up
            example:
                participants:
                    - alice
                    - bob
                thread_id: thr_42
                title: Release freeze follow-up
            required:
                - thread_id
                - title
            additionalProperties: false
        WatchThreadResponseBody:
            type: object
            properties:
                data:
                    type: object
                    properties:
                        author:
                            type: string
                            example: alice
                        preview:
                            type: string
                            example: Shipping the OpenAPI cleanup next.
                    example:
                        author: alice
                        preview: Shipping the OpenAPI cleanup next.
                    required:
                        - author
                        - preview
                    additionalProperties: false
                event:
                    type: string
                    example: thread.message_posted
                id:
                    type: string
                    example: evt_8
            example:
                data:
                    author: alice
                    preview: Shipping the OpenAPI cleanup next.
                event: thread.message_posted
                id: evt_8
            required:
                - id
                - event
                - data
            additionalProperties: false
    parameters:
        PathThreadID:
            name: thread_id
            in: path
            required: true
            schema:
                type: string
                pattern: ^thr_[0-9]+$
            example: thr_42
tags:
    - name: collabStreams
      description: Thread collaboration entry points.
