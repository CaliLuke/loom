{
  "components": {
    "examples": {
      "AuthRefreshRequestBodyBackupExample": {
        "summary": "backup",
        "value": {
          "legacyToken": "legacy-token-2",
          "password": "swordfish",
          "profile": "eyJyb2xlIjoiZWRpdG9yIn0=",
          "username": "bob"
        }
      },
      "AuthRefreshRequestBodyPrimaryExample": {
        "summary": "primary",
        "value": {
          "legacyToken": "legacy-token",
          "password": "hunter2",
          "profile": "eyJyb2xlIjoiYWRtaW4ifQ==",
          "username": "alice"
        }
      },
      "AuthRefreshStatus200ResponseCurrentExample": {
        "summary": "current",
        "value": {
          "expiresAt": "2026-03-20T12:00:00Z",
          "token": "token-123",
          "traceID": "trace_123"
        }
      },
      "AuthRefreshStatus200ResponseNextExample": {
        "summary": "next",
        "value": {
          "expiresAt": "2026-03-21T12:00:00Z",
          "token": "token-456",
          "traceID": "trace_456"
        }
      },
      "XTraceIDHeaderTraceAExample": {
        "summary": "trace-a",
        "value": "trace_123"
      },
      "XTraceIDHeaderTraceBExample": {
        "summary": "trace-b",
        "value": "trace_456"
      }
    },
    "headers": {
      "XTraceIDHeader": {
        "examples": {
          "trace-a": {
            "$ref": "#/components/examples/XTraceIDHeaderTraceAExample"
          },
          "trace-b": {
            "$ref": "#/components/examples/XTraceIDHeaderTraceBExample"
          }
        },
        "schema": {
          "example": "trace_456",
          "type": "string"
        }
      }
    },
    "requestBodies": {
      "CredentialsRequestBody": {
        "content": {
          "application/json": {
            "examples": {
              "backup": {
                "$ref": "#/components/examples/AuthRefreshRequestBodyBackupExample"
              },
              "primary": {
                "$ref": "#/components/examples/AuthRefreshRequestBodyPrimaryExample"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/Credentials"
            }
          }
        },
        "required": true
      }
    },
    "responses": {
      "NoContentResponse": {
        "description": "No Content response."
      },
      "Session_f01e4e234bbb10ecStatus200Response": {
        "content": {
          "application/json": {
            "examples": {
              "current": {
                "$ref": "#/components/examples/AuthRefreshStatus200ResponseCurrentExample"
              },
              "next": {
                "$ref": "#/components/examples/AuthRefreshStatus200ResponseNextExample"
              }
            },
            "schema": {
              "$ref": "#/components/schemas/Session_f01e4e234bbb10ec"
            }
          }
        },
        "description": "OK response.",
        "headers": {
          "X-Trace-ID": {
            "$ref": "#/components/headers/XTraceIDHeader"
          }
        }
      }
    },
    "schemas": {
      "Credentials": {
        "example": {
          "legacyToken": "legacy-token-2",
          "password": "swordfish",
          "profile": "eyJyb2xlIjoiZWRpdG9yIn0=",
          "username": "bob"
        },
        "properties": {
          "legacyToken": {
            "deprecated": true,
            "example": "legacy-token",
            "type": "string"
          },
          "password": {
            "example": "hunter2",
            "type": "string",
            "writeOnly": true
          },
          "profile": {
            "contentEncoding": "base64",
            "contentMediaType": "application/json",
            "example": "eyJyb2xlIjoiYWRtaW4ifQ==",
            "type": "string"
          },
          "username": {
            "example": "alice",
            "type": "string"
          }
        },
        "required": [
          "username",
          "password"
        ],
        "type": "object"
      },
      "Session_f01e4e234bbb10ec": {
        "example": {
          "expiresAt": "2026-03-21T12:00:00Z",
          "token": "token-456",
          "traceID": "trace_456"
        },
        "properties": {
          "expiresAt": {
            "example": "2026-03-20T12:00:00Z",
            "format": "date-time",
            "type": "string"
          },
          "token": {
            "example": "token-123",
            "readOnly": true,
            "type": "string"
          }
        },
        "required": [
          "token",
          "expiresAt"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Loom API",
    "version": "0.0.1"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
