openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /first:
        post:
            tags:
                - dedupService
            summary: first dedupService
            operationId: dedup_service.first
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            $ref: '#/components/schemas/FirstRequestBody'
                        example:
                            name: Natus omnis minus eligendi.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /second:
        post:
            tags:
                - dedupService
            summary: second dedupService
            operationId: dedup_service.second
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            $ref: '#/components/schemas/FirstRequestBody'
                        example:
                            name: Iste at.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /union/first:
        post:
            tags:
                - dedupService
            summary: union_first dedupService
            operationId: dedup_service.union_first
            requestBody:
                $ref: '#/components/requestBodies/DedupServiceUnionFirstRequestBody'
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /union/second:
        post:
            tags:
                - dedupService
            summary: union_second dedupService
            operationId: dedup_service.union_second
            requestBody:
                $ref: '#/components/requestBodies/DedupServiceUnionFirstRequestBody'
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
components:
    schemas:
        AlphaSchemaDedup:
            type: object
            properties:
                alpha:
                    type: string
                    example: Ducimus voluptatem et quia.
            example:
                alpha: Voluptates cumque tempore voluptas accusantium.
            required:
                - alpha
        AlphaSchemaDedupOrBetaSchemaDedupAlphaSchemaDedupEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - AlphaSchemaDedup
                value:
                    example:
                        alpha: Amet eum id ipsum fugit.
                    $ref: '#/components/schemas/AlphaSchemaDedup'
            description: Synthetic wrapper for union variant "AlphaSchemaDedup".
            required:
                - type
                - value
        AlphaSchemaDedupOrBetaSchemaDedupBetaSchemaDedupEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - BetaSchemaDedup
                value:
                    example:
                        beta: Sed suscipit.
                    $ref: '#/components/schemas/BetaSchemaDedup'
            description: Synthetic wrapper for union variant "BetaSchemaDedup".
            required:
                - type
                - value
        BetaSchemaDedup:
            type: object
            properties:
                beta:
                    type: string
                    example: Esse quam ut velit quia dolores iure.
            example:
                beta: Atque adipisci.
            required:
                - beta
        FirstRequestBody:
            type: object
            properties:
                name:
                    type: string
                    example: Esse minima ipsa commodi recusandae.
            example:
                name: Dignissimos ut sint in quisquam expedita voluptas.
            required:
                - name
    requestBodies:
        DedupServiceUnionFirstRequestBody:
            required: true
            content:
                application/json:
                    schema:
                        type: object
                        example:
                            type: AlphaSchemaDedup
                            value:
                                alpha: Quod molestias corporis.
                        oneOf:
                            - $ref: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupAlphaSchemaDedupEnvelope'
                            - $ref: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupBetaSchemaDedupEnvelope'
                        discriminator:
                            propertyName: type
                            mapping:
                                AlphaSchemaDedup: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupAlphaSchemaDedupEnvelope'
                                BetaSchemaDedup: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupBetaSchemaDedupEnvelope'
                    example:
                        type: BetaSchemaDedup
                        value:
                            beta: Ducimus molestiae labore tenetur.
    responses:
        NoContentResponse:
            description: No Content response.
tags:
    - name: dedupService
