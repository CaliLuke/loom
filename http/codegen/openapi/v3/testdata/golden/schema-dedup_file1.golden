openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /first:
        post:
            tags:
                - dedupService
            summary: first dedupService
            operationId: dedup_service.first
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            example:
                                name: Voluptatem ratione culpa unde.
                            $ref: '#/components/schemas/FirstRequestBody'
                        example:
                            name: Voluptatem ratione culpa unde.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /second:
        post:
            tags:
                - dedupService
            summary: second dedupService
            operationId: dedup_service.second
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            example:
                                name: Occaecati provident qui.
                            $ref: '#/components/schemas/FirstRequestBody'
                        example:
                            name: Occaecati provident qui.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /union/first:
        post:
            tags:
                - dedupService
            summary: union_first dedupService
            operationId: dedup_service.union_first
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            example:
                                type: AlphaSchemaDedup
                                value:
                                    alpha: Sunt ipsum adipisci quasi in.
                            oneOf:
                                - $ref: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupAlphaSchemaDedupEnvelope'
                                - $ref: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupBetaSchemaDedupEnvelope'
                            discriminator:
                                propertyName: type
                                mapping:
                                    AlphaSchemaDedup: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupAlphaSchemaDedupEnvelope'
                                    BetaSchemaDedup: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupBetaSchemaDedupEnvelope'
                        example:
                            type: AlphaSchemaDedup
                            value:
                                alpha: Sunt ipsum adipisci quasi in.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /union/second:
        post:
            tags:
                - dedupService
            summary: union_second dedupService
            operationId: dedup_service.union_second
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            example:
                                type: BetaSchemaDedup
                                value:
                                    beta: Totam occaecati sequi autem debitis provident.
                            oneOf:
                                - $ref: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupAlphaSchemaDedupEnvelope'
                                - $ref: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupBetaSchemaDedupEnvelope'
                            discriminator:
                                propertyName: type
                                mapping:
                                    AlphaSchemaDedup: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupAlphaSchemaDedupEnvelope'
                                    BetaSchemaDedup: '#/components/schemas/AlphaSchemaDedupOrBetaSchemaDedupBetaSchemaDedupEnvelope'
                        example:
                            type: BetaSchemaDedup
                            value:
                                beta: Totam occaecati sequi autem debitis provident.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
components:
    schemas:
        AlphaSchemaDedup:
            type: object
            properties:
                alpha:
                    type: string
                    example: Et veritatis et ea aut ratione.
            example:
                alpha: Quaerat optio odio qui expedita aut.
            required:
                - alpha
        AlphaSchemaDedupOrBetaSchemaDedupAlphaSchemaDedupEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - AlphaSchemaDedup
                value:
                    example:
                        alpha: Illo unde neque ea non.
                    $ref: '#/components/schemas/AlphaSchemaDedup'
            description: Synthetic wrapper for union variant "AlphaSchemaDedup".
            required:
                - type
                - value
        AlphaSchemaDedupOrBetaSchemaDedupBetaSchemaDedupEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - BetaSchemaDedup
                value:
                    example:
                        beta: Sed omnis quos.
                    $ref: '#/components/schemas/BetaSchemaDedup'
            description: Synthetic wrapper for union variant "BetaSchemaDedup".
            required:
                - type
                - value
        BetaSchemaDedup:
            type: object
            properties:
                beta:
                    type: string
                    example: Voluptas dolorem facilis praesentium modi impedit nulla.
            example:
                beta: Aut accusamus.
            required:
                - beta
        FirstRequestBody:
            type: object
            properties:
                name:
                    type: string
                    example: Et quibusdam voluptate repellat aut.
            example:
                name: Rem debitis.
            required:
                - name
    responses:
        NoContentResponse:
            description: No Content response.
tags:
    - name: dedupService
