openapi: 3.1.1
info:
    title: Streaming Partial Examples API
    description: Exercises suppression of invalid synthetic examples for streaming responses.
    license:
        name: Apache-2.0
        url: https://www.apache.org/licenses/LICENSE-2.0.html
    version: 0.0.1
jsonSchemaDialect: https://json-schema.org/draft/2020-12/schema
servers:
    - url: https://api.streaming-partial-examples.example.test
paths:
    /events:
        get:
            operationId: streaming_partial_examples.events
            responses:
                "200":
                    content:
                        text/event-stream:
                            schema:
                                $ref: '#/components/schemas/RealtimeSSEEvent'
                    description: OK response.
            security: []
            summary: events streamingPartialExamples
            tags:
                - streamingPartialExamples
            x-goa-async:
                direction: server
                handshake:
                    path: /events
                    request:
                        method: GET
                    response:
                        contentType: text/event-stream
                        status: 200
                messages:
                    outbound:
                        contentType: application/json
                        schema:
                            type: object
                            properties:
                                data:
                                    type: object
                                    properties:
                                        message:
                                            type: string
                                            example: Incidunt assumenda voluptate autem.
                                    example:
                                        message: Magnam repellat tenetur quia aut earum.
                                    required:
                                        - message
                                event:
                                    type: string
                                    example: abc123
                            example:
                                data:
                                    message: A nisi porro aspernatur maxime et in.
                                event: abc123
                            required:
                                - event
                                - data
                        sse:
                            dataField: null
                            eventField: null
                            idField: null
                            requestIDField: null
                            retryField: null
                transport: sse
    /ws/projects/{projectID}:
        get:
            operationId: streaming_partial_examples.project_socket
            parameters:
                - example: proj_1
                  in: path
                  name: projectID
                  required: true
                  schema:
                    example: proj_1
                    type: string
            responses:
                "101":
                    description: Switching Protocols response.
            security: []
            summary: projectSocket streamingPartialExamples
            tags:
                - streamingPartialExamples
            x-goa-async:
                direction: server
                handshake:
                    path: /ws/projects/{projectID}
                    request:
                        method: GET
                    response:
                        contentType: ""
                        status: 101
                messages:
                    outbound:
                        contentType: application/json
                        schema:
                            type: object
                            properties:
                                event:
                                    type: string
                                    example: Quis ut.
                                ts:
                                    type: integer
                                    example: 1
                                    format: int64
                            example:
                                event: Ad exercitationem qui consequuntur non.
                                ts: 1
                            required:
                                - ts
                                - event
                transport: websocket
components:
    schemas:
        RealtimeSSEEvent:
            type: object
            properties:
                data:
                    type: object
                    properties:
                        message:
                            type: string
                            example: Autem placeat illo ut autem itaque.
                    example:
                        message: Maxime voluptatem.
                    required:
                        - message
                event:
                    type: string
                    example: abc123
            example:
                data:
                    message: Non corporis commodi.
                event: abc123
            required:
                - event
                - data
tags:
    - name: streamingPartialExamples
