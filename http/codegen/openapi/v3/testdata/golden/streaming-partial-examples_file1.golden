openapi: 3.2.0
info:
    title: Streaming Partial Examples API
    description: Exercises suppression of invalid synthetic examples for streaming responses.
    license:
        name: Apache-2.0
        url: https://www.apache.org/licenses/LICENSE-2.0.html
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: streaming-partial-examples
      url: https://api.streaming-partial-examples.example.test
paths:
    /events:
        get:
            operationId: streaming_partial_examples.events
            responses:
                "200":
                    description: OK response.
                    content:
                        text/event-stream:
                            itemSchema:
                                type: object
                                properties:
                                    data:
                                        type: string
                                        contentMediaType: application/json
                                        contentSchema:
                                            $ref: '#/components/schemas/RealtimeSSEEvent'
                                required:
                                    - data
                                additionalProperties: false
            security: []
            summary: events streamingPartialExamples
            tags:
                - streamingPartialExamples
            x-loom-async:
                direction: server
                handshake:
                    path: /events
                    request:
                        method: GET
                    response:
                        contentType: text/event-stream
                        status: 200
                messages:
                    outbound:
                        contentType: application/json
                        schema:
                            type: object
                            properties:
                                data:
                                    type: object
                                    properties:
                                        message:
                                            type: string
                                            example: Reprehenderit alias.
                                    example:
                                        message: Non non et autem neque ipsam.
                                    required:
                                        - message
                                event:
                                    type: string
                                    example: abc123
                            example:
                                data:
                                    message: Ipsa in nemo nihil quis nihil est.
                                event: abc123
                            required:
                                - event
                                - data
                        sse:
                            dataField: null
                            eventField: null
                            idField: null
                            requestIDField: null
                            retryField: null
                transport: sse
    /metadata:
        get:
            tags:
                - streamingPartialExamples
            summary: metadata streamingPartialExamples
            operationId: streaming_partial_examples.metadata
            parameters:
                - name: chunks
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: AP8=
                        format: binary
                  example:
                    - AP8=
            responses:
                "200":
                    description: OK response.
                    headers:
                        X-Checksum:
                            schema:
                                type: string
                                example: AP8=
                                format: binary
                            example: AP8=
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/MetadataResponseBody'
                            example:
                                label: Ipsam quia.
            security: []
    /ws/projects/{projectID}:
        get:
            operationId: streaming_partial_examples.project_socket
            parameters:
                - name: projectID
                  in: path
                  required: true
                  schema:
                    type: string
                  example: proj_1
            responses:
                "101":
                    description: Switching Protocols response.
            security: []
            summary: projectSocket streamingPartialExamples
            tags:
                - streamingPartialExamples
            x-loom-async:
                direction: server
                handshake:
                    path: /ws/projects/{projectID}
                    request:
                        method: GET
                    response:
                        contentType: ""
                        status: 101
                messages:
                    outbound:
                        contentType: application/json
                        schema:
                            type: object
                            properties:
                                attachment:
                                    type: string
                                    example: AP8=
                                    format: binary
                                event:
                                    type: string
                                    example: Recusandae error sint.
                                note:
                                    example: null
                                    anyOf:
                                        - type: string
                                        - type: "null"
                                ts:
                                    type: integer
                                    example: 1
                                    format: int64
                            required:
                                - ts
                                - event
                transport: websocket
components:
    schemas:
        MetadataResponseBody:
            type: object
            properties:
                label:
                    type: string
                    example: Id ipsam voluptatibus dolores atque soluta.
            example:
                label: Sint beatae occaecati.
            required:
                - label
        RealtimeSSEEvent:
            type: object
            properties:
                data:
                    type: object
                    properties:
                        message:
                            type: string
                            example: Quis quae voluptatum.
                    example:
                        message: Ut voluptate quis voluptas commodi suscipit et.
                    required:
                        - message
                event:
                    type: string
                    example: abc123
            example:
                data:
                    message: Qui tenetur.
                event: abc123
            required:
                - event
                - data
tags:
    - name: streamingPartialExamples
