{
  "info": {
    "description": "WebSocket control surface for operator consoles.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "title": "Ops Socket API",
    "version": "0.0.1"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "openapi": "3.2.0",
  "paths": {
    "/ws/ops/{channel}": {
      "get": {
        "operationId": "ops_socket.stream_commands",
        "parameters": [
          {
            "example": "deployments",
            "in": "path",
            "name": "channel",
            "required": true,
            "schema": {
              "example": "deployments",
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols response."
          }
        },
        "security": [],
        "summary": "streamCommands opsSocket",
        "tags": [
          "opsSocket"
        ],
        "x-loom-async": {
          "direction": "bidirectional",
          "handshake": {
            "path": "/ws/ops/{channel}",
            "request": {
              "method": "GET"
            },
            "response": {
              "contentType": "",
              "status": 101
            }
          },
          "messages": {
            "inbound": {
              "contentType": "application/json",
              "schema": {
                "additionalProperties": false,
                "example": {
                  "op": "pause",
                  "target": "worker-eu-1"
                },
                "properties": {
                  "op": {
                    "example": "pause",
                    "type": "string"
                  },
                  "target": {
                    "example": "worker-eu-1",
                    "type": "string"
                  }
                },
                "required": [
                  "op",
                  "target"
                ],
                "type": "object"
              }
            },
            "outbound": {
              "contentType": "application/json",
              "schema": {
                "additionalProperties": false,
                "example": {
                  "event": "command.accepted",
                  "ok": true
                },
                "properties": {
                  "event": {
                    "example": "command.accepted",
                    "type": "string"
                  },
                  "ok": {
                    "example": true,
                    "type": "boolean"
                  }
                },
                "required": [
                  "event",
                  "ok"
                ],
                "type": "object"
              }
            }
          },
          "transport": "websocket"
        }
      }
    }
  },
  "servers": [
    {
      "name": "ops-socket",
      "url": "https://api.ops-socket.example.test"
    }
  ],
  "tags": [
    {
      "description": "Bidirectional operator control channel.",
      "name": "opsSocket"
    }
  ]
}
