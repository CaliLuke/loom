{
  "components": {
    "parameters": {
      "PathWidgetID": {
        "description": "Widget identifier.",
        "example": "widget-123",
        "in": "path",
        "name": "widgetID",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "QueryLimit": {
        "allowEmptyValue": true,
        "description": "Page size.",
        "example": 25,
        "in": "query",
        "name": "limit",
        "schema": {
          "format": "int64",
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "responses": {
