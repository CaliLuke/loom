openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: parameter-styles
      url: http://localhost:80
      description: Default server for parameter-styles
paths:
    /CookieDefault:
        get:
            tags:
                - styles
            summary: CookieDefault styles
            operationId: styles.cookie_default
            parameters:
                - name: value
                  in: cookie
                  schema:
                    type: string
                    default: blue
                  example: Quia magni aliquid voluptates.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /CookieExploded:
        get:
            tags:
                - styles
            summary: CookieExploded styles
            operationId: styles.cookie_exploded
            parameters:
                - name: value
                  in: cookie
                  style: cookie
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Voluptate rerum.
                  example:
                    - Repellat dolore aut inventore aut iste quae.
                    - Iusto et et praesentium numquam.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /CookieForm:
        get:
            tags:
                - styles
            summary: CookieForm styles
            operationId: styles.cookie_form
            parameters:
                - name: value
                  in: cookie
                  explode: false
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Ut quam fuga consequatur accusamus qui.
                  example:
                    - Ullam vero.
                    - Aut velit eius deleniti.
                    - Ad tempora cumque.
                    - Dolores ducimus in vitae minima.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /CookieList:
        get:
            tags:
                - styles
            summary: CookieList styles
            operationId: styles.cookie_list
            parameters:
                - name: value
                  in: cookie
                  style: cookie
                  explode: false
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Quia in qui neque.
                  example:
                    - Saepe quo qui dolor delectus animi.
                    - Error blanditiis.
                    - Ad quo sint exercitationem ratione repellat.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /CookieMap:
        get:
            tags:
                - styles
            summary: CookieMap styles
            operationId: styles.cookie_map
            parameters:
                - name: value
                  in: cookie
                  style: cookie
                  required: true
                  schema:
                    type: object
                    additionalProperties:
                        type: string
                        example: Ab earum tempora doloribus reprehenderit perferendis.
                  example:
                    Accusantium sint aliquam facere nam reprehenderit.: Officia quae beatae consequatur itaque harum eveniet.
                - name: sid
                  in: cookie
                  style: cookie
                  required: true
                  schema:
                    type: string
                  example: Itaque voluptate laudantium iste omnis et alias.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /CookieScalar:
        get:
            tags:
                - styles
            summary: CookieScalar styles
            operationId: styles.cookie_scalar
            parameters:
                - name: value
                  in: cookie
                  style: cookie
                  required: true
                  schema:
                    type: string
                  example: Provident ut nam rerum officia.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /FormFields:
        post:
            tags:
                - styles
            summary: FormFields styles
            operationId: styles.form_fields
            parameters:
                - name: search
                  in: query
                  explode: false
                  allowEmptyValue: true
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Et velit expedita eos nemo et magni.
                  example:
                    - Architecto dolorem quis doloremque dolor earum.
                    - Officia sed sed beatae quos.
            requestBody:
                required: true
                content:
                    application/x-www-form-urlencoded:
                        schema:
                            type: object
                            properties:
                                attributes:
                                    type: object
                                    example:
                                        Aut nihil laudantium possimus aut.: Vel excepturi rerum necessitatibus magnam necessitatibus ea.
                                        Eos vel accusantium voluptatibus.: Ad nisi et provident voluptatem velit.
                                        Rem neque sit.: Quas impedit perspiciatis ullam quod adipisci maxime.
                                    additionalProperties:
                                        type: string
                                        example: Aut autem excepturi quod sed eveniet est.
                                facets:
                                    $ref: '#/components/schemas/ParameterRange'
                                filter:
                                    $ref: '#/components/schemas/ParameterRange'
                                flags:
                                    type: object
                                    example:
                                        Recusandae eum vero rerum recusandae animi.: Qui qui in fuga accusamus sed illum.
                                        Rerum ea blanditiis in ratione et.: Provident quibusdam beatae atque.
                                    additionalProperties:
                                        type: string
                                        example: Quis et expedita non.
                                jsonattrs:
                                    type: object
                                    example:
                                        Maxime dolorem et repellat sunt magni omnis.: Aut accusamus qui nisi tenetur expedita voluptatem.
                                        Sed ullam.: Est et.
                                        Unde voluptatem dolore dolore quo consequatur.: Eveniet reiciendis.
                                    additionalProperties:
                                        type: string
                                        example: Aliquid et enim sapiente aliquid aut.
                                owner:
                                    type: string
                                    example: Maiores repudiandae neque alias sint molestias.
                                tags:
                                    type: array
                                    items:
                                        type: string
                                        example: Et veniam repellat libero magni alias.
                                    example:
                                        - Earum accusamus molestias et nisi fuga.
                                        - Quo autem vero quia quisquam.
                            example:
                                attributes:
                                    Magni minima sit maxime.: Adipisci reprehenderit.
                                facets:
                                    G: Ullam perferendis vitae unde quam molestiae omnis.
                                    R: Eligendi occaecati debitis error.
                                filter:
                                    G: Ullam perferendis vitae unde quam molestiae omnis.
                                    R: Eligendi occaecati debitis error.
                                flags:
                                    Eum voluptas praesentium.: Est asperiores.
                                jsonattrs:
                                    Alias tempora expedita aut incidunt vel.: Molestiae dolores neque eos est illum.
                                    Earum hic.: Molestiae aut qui.
                                owner: Totam omnis corrupti et et.
                                tags:
                                    - Reprehenderit ut laudantium perferendis.
                                    - Ut eos animi quidem.
                            required:
                                - filter
                                - tags
                                - attributes
                                - flags
                                - facets
                                - jsonattrs
                                - owner
                        example:
                            attributes:
                                Distinctio aliquam sunt quod doloribus.: Quasi id.
                            facets:
                                G: Nisi atque quo veniam.
                                R: Vel labore rerum neque labore sed.
                            filter:
                                G: Nisi atque quo veniam.
                                R: Vel labore rerum neque labore sed.
                            flags:
                                Iste quam est nesciunt reiciendis.: Aut sequi dolor consequuntur quisquam deserunt.
                                Quia quia mollitia.: Enim in.
                            jsonattrs:
                                Ullam quaerat non eaque.: Provident nulla ullam minima.
                            owner: Eaque sit temporibus.
                            tags:
                                - Facilis autem iusto.
                                - Voluptate enim iusto labore perspiciatis molestias eos.
                                - Numquam animi.
                        encoding:
                            attributes:
                                style: form
                                explode: false
                            facets:
                                style: form
                            filter:
                                style: deepObject
                            flags:
                                style: form
                            jsonattrs:
                                contentType: application/json
                            tags:
                                style: form
                                explode: false
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /HeaderMap:
        get:
            tags:
                - styles
            summary: HeaderMap styles
            operationId: styles.header_map
            parameters:
                - name: X-Value
                  in: header
                  required: true
                  schema:
                    type: object
                    additionalProperties:
                        type: string
                        example: Iure necessitatibus dolorem.
                  example:
                    Aspernatur vel.: Qui molestiae debitis fuga et.
                    Provident ipsum dolores.: Unde autem.
                    Repellendus temporibus.: Aliquid nemo.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /HeaderMapExploded:
        get:
            tags:
                - styles
            summary: HeaderMapExploded styles
            operationId: styles.header_map_exploded
            parameters:
                - name: X-Value
                  in: header
                  explode: true
                  required: true
                  schema:
                    type: object
                    additionalProperties:
                        type: string
                        example: Reiciendis amet aspernatur velit hic.
                  example:
                    Deleniti consequuntur sit quidem nostrum aut.: Assumenda numquam iusto voluptas tenetur aut.
                    Et fuga sint magnam eos.: Voluptatem consequatur omnis iste vitae itaque.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /HeaderObject:
        get:
            tags:
                - styles
            summary: HeaderObject styles
            operationId: styles.header_object
            parameters:
                - name: X-Value
                  in: header
                  explode: true
                  required: true
                  schema:
                    $ref: '#/components/schemas/ParameterRange'
                  example:
                    G: Natus quis eaque.
                    R: Et officiis aut nam.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /PathLabel/{value}:
        get:
            tags:
                - styles
            summary: PathLabel styles
            operationId: styles.path_label
            parameters:
                - name: value
                  in: path
                  style: label
                  required: true
                  schema:
                    type: string
                  example: Delectus veritatis veritatis vel reprehenderit illo vero.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /PathLabelExploded/{value}:
        get:
            tags:
                - styles
            summary: PathLabelExploded styles
            operationId: styles.path_label_exploded
            parameters:
                - name: value
                  in: path
                  style: label
                  explode: true
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Repudiandae fugit perspiciatis atque.
                  example:
                    - Autem minus quas.
                    - Dolor velit voluptatibus et tenetur explicabo officia.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /PathLabelList/{value}:
        get:
            tags:
                - styles
            summary: PathLabelList styles
            operationId: styles.path_label_list
            parameters:
                - name: value
                  in: path
                  style: label
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Fugiat eligendi quos est maxime aliquid voluptatem.
                  example:
                    - Iusto nesciunt asperiores asperiores quae.
                    - Laboriosam sequi nihil.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /PathList/{value}:
        get:
            tags:
                - styles
            summary: PathList styles
            operationId: styles.path_list
            parameters:
                - name: value
                  in: path
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Sint saepe.
                  example:
                    - Eos minima.
                    - Adipisci quidem commodi.
                    - Eos voluptatem delectus.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /PathMap/{value}:
        get:
            tags:
                - styles
            summary: PathMap styles
            operationId: styles.path_map
            parameters:
                - name: value
                  in: path
                  style: matrix
                  explode: true
                  required: true
                  schema:
                    type: object
                    additionalProperties:
                        type: string
                        example: Dolores maiores impedit.
                  example:
                    Autem consequatur.: Iste incidunt et inventore et dicta.
                    Eum magnam ea voluptas eligendi.: Eaque occaecati deserunt rerum aperiam porro.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /PathMatrix/{value}:
        get:
            tags:
                - styles
            summary: PathMatrix styles
            operationId: styles.path_matrix
            parameters:
                - name: value
                  in: path
                  style: matrix
                  required: true
                  schema:
                    type: string
                  example: Et rerum et et sequi.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /PathMatrixList/{value}:
        get:
            tags:
                - styles
            summary: PathMatrixList styles
            operationId: styles.path_matrix_list
            parameters:
                - name: value
                  in: path
                  style: matrix
                  explode: true
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Molestiae culpa commodi laborum.
                  example:
                    - Eos corrupti expedita sapiente eos sed.
                    - Hic praesentium laboriosam velit.
                    - Tempore perspiciatis aut molestiae et dolorem numquam.
                    - Et quod deserunt enim vel voluptas eum.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /PathObject/{value}:
        get:
            tags:
                - styles
            summary: PathObject styles
            operationId: styles.path_object
            parameters:
                - name: value
                  in: path
                  explode: true
                  required: true
                  schema:
                    $ref: '#/components/schemas/ParameterRange'
                  example:
                    G: Voluptatem autem non mollitia.
                    R: Dolor voluptas.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /PathSimple/{value}:
        get:
            tags:
                - styles
            summary: PathSimple styles
            operationId: styles.path_simple
            parameters:
                - name: value
                  in: path
                  required: true
                  schema:
                    type: string
                  example: Aspernatur omnis.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryJSON:
        get:
            tags:
                - styles
            summary: QueryJSON styles
            operationId: styles.query_json
            parameters:
                - name: value
                  in: query
                  required: true
                  content:
                    application/json:
                        schema:
                            type: object
                            additionalProperties:
                                type: string
                                example: Voluptas nobis.
                        example:
                            Aspernatur magnam repellat est autem tempore vitae.: Aut inventore ipsum ad perspiciatis ut et.
                            Sed dolorem esse nesciunt est doloremque.: Ab omnis debitis voluptas.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryList:
        get:
            tags:
                - styles
            summary: QueryList styles
            operationId: styles.query_list
            parameters:
                - name: value
                  in: query
                  explode: false
                  allowEmptyValue: true
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: At repudiandae reiciendis.
                  example:
                    - Eum vitae.
                    - Necessitatibus qui dolores expedita omnis rem consequatur.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryListDefault:
        get:
            tags:
                - styles
            summary: QueryListDefault styles
            operationId: styles.query_list_default
            parameters:
                - name: value
                  in: query
                  explode: false
                  allowEmptyValue: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Doloribus ipsa veritatis est id totam.
                    default:
                        - blue
                  example:
                    - Impedit consectetur necessitatibus necessitatibus nesciunt voluptas voluptas.
                    - Quaerat alias ut saepe.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryMap:
        get:
            tags:
                - styles
            summary: QueryMap styles
            operationId: styles.query_map
            parameters:
                - name: value
                  in: query
                  style: deepObject
                  allowEmptyValue: true
                  required: true
                  schema:
                    type: object
                    additionalProperties:
                        type: string
                        example: Cumque laborum quia voluptate ad animi ad.
                  example:
                    Qui accusantium.: Aperiam saepe.
                    Quis quia ex et.: Sint fuga aut sit aut corporis ut.
                    Voluptates quo illum officia deleniti eos nesciunt.: Rerum modi numquam alias.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryObject:
        get:
            tags:
                - styles
            summary: QueryObject styles
            operationId: styles.query_object
            parameters:
                - name: value
                  in: query
                  style: deepObject
                  allowEmptyValue: true
                  required: true
                  schema:
                    $ref: '#/components/schemas/ParameterRange'
                  example:
                    G: Atque fuga aut vitae ex.
                    R: Cum qui.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryObjectBytes:
        get:
            tags:
                - styles
            summary: QueryObjectBytes styles
            operationId: styles.query_object_bytes
            parameters:
                - name: value
                  in: query
                  style: deepObject
                  allowEmptyValue: true
                  required: true
                  schema:
                    $ref: '#/components/schemas/ParameterBytes'
                  example:
                    R: Quae mollitia quis.
                    data: RXN0IGluY2lkdW50IHRlbXBvcmlidXMgYWIgbmloaWwu
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryObjectDefault:
        get:
            tags:
                - styles
            summary: QueryObjectDefault styles
            operationId: styles.query_object_default
            parameters:
                - name: value
                  in: query
                  style: deepObject
                  allowEmptyValue: true
                  required: true
                  schema:
                    $ref: '#/components/schemas/ParameterDefaults'
                  example:
                    G: 9183222342072641127
                    R: Vitae qui voluptate omnis.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryObjectPlain:
        get:
            tags:
                - styles
            summary: QueryObjectPlain styles
            operationId: styles.query_object_plain
            parameters:
                - name: value
                  in: query
                  explode: false
                  allowEmptyValue: true
                  required: true
                  schema:
                    $ref: '#/components/schemas/ParameterRange'
                  example:
                    G: Est tenetur ipsum eligendi iste.
                    R: Autem ab.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryOptional:
        get:
            tags:
                - styles
            summary: QueryOptional styles
            operationId: styles.query_optional
            parameters:
                - name: value
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Quia enim blanditiis sapiente dicta aut repudiandae.
                  example:
                    - Sit eligendi.
                    - Voluptate ad itaque.
                    - Amet aut eveniet velit neque minus voluptas.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryPipe:
        get:
            tags:
                - styles
            summary: QueryPipe styles
            operationId: styles.query_pipe
            parameters:
                - name: value
                  in: query
                  style: pipeDelimited
                  allowEmptyValue: true
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Impedit sunt.
                  example:
                    - Eaque minima natus consequuntur et.
                    - Expedita qui necessitatibus suscipit.
                    - Laborum autem dolor illum.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryRequired:
        get:
            tags:
                - styles
            summary: QueryRequired styles
            operationId: styles.query_required
            parameters:
                - name: value
                  in: query
                  allowEmptyValue: true
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Nisi adipisci natus error.
                  example:
                    - Nisi ullam velit officia ut ad.
                    - Quo dolores ad enim.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QueryResidual:
        get:
            tags:
                - styles
            summary: QueryResidual styles
            operationId: styles.query_residual
            parameters:
                - name: value
                  in: query
                  allowEmptyValue: true
                  required: true
                  schema:
                    type: object
                    additionalProperties:
                        type: string
                        example: Et quis et harum quas consequatur.
                  example:
                    In harum.: Commodi dolorem voluptas accusantium et.
                    Quas modi eos quasi explicabo.: Nesciunt consequatur distinctio est molestiae omnis.
                    Vel eum.: Sed natus autem non veniam voluptatem.
                - name: control
                  in: query
                  allowEmptyValue: true
                  required: true
                  schema:
                    type: string
                  example: Blanditiis quaerat voluptas corporis.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /QuerySpace:
        get:
            tags:
                - styles
            summary: QuerySpace styles
            operationId: styles.query_space
            parameters:
                - name: value
                  in: query
                  style: spaceDelimited
                  allowEmptyValue: true
                  required: true
                  schema:
                    type: array
                    items:
                        type: string
                        example: Eveniet aliquam fugiat occaecati consequatur ut voluptatem.
                  example:
                    - Similique assumenda enim eligendi corporis ad ipsa.
                    - Quam porro adipisci dolor et ut.
                    - Dolor sunt hic porro.
                    - Nostrum ad.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /ResponseMap:
        get:
            tags:
                - styles
            summary: ResponseMap styles
            operationId: styles.response_map
            responses:
                "204":
                    description: No Content response.
                    headers:
                        X-Labels:
                            explode: true
                            schema:
                                type: object
                                example:
                                    Ducimus sequi ut et qui non.: Aut soluta tenetur ut eveniet.
                                    Maiores qui aut sit aut.: Exercitationem et sit error ipsum.
                                additionalProperties:
                                    type: string
                                    example: Ipsa natus excepturi asperiores est explicabo ea.
                            example:
                                Ducimus sequi ut et qui non.: Aut soluta tenetur ut eveniet.
                                Maiores qui aut sit aut.: Exercitationem et sit error ipsum.
components:
    schemas:
        ParameterBytes:
            type: object
            properties:
                R:
                    type: string
                    example: Distinctio doloremque.
                data:
                    type: string
                    example: RXN0IGN1bSBpdXJlIHZlbGl0IHZvbHVwdGF0aWJ1cyBpdXJlLg==
                    format: binary
            example:
                R: Tempore dicta et nulla labore dolorem corrupti.
                data: TW9sZXN0aWFlIGlzdGUu
            required:
                - R
        ParameterDefaults:
            type: object
            properties:
                G:
                    type: integer
                    default: 7
                    example: 4789626130940245864
                    format: int64
                R:
                    type: string
                    example: Quibusdam quae.
            example:
                G: 4317925121676994202
                R: Cumque fugit.
            required:
                - R
        ParameterRange:
            type: object
            properties:
                G:
                    type: string
                    example: Et consequatur ab.
                R:
                    type: string
                    example: Minus temporibus unde.
            example:
                G: Vel fugiat corporis aut illum.
                R: Aut veritatis quia.
            required:
                - R
                - G
    responses:
        NoContentResponse:
            description: No Content response.
tags:
    - name: styles
