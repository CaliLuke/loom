openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /listings:
        get:
            tags:
                - ServiceExplicitBodyResultType
            summary: MethodImplicitBodyResultType ServiceExplicitBodyResultType
            operationId: service_explicit_body_result_type.method_implicit_body_result_type
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    first:
                                        id: Fugit illum expedita dolor voluptatem expedita assumenda.
                                        name: Dolorem veniam amet modi omnis voluptatem error.
                                    items:
                                        - id: Fugit illum expedita dolor voluptatem expedita assumenda.
                                          name: Dolorem veniam amet modi omnis voluptatem error.
                                        - id: Fugit illum expedita dolor voluptatem expedita assumenda.
                                          name: Dolorem veniam amet modi omnis voluptatem error.
                                    next: Maiores nemo incidunt aspernatur possimus omnis.
                                $ref: '#/components/schemas/Listing'
                            example:
                                first:
                                    id: Fugit illum expedita dolor voluptatem expedita assumenda.
                                    name: Dolorem veniam amet modi omnis voluptatem error.
                                items:
                                    - id: Fugit illum expedita dolor voluptatem expedita assumenda.
                                      name: Dolorem veniam amet modi omnis voluptatem error.
                                    - id: Fugit illum expedita dolor voluptatem expedita assumenda.
                                      name: Dolorem veniam amet modi omnis voluptatem error.
                                next: Maiores nemo incidunt aspernatur possimus omnis.
            security: []
        post:
            tags:
                - ServiceExplicitBodyResultType
            summary: MethodExplicitBodyResultType ServiceExplicitBodyResultType
            operationId: service_explicit_body_result_type.method_explicit_body_result_type
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    first:
                                        id: Ex expedita necessitatibus veritatis qui maiores.
                                        name: Et doloribus est temporibus eos in.
                                    items:
                                        - id: Ex expedita necessitatibus veritatis qui maiores.
                                          name: Et doloribus est temporibus eos in.
                                        - id: Ex expedita necessitatibus veritatis qui maiores.
                                          name: Et doloribus est temporibus eos in.
                                    next: Vel vel error harum.
                                $ref: '#/components/schemas/Listing'
                            example:
                                first:
                                    id: Ex expedita necessitatibus veritatis qui maiores.
                                    name: Et doloribus est temporibus eos in.
                                items:
                                    - id: Ex expedita necessitatibus veritatis qui maiores.
                                      name: Et doloribus est temporibus eos in.
                                    - id: Ex expedita necessitatibus veritatis qui maiores.
                                      name: Et doloribus est temporibus eos in.
                                next: Vel vel error harum.
                "503":
                    description: 'unavailable: Service Unavailable response.'
                    content:
                        application/json:
                            schema:
                                example:
                                    code: Magni totam excepturi.
                                    detail: Sint possimus blanditiis similique consequatur non.
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: Magni totam excepturi.
                                detail: Sint possimus blanditiis similique consequatur non.
            security: []
components:
    schemas:
        Item:
            type: object
            properties:
                id:
                    type: string
                    example: Autem officiis.
                name:
                    type: string
                    example: Enim neque hic aspernatur inventore est.
            example:
                id: Minima sit.
                name: Sed est id sunt sit.
            required:
                - id
        ItemCollection:
            type: array
            items:
                $ref: '#/components/schemas/Item'
            example:
                - id: Aspernatur aliquid delectus placeat.
                  name: Earum quia aut ratione a aut.
                - id: Aspernatur aliquid delectus placeat.
                  name: Earum quia aut ratione a aut.
                - id: Aspernatur aliquid delectus placeat.
                  name: Earum quia aut ratione a aut.
        Listing:
            type: object
            properties:
                first:
                    $ref: '#/components/schemas/Item'
                items:
                    $ref: '#/components/schemas/ItemCollection'
                next:
                    type: string
                    example: Velit nam velit non necessitatibus aut.
            example:
                first:
                    id: Ducimus deleniti est cupiditate odio.
                    name: Ipsa molestiae odio.
                items:
                    - id: Ducimus deleniti est cupiditate odio.
                      name: Ipsa molestiae odio.
                    - id: Ducimus deleniti est cupiditate odio.
                      name: Ipsa molestiae odio.
                    - id: Ducimus deleniti est cupiditate odio.
                      name: Ipsa molestiae odio.
                    - id: Ducimus deleniti est cupiditate odio.
                      name: Ipsa molestiae odio.
                next: Qui sed molestiae.
            required:
                - first
                - items
        Problem:
            type: object
            properties:
                code:
                    type: string
                    example: Ipsam alias temporibus iste.
                detail:
                    type: string
                    example: Sit voluptatem omnis et harum incidunt exercitationem.
            example:
                code: Non ab corrupti dignissimos.
                detail: Voluptas fuga illum eum ea labore.
            required:
                - code
tags:
    - name: ServiceExplicitBodyResultType
