openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /listings:
        get:
            tags:
                - ServiceExplicitBodyResultType
            summary: MethodImplicitBodyResultType ServiceExplicitBodyResultType
            operationId: service_explicit_body_result_type.method_implicit_body_result_type
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/Listing'
                            example:
                                first:
                                    id: Atque ut delectus nam ullam quia numquam.
                                    name: Dicta eum beatae tenetur eveniet aut illo.
                                items:
                                    - id: Atque ut delectus nam ullam quia numquam.
                                      name: Dicta eum beatae tenetur eveniet aut illo.
                                    - id: Atque ut delectus nam ullam quia numquam.
                                      name: Dicta eum beatae tenetur eveniet aut illo.
                                    - id: Atque ut delectus nam ullam quia numquam.
                                      name: Dicta eum beatae tenetur eveniet aut illo.
                                next: Qui qui id commodi qui.
            security: []
        post:
            tags:
                - ServiceExplicitBodyResultType
            summary: MethodExplicitBodyResultType ServiceExplicitBodyResultType
            operationId: service_explicit_body_result_type.method_explicit_body_result_type
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/Listing'
                            example:
                                first:
                                    id: Reiciendis laudantium reprehenderit ea cupiditate suscipit.
                                    name: Consequuntur quae sapiente odio.
                                items:
                                    - id: Reiciendis laudantium reprehenderit ea cupiditate suscipit.
                                      name: Consequuntur quae sapiente odio.
                                    - id: Reiciendis laudantium reprehenderit ea cupiditate suscipit.
                                      name: Consequuntur quae sapiente odio.
                                    - id: Reiciendis laudantium reprehenderit ea cupiditate suscipit.
                                      name: Consequuntur quae sapiente odio.
                                next: Perferendis sapiente.
                "503":
                    description: 'unavailable: Service Unavailable response.'
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: Dolores et.
                                detail: Tenetur eaque nihil voluptatem.
            security: []
components:
    schemas:
        Item:
            type: object
            properties:
                id:
                    type: string
                    example: Vero ex sed impedit at maiores et.
                name:
                    type: string
                    example: Ab laborum cumque dolorum.
            example:
                id: Voluptatem quidem et.
                name: Aut quasi quasi est voluptatibus possimus blanditiis.
            required:
                - id
        ItemCollection:
            type: array
            items:
                $ref: '#/components/schemas/Item'
            example:
                - id: Voluptatem eius nemo eveniet dolores tempora.
                  name: Eos laudantium.
                - id: Voluptatem eius nemo eveniet dolores tempora.
                  name: Eos laudantium.
                - id: Voluptatem eius nemo eveniet dolores tempora.
                  name: Eos laudantium.
                - id: Voluptatem eius nemo eveniet dolores tempora.
                  name: Eos laudantium.
        Listing:
            type: object
            properties:
                first:
                    $ref: '#/components/schemas/Item'
                items:
                    $ref: '#/components/schemas/ItemCollection'
                next:
                    type: string
                    example: Explicabo dolorum sed culpa voluptate distinctio.
            example:
                first:
                    id: Delectus facere veniam omnis itaque.
                    name: Consequatur voluptatum.
                items:
                    - id: Delectus facere veniam omnis itaque.
                      name: Consequatur voluptatum.
                    - id: Delectus facere veniam omnis itaque.
                      name: Consequatur voluptatum.
                    - id: Delectus facere veniam omnis itaque.
                      name: Consequatur voluptatum.
                next: Facere est perspiciatis.
            required:
                - first
                - items
        Problem:
            type: object
            properties:
                code:
                    type: string
                    example: Quia at.
                detail:
                    type: string
                    example: Quia alias illo aliquid.
            example:
                code: Numquam aut exercitationem.
                detail: Aut iste qui et molestiae.
            required:
                - code
tags:
    - name: ServiceExplicitBodyResultType
