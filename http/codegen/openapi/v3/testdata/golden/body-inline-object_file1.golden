openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /:
        post:
            tags:
                - ServiceBodyInlineObject
            summary: MethodBodyInlineObject ServiceBodyInlineObject
            operationId: service_body_inline_object.method_body_inline_object
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            properties:
                                a:
                                    type: string
                                    example: Ea placeat soluta non commodi ea consectetur.
                            example:
                                a: Aut enim sit.
                        example:
                            a: Enim illo laudantium.
            responses:
                "204":
                    description: No Content response.
components: {}
tags:
    - name: ServiceBodyInlineObject
