openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /First/do:
        post:
            tags:
                - First
            summary: do First
            operationId: first.do
            parameters:
                - name: q
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: string
                  example: Dolorem quasi iste.
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            properties:
                                name:
                                    type: string
                                    example: Placeat facere.
                            example:
                                name: Nobis optio sint necessitatibus.
                        example:
                            name: Non accusantium vitae incidunt.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
    /Second/do:
        post:
            tags:
                - Second
            summary: do Second
            operationId: second.do
            parameters:
                - name: q
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: string
                  example: Totam odit eligendi.
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            properties:
                                name:
                                    type: string
                                    example: Quia optio.
                            example:
                                name: Temporibus ipsa atque ut eum quod explicabo.
                        example:
                            name: Eaque tempore sequi hic natus.
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
components:
    responses:
        NoContentResponse:
            description: No Content response.
tags:
    - name: First
    - name: Second
