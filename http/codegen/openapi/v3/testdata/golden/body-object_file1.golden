openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /:
        post:
            tags:
                - ServiceBodyObject
            summary: MethodBodyObject ServiceBodyObject
            operationId: service_body_object.method_body_object
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            properties:
                                b:
                                    type: string
                                    example: Eius iure non.
                            example:
                                b: Mollitia molestiae voluptas qui.
                        example:
                            b: A accusamus praesentium suscipit est voluptas.
            responses:
                "204":
                    description: No Content response.
components: {}
tags:
    - name: ServiceBodyObject
