openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test
      url: http://localhost:80
paths:
    /ui/{filepath}:
        get:
            tags:
                - front
            summary: Download ui/dist
            operationId: front.ui_filepath
            parameters:
                - name: filepath
                  in: path
                  description: Relative file path
                  required: true
                  schema:
                    type: string
            responses:
                "200":
                    description: File downloaded
                "404":
                    description: File not found
components: {}
tags:
    - name: front
