openapi: 3.1.1
info:
    title: Contract Surfaces API
    description: Exercises problem documents, workflow links, and async streaming contracts.
    version: 0.0.1
jsonSchemaDialect: https://json-schema.org/draft/2020-12/schema
servers:
    - url: https://api.contract-surfaces.example.test
paths:
    /threads:
        post:
            tags:
                - threadOps
            summary: createThread threadOps
            operationId: thread_ops.create_thread
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            $ref: '#/components/schemas/CreateThreadRequestBody'
                        example:
                            title: Release freeze follow-up
            responses:
                "202":
                    $ref: '#/components/responses/OpenAPIThreadAcceptedStatus202Response'
                "404":
                    description: 'not_found: Not Found response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: true
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: true
                                timeout: true
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
                "409":
                    description: 'conflict: Conflict response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: false
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: false
                                timeout: true
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
                "429":
                    description: 'busy: Too Many Requests response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: false
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: false
                                timeout: true
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
            security: []
    /threads/{thread_id}:
        get:
            tags:
                - threadOps
            summary: getThread threadOps
            operationId: thread_ops.get_thread
            parameters:
                - $ref: '#/components/parameters/PathThreadID'
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                $ref: '#/components/schemas/OpenAPIThreadSummary'
                            example:
                                thread_id: thr_42
                                title: Release freeze follow-up
                "404":
                    description: 'not_found: Not Found response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: false
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: false
                                timeout: true
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
                "409":
                    description: 'conflict: Conflict response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: true
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: true
                                timeout: false
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
                "429":
                    description: 'busy: Too Many Requests response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: true
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: true
                                timeout: true
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
            security: []
    /threads/{thread_id}/archive:
        post:
            tags:
                - threadOps
            summary: archiveThread threadOps
            operationId: thread_ops.archive_thread
            parameters:
                - $ref: '#/components/parameters/PathThreadID'
            responses:
                "204":
                    description: No Content response.
                "404":
                    description: 'not_found: Not Found response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: false
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: true
                                timeout: false
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
                "409":
                    description: 'conflict: Conflict response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: false
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: false
                                timeout: false
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
                "429":
                    description: 'busy: Too Many Requests response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: false
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: true
                                timeout: false
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
            security: []
    /threads/{thread_id}/events:
        get:
            operationId: thread_ops.watch_thread
            parameters:
                - $ref: '#/components/parameters/PathThreadID'
                - allowEmptyValue: true
                  example: evt_7
                  in: query
                  name: last_event_id
                  schema:
                    example: evt_7
                    type: string
            responses:
                "200":
                    content:
                        text/event-stream:
                            schema:
                                $ref: '#/components/schemas/OpenAPIThreadEvent'
                    description: OK response.
                "404":
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                    description: 'not_found: Not Found response.'
                "409":
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                    description: 'conflict: Conflict response.'
                "429":
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                    description: 'busy: Too Many Requests response.'
            security: []
            summary: watchThread threadOps
            tags:
                - threadOps
            x-loom-async:
                direction: server
                handshake:
                    path: /threads/{thread_id}/events
                    request:
                        method: GET
                    response:
                        contentType: text/event-stream
                        status: 200
                messages:
                    outbound:
                        contentType: application/json
                        schema:
                            type: object
                            properties:
                                data:
                                    type: object
                                    properties:
                                        author:
                                            type: string
                                            example: alice
                                        preview:
                                            type: string
                                            example: Shipping the OpenAPI cleanup next.
                                    example:
                                        author: alice
                                        preview: Shipping the OpenAPI cleanup next.
                                    required:
                                        - author
                                        - preview
                                    additionalProperties: false
                                event:
                                    type: string
                                    example: thread.message_posted
                                id:
                                    type: string
                                    example: evt_8
                            example:
                                data:
                                    author: alice
                                    preview: Shipping the OpenAPI cleanup next.
                                event: thread.message_posted
                                id: evt_8
                            required:
                                - id
                                - event
                                - data
                            additionalProperties: false
                        sse:
                            dataField: null
                            eventField: null
                            idField: id
                            requestIDField: last_event_id
                            retryField: null
                transport: sse
    /threads/{thread_id}/reopen:
        post:
            tags:
                - threadOps
            summary: reopenThread threadOps
            operationId: thread_ops.reopen_thread
            parameters:
                - $ref: '#/components/parameters/PathThreadID'
            responses:
                "202":
                    $ref: '#/components/responses/OpenAPIThreadAcceptedStatus202Response'
                "404":
                    description: 'not_found: Not Found response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: true
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: true
                                timeout: false
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
                "409":
                    description: 'conflict: Conflict response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: false
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: true
                                timeout: false
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
                "429":
                    description: 'busy: Too Many Requests response.'
                    content:
                        application/problem+json:
                            schema:
                                $ref: '#/components/schemas/Problem'
                            example:
                                code: bad_request
                                detail: parameter 'p' must be an integer
                                fault: false
                                instance: urn:loom:error:123abc
                                status: 400
                                temporary: true
                                timeout: true
                                title: Bad Request
                                type: https://github.com/CaliLuke/loom/problems/bad-request
            security: []
    /ws/ops/{channel}:
        get:
            operationId: ops_socket.stream_commands
            parameters:
                - example: deployments
                  in: path
                  name: channel
                  required: true
                  schema:
                    example: deployments
                    type: string
            responses:
                "101":
                    description: Switching Protocols response.
            security: []
            summary: streamCommands opsSocket
            tags:
                - opsSocket
            x-loom-async:
                direction: bidirectional
                handshake:
                    path: /ws/ops/{channel}
                    request:
                        method: GET
                    response:
                        contentType: ""
                        status: 101
                messages:
                    inbound:
                        contentType: application/json
                        schema:
                            type: object
                            properties:
                                op:
                                    type: string
                                    example: pause
                                target:
                                    type: string
                                    example: worker-eu-1
                            example:
                                op: pause
                                target: worker-eu-1
                            required:
                                - op
                                - target
                            additionalProperties: false
                    outbound:
                        contentType: application/json
                        schema:
                            type: object
                            properties:
                                event:
                                    type: string
                                    example: command.accepted
                                ok:
                                    type: boolean
                                    example: true
                            example:
                                event: command.accepted
                                ok: true
                            required:
                                - event
                                - ok
                            additionalProperties: false
                transport: websocket
components:
    schemas:
        CreateThreadRequestBody:
            type: object
            properties:
                title:
                    type: string
                    example: Release freeze follow-up
            example:
                title: Release freeze follow-up
            required:
                - title
            additionalProperties: false
        OpenAPIThreadAccepted:
            type: object
            properties:
                thread_id:
                    type: string
                    example: thr_42
                    pattern: ^thr_[0-9]+$
                watch_url:
                    type: string
                    example: https://api.contract-surfaces.example.test/threads/thr_42/events
            example:
                thread_id: thr_42
                watch_url: https://api.contract-surfaces.example.test/threads/thr_42/events
            required:
                - thread_id
                - watch_url
            additionalProperties: false
        OpenAPIThreadEvent:
            type: object
            properties:
                data:
                    type: object
                    properties:
                        author:
                            type: string
                            example: alice
                        preview:
                            type: string
                            example: Shipping the OpenAPI cleanup next.
                    example:
                        author: alice
                        preview: Shipping the OpenAPI cleanup next.
                    required:
                        - author
                        - preview
                    additionalProperties: false
                event:
                    type: string
                    example: thread.message_posted
                id:
                    type: string
                    example: evt_8
            example:
                data:
                    author: alice
                    preview: Shipping the OpenAPI cleanup next.
                event: thread.message_posted
                id: evt_8
            required:
                - id
                - event
                - data
            additionalProperties: false
        OpenAPIThreadSummary:
            type: object
            properties:
                thread_id:
                    type: string
                    example: thr_42
                    pattern: ^thr_[0-9]+$
                title:
                    type: string
                    example: Release freeze follow-up
            example:
                thread_id: thr_42
                title: Release freeze follow-up
            required:
                - thread_id
                - title
            additionalProperties: false
        Problem:
            type: object
            properties:
                code:
                    type: string
                    description: Code is the stable machine-readable problem code.
                    example: bad_request
                detail:
                    type: string
                    description: Detail is a human-readable explanation specific to this occurrence of the problem.
                    example: parameter 'p' must be an integer
                fault:
                    type: boolean
                    description: Fault indicates whether the problem represents a server-side fault.
                    example: true
                instance:
                    type: string
                    description: Instance identifies this specific occurrence of the problem.
                    example: urn:loom:error:123abc
                status:
                    type: integer
                    description: Status is the HTTP status code generated for this occurrence of the problem.
                    example: 400
                    format: int64
                temporary:
                    type: boolean
                    description: Temporary indicates whether retrying later may succeed.
                    example: false
                timeout:
                    type: boolean
                    description: Timeout indicates whether the problem was caused by a timeout.
                    example: true
                title:
                    type: string
                    description: Title is a short, human-readable summary of the problem type.
                    example: Bad Request
                type:
                    type: string
                    description: Type identifies the problem category using a URI reference.
                    example: https://github.com/CaliLuke/loom/problems/bad-request
            example:
                code: bad_request
                detail: parameter 'p' must be an integer
                fault: true
                instance: urn:loom:error:123abc
                status: 400
                temporary: false
                timeout: false
                title: Bad Request
                type: https://github.com/CaliLuke/loom/problems/bad-request
            required:
                - code
                - title
                - detail
            additionalProperties: false
    parameters:
        PathThreadID:
            name: thread_id
            in: path
            required: true
            schema:
                type: string
                example: thr_42
            example: thr_42
    responses:
        OpenAPIThreadAcceptedStatus202Response:
            description: Accepted response.
            content:
                application/json:
                    schema:
                        $ref: '#/components/schemas/OpenAPIThreadAccepted'
                    example:
                        thread_id: thr_42
                        watch_url: https://api.contract-surfaces.example.test/threads/thr_42/events
            links:
                thread:
                    operationId: thread_ops.get_thread
                    parameters:
                        thread_id: $response.body#/thread_id
                watch:
                    operationId: thread_ops.watch_thread
                    parameters:
                        thread_id: $response.body#/thread_id
tags:
    - name: threadOps
      description: Thread creation and retrieval operations.
    - name: opsSocket
      description: Bidirectional operator control channel.
