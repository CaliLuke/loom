openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /byte-choice:
        post:
            tags:
                - mappednames
            summary: byte_choice mappednames
            operationId: mappednames.byte_choice
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            example:
                                d: aGk=
                            oneOf:
                                - example:
                                    d: aGk=
                                  $ref: '#/components/schemas/ByteData'
                                - example:
                                    d: hi
                                  $ref: '#/components/schemas/TextData'
                        example:
                            d: aGk=
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    d: aGk=
                                oneOf:
                                    - example:
                                        d: aGk=
                                      $ref: '#/components/schemas/ByteData'
                                    - example:
                                        d: hi
                                      $ref: '#/components/schemas/TextData'
                            example:
                                d: aGk=
            security: []
    /echo:
        post:
            tags:
                - mappednames
            summary: echo mappednames
            operationId: mappednames.echo
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            example:
                                ch:
                                    type: leaf_branch
                                    value:
                                        c: 3268184896897639265
                                        l: Nam quasi nihil.
                                d: 7544727127236496534
                                ix:
                                    Inventore odio laudantium autem.:
                                        c: 3268184896897639265
                                        l: Nam quasi nihil.
                                    Minus et esse voluptate sit.:
                                        c: 3268184896897639265
                                        l: Nam quasi nihil.
                                    Possimus quos minus.:
                                        c: 3268184896897639265
                                        l: Nam quasi nihil.
                                ls:
                                    - Unde dolorem aspernatur.
                                    - Soluta autem sequi facere iusto.
                                    - Sint alias qui.
                                m: 7sy
                                o:
                                    c: 3268184896897639265
                                    l: Nam quasi nihil.
                                p:
                                    type: String
                                    value: Harum ab saepe et saepe sed.
                                r: 2607863942139009485
                            $ref: '#/components/schemas/Envelope'
                        example:
                            ch:
                                type: leaf_branch
                                value:
                                    c: 3268184896897639265
                                    l: Nam quasi nihil.
                            d: 7544727127236496534
                            ix:
                                Inventore odio laudantium autem.:
                                    c: 3268184896897639265
                                    l: Nam quasi nihil.
                                Minus et esse voluptate sit.:
                                    c: 3268184896897639265
                                    l: Nam quasi nihil.
                                Possimus quos minus.:
                                    c: 3268184896897639265
                                    l: Nam quasi nihil.
                            ls:
                                - Unde dolorem aspernatur.
                                - Soluta autem sequi facere iusto.
                                - Sint alias qui.
                            m: 7sy
                            o:
                                c: 3268184896897639265
                                l: Nam quasi nihil.
                            p:
                                type: String
                                value: Harum ab saepe et saepe sed.
                            r: 2607863942139009485
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    ch:
                                        type: text
                                        value: Repudiandae ea quia.
                                    d: 7779735663774811768
                                    ix:
                                        Amet voluptatem hic et.:
                                            c: 8840776809038125838
                                            l: Voluptatem et minima.
                                        Eum aliquid velit distinctio sed.:
                                            c: 8840776809038125838
                                            l: Voluptatem et minima.
                                        In corporis cumque ducimus animi eligendi aliquid.:
                                            c: 8840776809038125838
                                            l: Voluptatem et minima.
                                    ls:
                                        - Quo fugit error voluptas doloribus sequi.
                                        - Saepe et quam reprehenderit ab tempora maxime.
                                        - Enim aperiam et consequatur sit minus.
                                        - Eum tenetur et esse quibusdam omnis officiis.
                                    m: sg
                                    o:
                                        c: 8840776809038125838
                                        l: Voluptatem et minima.
                                    p:
                                        type: Int
                                        value: 1510894860536017787
                                    r: 4572087572523051047
                                $ref: '#/components/schemas/Envelope'
                            example:
                                ch:
                                    type: text
                                    value: Repudiandae ea quia.
                                d: 7779735663774811768
                                ix:
                                    Amet voluptatem hic et.:
                                        c: 8840776809038125838
                                        l: Voluptatem et minima.
                                    Eum aliquid velit distinctio sed.:
                                        c: 8840776809038125838
                                        l: Voluptatem et minima.
                                    In corporis cumque ducimus animi eligendi aliquid.:
                                        c: 8840776809038125838
                                        l: Voluptatem et minima.
                                ls:
                                    - Quo fugit error voluptas doloribus sequi.
                                    - Saepe et quam reprehenderit ab tempora maxime.
                                    - Enim aperiam et consequatur sit minus.
                                    - Eum tenetur et esse quibusdam omnis officiis.
                                m: sg
                                o:
                                    c: 8840776809038125838
                                    l: Voluptatem et minima.
                                p:
                                    type: Int
                                    value: 1510894860536017787
                                r: 4572087572523051047
            security: []
    /inline:
        put:
            tags:
                - mappednames
            summary: inline mappednames
            operationId: mappednames.inline
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            example:
                                c: 5894832277164597307
                                i: Repudiandae labore a natus a accusantium similique.
                            $ref: '#/components/schemas/InlineRequestBody'
                        example:
                            c: 5894832277164597307
                            i: Repudiandae labore a natus a accusantium similique.
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    c: 1108211225206235084
                                    i: Deserunt omnis nihil ab assumenda quia.
                                $ref: '#/components/schemas/InlineRequestBody'
                            example:
                                c: 1108211225206235084
                                i: Deserunt omnis nihil ab assumenda quia.
            security: []
    /lookup:
        post:
            tags:
                - mappednames
            summary: lookup mappednames
            operationId: mappednames.lookup
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            example:
                                b: aGk=
                                dt: payload
                            oneOf:
                                - example:
                                    b: aGk=
                                    dt: Vitae ab dolores impedit sunt.
                                    sz: 6657445997127423615
                                  $ref: '#/components/schemas/DataResult'
                                - example:
                                    rs: Quos hic culpa.
                                  $ref: '#/components/schemas/FailResult'
                        example:
                            b: aGk=
                            dt: payload
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    b: aGk=
                                    dt: payload
                                oneOf:
                                    - example:
                                        b: aGk=
                                        dt: Incidunt suscipit veritatis quidem.
                                        sz: 6686433394992015710
                                      $ref: '#/components/schemas/DataResult'
                                    - example:
                                        rs: Molestiae optio.
                                      $ref: '#/components/schemas/FailResult'
                            example:
                                b: aGk=
                                dt: payload
            security: []
components:
    schemas:
        ByteData:
            type: object
            properties:
                d:
                    type: string
                    example: aGk=
                    contentEncoding: base64
                    enum:
                        - aGk=
                    not:
                        pattern: '[^A-Za-z0-9+/=]'
                    anyOf:
                        - pattern: ^([A-Za-z0-9+/]{4})*$
                          minLength: 0
                        - pattern: ^([A-Za-z0-9+/]{4})*[A-Za-z0-9+/]{2}==$
                          minLength: 4
                        - pattern: ^([A-Za-z0-9+/]{4})*[A-Za-z0-9+/]{3}=$
                          minLength: 4
            example:
                d: aGk=
            required:
                - d
        ChoiceLeafBranchEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - leaf_branch
                value:
                    $ref: '#/components/schemas/Leaf'
            description: Synthetic wrapper for union variant "leaf_branch".
            required:
                - type
                - value
        ChoiceTextEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - text
                value:
                    type: string
                    example: Minus beatae.
            description: Synthetic wrapper for union variant "text".
            required:
                - type
                - value
        DataResult:
            type: object
            properties:
                b:
                    type: string
                    example: aGk=
                    contentEncoding: base64
                    enum:
                        - aGk=
                    not:
                        pattern: '[^A-Za-z0-9+/=]'
                    anyOf:
                        - pattern: ^([A-Za-z0-9+/]{4})*$
                          minLength: 0
                        - pattern: ^([A-Za-z0-9+/]{4})*[A-Za-z0-9+/]{2}==$
                          minLength: 4
                        - pattern: ^([A-Za-z0-9+/]{4})*[A-Za-z0-9+/]{3}=$
                          minLength: 4
                dt:
                    type: string
                    example: Qui hic enim voluptas tenetur rem.
                sz:
                    type: integer
                    example: 3942593966183568020
                    format: int64
            example:
                b: aGk=
                dt: Eos voluptates deserunt omnis.
                sz: 3851609522558660737
            required:
                - dt
        Envelope:
            type: object
            properties:
                ch:
                    type: object
                    example:
                        type: text
                        value: Similique perferendis sequi.
                    oneOf:
                        - $ref: '#/components/schemas/ChoiceLeafBranchEnvelope'
                        - $ref: '#/components/schemas/ChoiceTextEnvelope'
                    discriminator:
                        propertyName: type
                        mapping:
                            leaf_branch: '#/components/schemas/ChoiceLeafBranchEnvelope'
                            text: '#/components/schemas/ChoiceTextEnvelope'
                d:
                    type: integer
                    default: 3
                    example: 6967402427047375804
                    format: int64
                ix:
                    type: object
                    example:
                        Excepturi voluptatum modi.:
                            c: 1742484224522507071
                            l: Sapiente soluta consequuntur quis tempora amet.
                    additionalProperties:
                        $ref: '#/components/schemas/Leaf'
                ls:
                    type: array
                    items:
                        type: string
                        example: Vitae praesentium cum perferendis commodi omnis.
                    example:
                        - Quo esse explicabo.
                        - Aspernatur aliquam.
                        - Quae repellat nesciunt amet ut ad.
                m:
                    type: string
                    example: oa
                    minLength: 2
                o:
                    $ref: '#/components/schemas/Leaf'
                p:
                    type: object
                    example:
                        type: String
                        value: Ducimus esse ut eum eveniet commodi perspiciatis.
                    oneOf:
                        - $ref: '#/components/schemas/IntOrStringIntEnvelope'
                        - $ref: '#/components/schemas/IntOrStringStringEnvelope'
                    discriminator:
                        propertyName: type
                        mapping:
                            Int: '#/components/schemas/IntOrStringIntEnvelope'
                            String: '#/components/schemas/IntOrStringStringEnvelope'
                r:
                    type: integer
                    example: 7730541778797190074
                    format: int64
            example:
                ch:
                    type: leaf_branch
                    value:
                        c: 6295762694528571497
                        l: Culpa nobis sunt.
                d: 2977120627422250525
                ix:
                    Delectus optio velit.:
                        c: 6295762694528571497
                        l: Culpa nobis sunt.
                    Est distinctio tenetur minus.:
                        c: 6295762694528571497
                        l: Culpa nobis sunt.
                    Soluta mollitia illo autem.:
                        c: 6295762694528571497
                        l: Culpa nobis sunt.
                ls:
                    - Facilis illum.
                    - Cumque quisquam et voluptatum tenetur occaecati natus.
                m: jg
                o:
                    c: 6295762694528571497
                    l: Culpa nobis sunt.
                p:
                    type: Int
                    value: 5250452256650380191
                r: 5834335217562232202
            required:
                - r
                - p
                - o
        FailResult:
            type: object
            properties:
                rs:
                    type: string
                    example: Quidem aspernatur labore inventore qui voluptates.
            example:
                rs: Velit quia porro rerum voluptas.
            required:
                - rs
        InlineRequestBody:
            type: object
            properties:
                c:
                    type: integer
                    example: 7886909154794992703
                    format: int64
                i:
                    type: string
                    example: Non sunt suscipit.
            example:
                c: 4502184350639594714
                i: Fugiat ut.
            required:
                - i
        IntOrStringIntEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - Int
                value:
                    type: integer
                    example: 3328990120462274075
                    format: int64
            description: Synthetic wrapper for union variant "Int".
            required:
                - type
                - value
        IntOrStringStringEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - String
                value:
                    type: string
                    example: Et porro.
            description: Synthetic wrapper for union variant "String".
            required:
                - type
                - value
        Leaf:
            type: object
            properties:
                c:
                    type: integer
                    example: 341894622543015875
                    format: int64
                l:
                    type: string
                    example: Saepe sunt exercitationem.
            example:
                c: 8691275048851914653
                l: Sed non dignissimos enim.
            required:
                - c
        TextData:
            type: object
            properties:
                d:
                    type: string
                    example: hi
                    enum:
                        - hi
            example:
                d: hi
            required:
                - d
tags:
    - name: mappednames
