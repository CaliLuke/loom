                            example:
                                b: aGk=
                                dt: payload
            security: []
components:
    schemas:
        ByteData:
            type: object
            properties:
                d:
                    type: string
                    example: aGk=
                    contentEncoding: base64
                    enum:
                        - aGk=
                    not:
                        pattern: '[^A-Za-z0-9+/=]'
                    anyOf:
                        - pattern: ^([A-Za-z0-9+/]{4})*$
                          minLength: 0
                        - pattern: ^([A-Za-z0-9+/]{4})*[A-Za-z0-9+/]{2}==$
                          minLength: 4
                        - pattern: ^([A-Za-z0-9+/]{4})*[A-Za-z0-9+/]{3}=$
                          minLength: 4
            example:
                d: aGk=
            required:
                - d
        ChoiceLeafBranchEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - leaf_branch
                value:
                    $ref: '#/components/schemas/Leaf'
            description: Synthetic wrapper for union variant "leaf_branch".
            required:
                - type
                - value
        ChoiceTextEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - text
                value:
                    type: string
                    example: Minus beatae.
            description: Synthetic wrapper for union variant "text".
            required:
                - type
                - value
        DataResult:
            type: object
            properties:
                b:
                    type: string
                    example: aGk=
                    contentEncoding: base64
                    enum:
                        - aGk=
                    not:
                        pattern: '[^A-Za-z0-9+/=]'
                    anyOf:
                        - pattern: ^([A-Za-z0-9+/]{4})*$
                          minLength: 0
                        - pattern: ^([A-Za-z0-9+/]{4})*[A-Za-z0-9+/]{2}==$
                          minLength: 4
                        - pattern: ^([A-Za-z0-9+/]{4})*[A-Za-z0-9+/]{3}=$
                          minLength: 4
                dt:
                    type: string
                    example: Qui hic enim voluptas tenetur rem.
                sz:
                    type: integer
                    example: 3942593966183568020
                    format: int64
            example:
                b: aGk=
                dt: Eos voluptates deserunt omnis.
                sz: 3851609522558660737
            required:
                - dt
        Envelope:
            type: object
            properties:
                ch:
                    type: object
                    example:
                        type: text
                        value: Omnis dignissimos nulla iusto.
                    oneOf:
                        - $ref: '#/components/schemas/ChoiceLeafBranchEnvelope'
                        - $ref: '#/components/schemas/ChoiceTextEnvelope'
                    discriminator:
                        propertyName: type
                        mapping:
                            leaf_branch: '#/components/schemas/ChoiceLeafBranchEnvelope'
                            text: '#/components/schemas/ChoiceTextEnvelope'
                d:
                    type: integer
                    default: 3
                    example: 5944817827154964147
                    format: int64
                ix:
                    type: object
                    example:
                        Et eius animi saepe sed adipisci neque.:
                            c: 2838486742568929676
                            l: Reiciendis sint aut et neque aperiam dolores.
                        Nulla est.:
                            c: 2838486742568929676
                            l: Reiciendis sint aut et neque aperiam dolores.
                        Quas accusantium accusantium velit laboriosam ea pariatur.:
                            c: 2838486742568929676
                            l: Reiciendis sint aut et neque aperiam dolores.
                    additionalProperties:
                        $ref: '#/components/schemas/Leaf'
                ls:
                    type: array
                    items:
                        type: string
                        example: Voluptatem itaque.
                    example:
                        - Eum minus.
                        - Et officiis.
                m:
                    type: string
                    example: di
                    minLength: 2
                o:
                    $ref: '#/components/schemas/Leaf'
                p:
                    type: object
                    example:
                        type: Int
                        value: 4990356674750892081
                    oneOf:
                        - $ref: '#/components/schemas/IntOrStringIntEnvelope'
                        - $ref: '#/components/schemas/IntOrStringStringEnvelope'
                    discriminator:
                        propertyName: type
                        mapping:
                            Int: '#/components/schemas/IntOrStringIntEnvelope'
                            String: '#/components/schemas/IntOrStringStringEnvelope'
                r:
                    type: integer
                    example: 2909347950194411150
                    format: int64
            example:
                ch:
                    type: leaf_branch
                    value:
                        c: 2185127696269261974
                        l: Voluptatem tempora voluptatem est nemo doloribus.
                d: 3531106220653876679
                ix:
                    Temporibus aut in tempore iure sunt quod.:
                        c: 2185127696269261974
                        l: Voluptatem tempora voluptatem est nemo doloribus.
                    Velit temporibus et magni dolores aut.:
                        c: 2185127696269261974
                        l: Voluptatem tempora voluptatem est nemo doloribus.
                ls:
                    - Provident facere quis voluptas et voluptatum repellendus.
                    - Nihil sunt voluptas.
                    - Quia veniam officia quia.
                    - Culpa nulla voluptas culpa exercitationem aut rerum.
                m: xj5
                o:
                    c: 2185127696269261974
                    l: Voluptatem tempora voluptatem est nemo doloribus.
                p:
                    type: String
                    value: Cum in sit blanditiis saepe.
                r: 3489298692158739364
            required:
                - r
                - p
                - o
        Envelope_d75d1da451d4be00:
            type: object
            properties:
                ch:
                    type: object
                    example:
                        type: leaf_branch
                        value:
                            c: 8177873505143758871
                            l: Consectetur sunt quod.
                    oneOf:
                        - $ref: '#/components/schemas/ChoiceLeafBranchEnvelope'
                        - $ref: '#/components/schemas/ChoiceTextEnvelope'
                    discriminator:
                        propertyName: type
                        mapping:
                            leaf_branch: '#/components/schemas/ChoiceLeafBranchEnvelope'
                            text: '#/components/schemas/ChoiceTextEnvelope'
                d:
                    type: integer
                    default: 3
                    example: 1673322225767508906
                    format: int64
                ix:
                    type: object
                    example:
                        Doloremque et sint iusto.:
                            c: 7584179485882958303
                            l: Reprehenderit vel minima ab voluptas.
                        Voluptas sit doloribus.:
                            c: 7584179485882958303
                            l: Reprehenderit vel minima ab voluptas.
                    additionalProperties:
                        $ref: '#/components/schemas/Leaf'
                ls:
                    type: array
                    items:
                        type: string
                        example: Ipsa blanditiis nemo molestiae.
                    example:
                        - Ab vel omnis incidunt enim aut.
                        - Labore autem.
                m:
                    type: string
                    example: r77
                    minLength: 2
                o:
                    $ref: '#/components/schemas/Leaf'
                p:
                    type: object
                    example:
                        type: String
                        value: Corrupti enim dolorum ut deserunt.
                    oneOf:
                        - $ref: '#/components/schemas/IntOrStringIntEnvelope'
                        - $ref: '#/components/schemas/IntOrStringStringEnvelope'
                    discriminator:
                        propertyName: type
                        mapping:
                            Int: '#/components/schemas/IntOrStringIntEnvelope'
                            String: '#/components/schemas/IntOrStringStringEnvelope'
                r:
                    type: integer
                    example: 7766957342749654606
                    format: int64
            example:
                ch:
                    type: text
                    value: Ipsum aut aut incidunt et.
                d: 2800179313072651603
                ix:
                    Dolorum alias quia totam qui sed.:
                        c: 6748548767573560296
                        l: Dicta eveniet.
                ls:
                    - Qui quisquam.
                    - Voluptatibus vel.
                m: 6m
                o:
                    c: 6748548767573560296
                    l: Dicta eveniet.
                p:
                    type: String
                    value: Perspiciatis tempore fugiat sit corrupti autem.
                r: 1824696424600187008
            required:
                - r
                - p
                - o
        FailResult:
            type: object
            properties:
                rs:
                    type: string
                    example: Quidem aspernatur labore inventore qui voluptates.
            example:
                rs: Velit quia porro rerum voluptas.
            required:
                - rs
        InlineRequestBody:
            type: object
            properties:
                c:
                    type: integer
                    example: 7886909154794992703
                    format: int64
                i:
                    type: string
                    example: Non sunt suscipit.
            example:
                c: 4502184350639594714
                i: Fugiat ut.
            required:
                - i
        InlineRequestBody_2476bc0dc6e54e7f:
            type: object
            properties:
                c:
                    type: integer
                    example: 6901687998946747546
                    format: int64
                i:
                    type: string
                    example: Dolore et aspernatur.
            example:
                c: 4940225402057387877
                i: Quia ad quo quasi illo.
            required:
                - i
        IntOrStringIntEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - Int
                value:
                    type: integer
                    example: 3328990120462274075
                    format: int64
            description: Synthetic wrapper for union variant "Int".
            required:
                - type
                - value
        IntOrStringStringEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - String
                value:
                    type: string
                    example: Et porro.
            description: Synthetic wrapper for union variant "String".
            required:
                - type
                - value
        Leaf:
            type: object
            properties:
                c:
                    type: integer
                    example: 341894622543015875
                    format: int64
                l:
                    type: string
                    example: Saepe sunt exercitationem.
            example:
                c: 8691275048851914653
                l: Sed non dignissimos enim.
            required:
                - c
        TextData:
            type: object
            properties:
                d:
                    type: string
                    example: hi
                    enum:
                        - hi
            example:
                d: hi
            required:
                - d
tags:
    - name: mappednames
