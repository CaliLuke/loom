openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /byte-choice:
        post:
            tags:
                - mappednames
            summary: byte_choice mappednames
            operationId: mappednames.byte_choice
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            example:
                                d: aGk=
                            oneOf:
                                - example:
                                    d: aGk=
                                  $ref: '#/components/schemas/ByteData'
                                - example:
                                    d: hi
                                  $ref: '#/components/schemas/TextData'
                        example:
                            d: aGk=
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    d: aGk=
                                oneOf:
                                    - example:
                                        d: aGk=
                                      $ref: '#/components/schemas/ByteData'
                                    - example:
                                        d: hi
                                      $ref: '#/components/schemas/TextData'
                            example:
                                d: aGk=
            security: []
    /echo:
        post:
