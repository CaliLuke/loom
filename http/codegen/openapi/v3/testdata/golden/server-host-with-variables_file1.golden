openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test
      url: https://{version}.loom.design
      variables:
        version:
            default: v1
paths:
    /:
        post:
            tags:
                - testService
            summary: testEndpoint testService
            operationId: test_service.test_endpoint
            responses:
                "204":
                    description: No Content response.
components: {}
tags:
    - name: testService
