          "mealPlanner"
        ]
      }
    },
    "/recipes/{recipe_id}": {
      "get": {
        "operationId": "meal_planner.show_recipe",
        "parameters": [
          {
            "example": "recipe_42",
            "in": "path",
            "name": "recipe_id",
            "required": true,
            "schema": {
              "pattern": "^recipe_[0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "difficulty": "easy",
                  "id": "recipe_42",
                  "ingredients": [
                    "gnocchi",
                    "tomatoes",
                    "spinach"
                  ],
                  "minutes": 30,
                  "tags": [
                    "weeknight",
                    "vegetarian"
                  ],
                  "title": "Sheet Pan Gnocchi"
                },
                "schema": {
                  "$ref": "#/components/schemas/MealplannerRecipe"
                }
              }
            },
            "description": "OK response."
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "403": {
            "$ref": "#/components/responses/ForbiddenError"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "not_found: Not Found response."
          }
        },
        "security": [
          {
            "access_token": []
          },
          {
            "browser_session": []
          }
        ],
        "summary": "showRecipe mealPlanner",
        "tags": [
          "mealPlanner"
        ]
      }
    }
