    "/recipes": {
      "get": {
        "operationId": "meal_planner.list_recipes",
        "parameters": [
          {
            "allowEmptyValue": true,
            "example": "vegetarian",
            "in": "query",
            "name": "tag",
            "schema": {
              "type": "string"
            }
          },
          {
            "allowEmptyValue": true,
            "example": "cursor_2",
            "in": "query",
            "name": "cursor",
            "schema": {
              "type": "string"
            }
          },
          {
            "allowEmptyValue": true,
            "example": 20,
            "in": "query",
            "name": "limit",
            "schema": {
              "format": "int64",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": [
                  {
                    "difficulty": "easy",
                    "id": "recipe_42",
                    "minutes": 30,
                    "title": "Sheet Pan Gnocchi"
                  },
                  {
                    "difficulty": "easy",
                    "id": "recipe_42",
                    "minutes": 30,
                    "title": "Sheet Pan Gnocchi"
                  },
                  {
                    "difficulty": "easy",
                    "id": "recipe_42",
                    "minutes": 30,
                    "title": "Sheet Pan Gnocchi"
                  }
                ],
                "schema": {
                  "$ref": "#/components/schemas/RecipeResponseSummaryCollection"
                }
              }
            },
            "description": "OK response."
