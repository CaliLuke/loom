    "/recipes/{recipe_id}": {
      "get": {
        "operationId": "meal_planner.show_recipe",
        "parameters": [
          {
            "example": "recipe_42",
            "in": "path",
            "name": "recipe_id",
            "required": true,
            "schema": {
              "example": "recipe_42",
              "pattern": "^recipe_[0-9]+$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "difficulty": "easy",
                  "id": "recipe_42",
                  "ingredients": [
                    "gnocchi",
                    "tomatoes",
                    "spinach"
                  ],
                  "minutes": 30,
                  "tags": [
                    "weeknight",
                    "vegetarian"
                  ],
                  "title": "Sheet Pan Gnocchi"
                },
                "schema": {
                  "$ref": "#/components/schemas/MealplannerRecipe"
