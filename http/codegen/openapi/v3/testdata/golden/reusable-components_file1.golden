openapi: 3.1.1
info:
    title: Goa API
    version: 0.0.1
jsonSchemaDialect: https://json-schema.org/draft/2020-12/schema
servers:
    - url: http://localhost:80
      description: Default server for test api
paths:
    /auth/refresh:
        post:
            tags:
                - Auth
            summary: refresh auth
            operationId: auth.refresh
            requestBody:
                $ref: '#/components/requestBodies/AuthRefreshRequestBody'
            responses:
                "200":
                    $ref: '#/components/responses/AuthRefreshStatus200Response'
    /auth/revoke:
        post:
            tags:
                - Auth
            summary: revoke auth
            operationId: auth.revoke
            responses:
                "204":
                    $ref: '#/components/responses/AuthRevokeStatus204Response'
    /auth/signin:
        post:
            tags:
                - Auth
            summary: signin auth
            operationId: auth.signin
            requestBody:
                $ref: '#/components/requestBodies/AuthRefreshRequestBody'
            responses:
                "200":
                    $ref: '#/components/responses/AuthRefreshStatus200Response'
    /auth/signout:
        post:
            tags:
                - Auth
            summary: signout auth
            operationId: auth.signout
            responses:
                "204":
                    $ref: '#/components/responses/AuthRevokeStatus204Response'
components:
    schemas:
        Credentials:
            type: object
            properties:
                legacyToken:
                    type: string
                    example: legacy-token
                    deprecated: true
                password:
                    type: string
                    example: hunter2
                    writeOnly: true
                profile:
                    type: string
                    example: eyJyb2xlIjoiYWRtaW4ifQ==
                    contentEncoding: base64
                    contentMediaType: application/json
                username:
                    type: string
                    example: alice
            example:
                legacyToken: legacy-token-2
                password: swordfish
                profile: eyJyb2xlIjoiZWRpdG9yIn0=
                username: bob
            required:
                - username
                - password
        Session_d5d120e942d17641_2:
            type: object
            properties:
                expiresAt:
                    type: string
                    example: "2026-03-20T12:00:00Z"
                    format: date-time
                token:
                    type: string
                    example: token-123
                    readOnly: true
            example:
                expiresAt: "2026-03-21T12:00:00Z"
                token: token-456
                traceID: trace_456
            required:
                - token
                - expiresAt
    headers:
        XTraceIDHeader:
            schema:
                type: string
                example: trace_456
            examples:
                trace-a:
                    $ref: '#/components/examples/XTraceIDHeaderTraceAExample'
                trace-b:
                    $ref: '#/components/examples/XTraceIDHeaderTraceBExample'
    requestBodies:
        AuthRefreshRequestBody:
            required: true
            content:
                application/json:
                    schema:
                        $ref: '#/components/schemas/Credentials'
                    examples:
                        backup:
                            $ref: '#/components/examples/AuthRefreshRequestBodyBackupExample'
                        primary:
                            $ref: '#/components/examples/AuthRefreshRequestBodyPrimaryExample'
    responses:
        AuthRefreshStatus200Response:
            description: OK response.
            headers:
                X-Trace-ID:
                    $ref: '#/components/headers/XTraceIDHeader'
            content:
                application/json:
                    schema:
                        $ref: '#/components/schemas/Session_d5d120e942d17641_2'
                    examples:
                        current:
                            $ref: '#/components/examples/AuthRefreshStatus200ResponseCurrentExample'
                        next:
                            $ref: '#/components/examples/AuthRefreshStatus200ResponseNextExample'
        AuthRevokeStatus204Response:
            description: No Content response.
    examples:
        AuthRefreshRequestBodyBackupExample:
            summary: backup
            value:
                legacyToken: legacy-token-2
                password: swordfish
                profile: eyJyb2xlIjoiZWRpdG9yIn0=
                username: bob
        AuthRefreshRequestBodyPrimaryExample:
            summary: primary
            value:
                legacyToken: legacy-token
                password: hunter2
                profile: eyJyb2xlIjoiYWRtaW4ifQ==
                username: alice
        AuthRefreshStatus200ResponseCurrentExample:
            summary: current
            value:
                expiresAt: "2026-03-20T12:00:00Z"
                token: token-123
                traceID: trace_123
        AuthRefreshStatus200ResponseNextExample:
            summary: next
            value:
                expiresAt: "2026-03-21T12:00:00Z"
                token: token-456
                traceID: trace_456
        XTraceIDHeaderTraceAExample:
            summary: trace-a
            value: trace_123
        XTraceIDHeaderTraceBExample:
            summary: trace-b
            value: trace_456
tags:
    - name: Auth
      description: Authentication operations.
