openapi: 3.2.0
info:
    title: Scalar Map Keys API
    version: 1.0.0
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: scalarMapKeys
      url: http://localhost:80
      description: Default server for scalarMapKeys
paths:
    /flags:
        get:
            tags:
                - flags
            summary: list flags
            operationId: flags.list
            parameters:
                - name: enabled
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: object
                    additionalProperties:
                        type: array
                        items:
                            type: boolean
                            example: true
                        example:
                            - false
                            - true
                            - true
                            - true
                  example:
                    "false":
                        - true
                        - false
                        - true
                    "true":
                        - false
                        - true
                        - false
                - name: labels
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: object
                    default:
                        "false": "off"
                        "true": "on"
                    additionalProperties:
                        type: string
                        example: Natus iste beatae itaque.
                  example:
                    "false": Ut est.
                    "true": Similique earum est.
                - name: groups
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: object
                    additionalProperties:
                        type: object
                        example:
                            "true": 7551319913391425837
                        additionalProperties:
                            type: integer
                            example: 9135328173533054652
                            format: int64
                  example:
                    Autem maiores nulla earum distinctio animi.:
                        "false": 8915706317955267537
                        "true": 4780905263337237648
                    Numquam nostrum consequatur qui quos.:
                        "true": 4333032517208564965
                    Voluptate voluptatem maiores.:
                        "true": 6209769877611670744
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                type: object
                                example:
                                    "1": one
                                    "20": twenty
                                additionalProperties:
                                    type: string
                                    example: Laudantium omnis maiores qui non.
                            example:
                                "1": one
                                "20": twenty
            security: []
        put:
            tags:
                - flags
            summary: update flags
            operationId: flags.update
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            example:
                                metadata: Sint maxime vero dolor qui quibusdam.
                                rules:
                                    "true":
                                        maxCount: 3
                            $ref: '#/components/schemas/UpdateRequestBody'
                        example:
                            metadata: Sint maxime vero dolor qui quibusdam.
                            rules:
                                "true":
                                    maxCount: 3
            responses:
                "204":
                    description: No Content response.
            security: []
components:
    schemas:
        Rule:
            type: object
            properties:
                maxCount:
                    type: integer
                    example: 8083868002614079068
                    format: int64
            example:
                maxCount: 284586948460135450
            required:
                - maxCount
        UpdateRequestBody:
            type: object
            properties:
                metadata:
                    default:
                        "18446744073709551615":
                            "1.2": nested
                        "7": seven
                    example: Vero qui sunt doloremque earum saepe laboriosam.
                rules:
                    type: object
                    example:
                        "true":
                            maxCount: 3
                    additionalProperties:
                        $ref: '#/components/schemas/Rule'
            example:
                metadata: Ex eaque est id veritatis mollitia qui.
                rules:
                    "true":
                        maxCount: 3
            required:
                - rules
tags:
    - name: flags
