openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /:
        get:
            tags:
                - testService
            summary: testEndpointDefault testService
            operationId: test_service.test_endpoint_default
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    int: 1
                                    string: ""
                                $ref: '#/components/schemas/JSON_d366c2282411fe40'
                            example:
                                int: 1
                                string: ""
            security: []
    /customized:
        get:
            tags:
                - testService
            summary: testEndpointCustomized testService
            operationId: test_service.test_endpoint_customized
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    string: ""
                                $ref: '#/components/schemas/TestEndpointCustomizedResponseBodyTiny'
                            example:
                                string: ""
            security: []
    /overridden:
        get:
            tags:
                - testService
            summary: testEndpointOverridden testService
            operationId: test_service.test_endpoint_overridden
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    int: 1
                                    string: ""
                                $ref: '#/components/schemas/TestEndpointOverriddenResponseBodyOverridden'
                            example:
                                int: 1
                                string: ""
            security: []
    /tiny:
        get:
            tags:
                - testService
            summary: testEndpointTiny testService
            operationId: test_service.test_endpoint_tiny
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    string: ""
                                $ref: '#/components/schemas/TestEndpointTinyResponseBodyTiny'
                            example:
                                string: ""
            security: []
components:
    schemas:
        JSON_d366c2282411fe40:
            type: object
            properties:
                int:
                    type: integer
                    example: 1
                    format: int64
                string:
                    type: string
                    example: ""
            description: Result result type (default view)
            example:
                int: 1
                string: ""
        TestEndpointCustomizedResponseBodyTiny:
            type: object
            properties:
                string:
                    type: string
                    example: ""
            description: Result_testEndpointCustomized_Result result type (tiny view)
            example:
                string: ""
            required:
                - string
        TestEndpointOverriddenResponseBodyOverridden:
            type: object
            properties:
                int:
                    type: integer
                    example: 1
                    format: int64
                string:
                    type: string
                    example: ""
            description: Result_testEndpointOverridden_Result result type (overridden view)
            example:
                int: 1
                string: ""
            required:
                - int
        TestEndpointTinyResponseBodyTiny:
            type: object
            properties:
                string:
                    type: string
                    example: ""
            description: Result result type (tiny view)
            example:
                string: ""
tags:
    - name: testService
