openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /path1:
        get:
            tags:
                - service-name
            summary: Download filename
            operationId: service_name.path1
            responses:
                "200":
                    description: File downloaded
    /path2:
        get:
            tags:
                - user-tag
            summary: Download filename
            operationId: service_name.path2
            responses:
                "200":
                    description: File downloaded
components: {}
tags:
    - name: service-name
