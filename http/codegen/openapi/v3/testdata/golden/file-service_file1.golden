openapi: 3.1.1
info:
    title: Goa API
    version: 0.0.1
jsonSchemaDialect: https://json-schema.org/draft/2020-12/schema
servers:
    - url: http://localhost:80
      description: Default server for test api
paths:
    /path1:
        get:
            tags:
                - service-name
            summary: Download filename
            operationId: service_name.path1
            responses:
                "200":
                    $ref: '#/components/responses/ServiceNamePath1Status200Response'
    /path2:
        get:
            tags:
                - user-tag
            summary: Download filename
            operationId: service_name.path2
            responses:
                "200":
                    $ref: '#/components/responses/ServiceNamePath1Status200Response'
components:
    responses:
        ServiceNamePath1Status200Response:
            description: File downloaded
tags:
    - name: service-name
