{
  "components": {
    "schemas": {
      "LoomCustomError": {
        "example": {
          "message": "error message",
          "name": "custom"
        },
        "properties": {
          "message": {
            "example": "error message",
            "type": "string"
          },
          "name": {
            "example": "custom",
            "type": "string"
          }
        },
        "required": [
          "name",
          "message"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "Problem response result type",
        "example": {
          "code": "bad_request",
          "detail": "parameter 'p' must be an integer",
          "instance": "urn:loom:error:123abc",
          "retry_hint": "Correct the payload and retry.",
          "status": 400,
          "title": "Bad Request",
          "type": "https://github.com/CaliLuke/loom/problems/bad-request"
        },
        "properties": {
          "code": {
            "description": "Code is the stable machine-readable problem code.",
            "example": "bad_request",
            "type": "string"
          },
          "detail": {
            "description": "Detail is a human-readable explanation specific to this occurrence of the problem.",
            "example": "parameter 'p' must be an integer",
            "type": "string"
          },
          "instance": {
            "description": "Instance identifies this specific occurrence of the problem.",
            "example": "urn:loom:error:123abc",
            "type": "string"
          },
          "retry_hint": {
            "description": "Retry hint is concise guidance on how to correct the request or retry the operation.",
            "example": "Correct the payload and retry.",
            "type": "string"
          },
          "status": {
            "description": "Status is the HTTP status code generated for this occurrence of the problem.",
            "example": 400,
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Title is a short, human-readable summary of the problem type.",
            "example": "Bad Request",
            "type": "string"
          },
          "type": {
            "description": "Type identifies the problem category using a URI reference.",
            "example": "https://github.com/CaliLuke/loom/problems/bad-request",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Loom API",
    "version": "0.0.1"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "openapi": "3.2.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "errors.error",
        "responses": {
          "204": {
            "description": "No Content response."
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "bad_request: Bad Request response."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "not_found: Not Found response."
          },
          "409": {
            "content": {
              "application/vnd.loom.custom-error": {
                "example": {
                  "message": "error message",
                  "name": "custom"
                },
                "schema": {
                  "$ref": "#/components/schemas/LoomCustomError"
                }
              }
            },
            "description": "custom: Conflict response."
          }
        },
        "summary": "Error Errors",
        "tags": [
          "Errors"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Default server for test api",
      "name": "test api",
      "url": "http://localhost:80"
    }
  ],
  "tags": [
    {
      "name": "Errors"
    }
  ]
}
