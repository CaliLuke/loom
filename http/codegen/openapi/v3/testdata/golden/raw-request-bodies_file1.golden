openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /choice:
        post:
            tags:
                - raw_upload
            summary: typed_choice raw_upload
            operationId: raw_upload.typed_choice
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                type: object
                                example:
                                    type: String
                                    value: Voluptatem vero.
                                oneOf:
                                    - $ref: '#/components/schemas/RawUploadChoiceRawUploadManifestEnvelope'
                                    - $ref: '#/components/schemas/RawUploadChoiceStringEnvelope'
                                discriminator:
                                    propertyName: type
                                    mapping:
                                        RawUploadManifest: '#/components/schemas/RawUploadChoiceRawUploadManifestEnvelope'
                                        String: '#/components/schemas/RawUploadChoiceStringEnvelope'
                            example:
                                type: String
                                value: Voluptatem vero.
            security: []
    /exchange:
        post:
            tags:
                - raw_upload
            summary: exchange raw_upload
            operationId: raw_upload.exchange
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            example: Neque omnis illum id sed.
                            oneOf:
                                - example:
                                    name: Consequatur quam.
                                    size: 569645239990550720
                                  $ref: '#/components/schemas/RawUploadManifest'
                                - type: string
                                  example: Nam alias voluptas delectus.
                        example: Neque omnis illum id sed.
            responses:
                "200":
                    description: OK response.
                    content:
                        application/json:
                            schema:
                                example:
                                    - choice:
                                        type: String
                                        value: Non eos aut.
                                    - choice:
                                        type: String
                                        value: Non eos aut.
                                    - choice:
                                        type: String
                                        value: Non eos aut.
                                oneOf:
                                    - example:
                                        - choice:
                                            type: RawUploadManifest
                                            value:
                                                name: Quam tenetur id omnis accusantium.
                                                size: 3100183855936877164
                                        - choice:
                                            type: RawUploadManifest
                                            value:
                                                name: Quam tenetur id omnis accusantium.
                                                size: 3100183855936877164
                                        - choice:
                                            type: RawUploadManifest
                                            value:
                                                name: Quam tenetur id omnis accusantium.
                                                size: 3100183855936877164
                                        - choice:
                                            type: RawUploadManifest
                                            value:
                                                name: Quam tenetur id omnis accusantium.
                                                size: 3100183855936877164
                                      $ref: '#/components/schemas/RawUploadItems'
                                    - example:
                                        results:
                                            - choice:
                                                type: String
                                                value: Omnis maiores mollitia et et est necessitatibus.
                                            - choice:
                                                type: String
                                                value: Omnis maiores mollitia et et est necessitatibus.
                                      $ref: '#/components/schemas/RawUploadPage'
                            example:
                                - choice:
                                    type: String
                                    value: Non eos aut.
                                - choice:
                                    type: String
                                    value: Non eos aut.
                                - choice:
                                    type: String
                                    value: Non eos aut.
            security: []
    /imports:
        post:
            tags:
                - raw_upload
            summary: upload_text raw_upload
            operationId: raw_upload.upload_text
            requestBody:
                description: Optional newline-delimited import commands.
                content:
                    text/plain; charset=utf-8:
                        schema:
                            type: string
                            description: Optional newline-delimited import commands.
                            example: create widget
                        example: create widget
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
            security: []
    /manifests:
        post:
            tags:
                - raw_upload
            summary: upload_manifest raw_upload
            operationId: raw_upload.upload_manifest
            requestBody:
                description: Named manifest schema carried as an unparsed stream.
                required: true
                content:
                    application/vnd.loom.manifest+json:
                        schema:
                            description: Named manifest schema carried as an unparsed stream.
                            example:
                                name: Et quis officiis quis modi distinctio.
                                size: 2491333080029964247
                            $ref: '#/components/schemas/RawUploadManifest'
                        example:
                            name: Et quis officiis quis modi distinctio.
                            size: 2491333080029964247
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
            security: []
    /uploads/{id}:
        post:
            tags:
                - raw_upload
            summary: upload_binary raw_upload
            operationId: raw_upload.upload_binary
            parameters:
                - name: id
                  in: path
                  required: true
                  schema:
                    type: string
                  example: Natus ducimus id qui illum et.
                - name: filter
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: string
                  example: Exercitationem neque necessitatibus earum enim.
                - name: X-Checksum
                  in: header
                  required: true
                  schema:
                    type: string
                  example: Explicabo aut laboriosam.
                - name: upload_session
                  in: cookie
                  schema:
                    type: string
                  example: Est occaecati ut aperiam impedit.
            requestBody:
                description: Binary archive streamed directly to the service.
                required: true
                content:
                    application/octet-stream:
                        schema:
                            type: string
                            description: Binary archive streamed directly to the service.
                            example: YXJjaGl2ZQ==
                            format: binary
                        example: archive
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
            security:
                - upload_key: []
components:
    schemas:
        RawUploadChoice:
            type: object
            example:
                type: String
                value: Sint rerum facilis maiores.
            oneOf:
                - $ref: '#/components/schemas/RawUploadChoiceRawUploadManifestEnvelope'
                - $ref: '#/components/schemas/RawUploadChoiceStringEnvelope'
            discriminator:
                propertyName: type
                mapping:
                    RawUploadManifest: '#/components/schemas/RawUploadChoiceRawUploadManifestEnvelope'
                    String: '#/components/schemas/RawUploadChoiceStringEnvelope'
        RawUploadChoiceRawUploadManifestEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - RawUploadManifest
                value:
                    example:
                        name: Expedita quae illo provident.
                        size: 1974262441509041867
                    $ref: '#/components/schemas/RawUploadManifest'
            description: Synthetic wrapper for union variant "RawUploadManifest".
            required:
                - type
                - value
        RawUploadChoiceStringEnvelope:
            type: object
            properties:
                type:
                    type: string
                    enum:
                        - String
                value:
                    type: string
                    example: Et qui.
            description: Synthetic wrapper for union variant "String".
            required:
                - type
                - value
        RawUploadItem:
            type: object
            properties:
                choice:
                    $ref: '#/components/schemas/RawUploadChoice'
            required:
                - choice
        RawUploadItems:
            type: array
            items:
                $ref: '#/components/schemas/RawUploadItem'
            example:
                - choice:
                    type: String
                    value: Ducimus aspernatur.
                - choice:
                    type: String
                    value: Ducimus aspernatur.
                - choice:
                    type: String
                    value: Ducimus aspernatur.
        RawUploadManifest:
            type: object
            properties:
                name:
                    type: string
                    example: Fuga doloribus magni eos rerum.
                size:
                    type: integer
                    example: 663373690153682594
                    format: int64
            example:
                name: Doloribus velit facilis.
                size: 9108725260903456715
            required:
                - name
                - size
        RawUploadPage:
            type: object
            properties:
                results:
                    $ref: '#/components/schemas/RawUploadItems'
            example:
                results:
                    - choice:
                        type: RawUploadManifest
                        value:
                            name: Sit rerum tempore animi alias.
                            size: 1042549988806284555
                    - choice:
                        type: RawUploadManifest
                        value:
                            name: Sit rerum tempore animi alias.
                            size: 1042549988806284555
            required:
                - results
    responses:
        NoContentResponse:
            description: No Content response.
    securitySchemes:
        upload_key:
            type: apiKey
            name: X-Upload-Key
            in: header
tags:
    - name: raw_upload
