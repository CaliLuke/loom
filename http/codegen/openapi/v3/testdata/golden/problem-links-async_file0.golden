{
  "components": {
    "parameters": {
      "PathThreadID": {
        "example": "thr_42",
        "in": "path",
        "name": "thread_id",
        "required": true,
        "schema": {
          "example": "thr_42",
          "type": "string"
        }
      }
    },
    "responses": {
      "OpenAPIThreadAcceptedStatus202Response": {
        "content": {
          "application/json": {
            "example": {
              "thread_id": "thr_42",
              "watch_url": "https://api.contract-surfaces.example.test/threads/thr_42/events"
            },
            "schema": {
              "$ref": "#/components/schemas/OpenAPIThreadAccepted"
            }
          }
        },
        "description": "Accepted response.",
        "links": {
          "thread": {
            "operationId": "thread_ops.get_thread",
            "parameters": {
              "thread_id": "$response.body#/thread_id"
            }
          },
          "watch": {
            "operationId": "thread_ops.watch_thread",
            "parameters": {
              "thread_id": "$response.body#/thread_id"
            }
          }
        }
      }
    },
    "schemas": {
      "CreateThreadRequestBody": {
        "additionalProperties": false,
        "example": {
          "title": "Release freeze follow-up"
        },
        "properties": {
          "title": {
            "example": "Release freeze follow-up",
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "type": "object"
      },
      "OpenAPIThreadAccepted": {
        "additionalProperties": false,
        "example": {
          "thread_id": "thr_42",
          "watch_url": "https://api.contract-surfaces.example.test/threads/thr_42/events"
        },
        "properties": {
          "thread_id": {
            "example": "thr_42",
            "pattern": "^thr_[0-9]+$",
            "type": "string"
          },
          "watch_url": {
            "example": "https://api.contract-surfaces.example.test/threads/thr_42/events",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "watch_url"
        ],
        "type": "object"
      },
      "OpenAPIThreadEvent": {
        "additionalProperties": false,
        "example": {
          "data": {
            "author": "alice",
            "preview": "Shipping the OpenAPI cleanup next."
          },
          "event": "thread.message_posted",
          "id": "evt_8"
        },
        "properties": {
          "data": {
            "additionalProperties": false,
            "example": {
              "author": "alice",
              "preview": "Shipping the OpenAPI cleanup next."
            },
            "properties": {
              "author": {
                "example": "alice",
                "type": "string"
              },
              "preview": {
                "example": "Shipping the OpenAPI cleanup next.",
                "type": "string"
              }
            },
            "required": [
              "author",
              "preview"
            ],
            "type": "object"
          },
          "event": {
            "example": "thread.message_posted",
            "type": "string"
          },
          "id": {
            "example": "evt_8",
            "type": "string"
          }
        },
        "required": [
          "id",
          "event",
          "data"
        ],
        "type": "object"
      },
      "OpenAPIThreadSummary": {
        "additionalProperties": false,
        "example": {
          "thread_id": "thr_42",
          "title": "Release freeze follow-up"
        },
        "properties": {
          "thread_id": {
            "example": "thr_42",
            "pattern": "^thr_[0-9]+$",
            "type": "string"
          },
          "title": {
            "example": "Release freeze follow-up",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "title"
        ],
        "type": "object"
      },
      "Problem": {
        "additionalProperties": false,
        "example": {
          "code": "bad_request",
          "detail": "parameter 'p' must be an integer",
          "fault": true,
          "instance": "urn:goa:error:123abc",
          "status": 400,
          "temporary": false,
          "timeout": false,
          "title": "Bad Request",
          "type": "https://goa.design/problems/bad-request"
        },
        "properties": {
          "code": {
            "description": "Code is the stable machine-readable problem code.",
            "example": "bad_request",
            "type": "string"
          },
          "detail": {
            "description": "Detail is a human-readable explanation specific to this occurrence of the problem.",
            "example": "parameter 'p' must be an integer",
            "type": "string"
          },
          "fault": {
            "description": "Fault indicates whether the problem represents a server-side fault.",
            "example": true,
            "type": "boolean"
          },
          "instance": {
            "description": "Instance identifies this specific occurrence of the problem.",
            "example": "urn:goa:error:123abc",
            "type": "string"
          },
          "status": {
            "description": "Status is the HTTP status code generated for this occurrence of the problem.",
            "example": 400,
            "format": "int64",
            "type": "integer"
          },
          "temporary": {
            "description": "Temporary indicates whether retrying later may succeed.",
            "example": false,
            "type": "boolean"
          },
          "timeout": {
            "description": "Timeout indicates whether the problem was caused by a timeout.",
            "example": true,
            "type": "boolean"
          },
          "title": {
            "description": "Title is a short, human-readable summary of the problem type.",
            "example": "Bad Request",
            "type": "string"
          },
          "type": {
            "description": "Type identifies the problem category using a URI reference.",
            "example": "https://goa.design/problems/bad-request",
            "type": "string"
          }
        },
        "required": [
          "code",
          "title",
          "detail"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Exercises problem documents, workflow links, and async streaming contracts.",
    "title": "Contract Surfaces API",
    "version": "0.0.1"
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "openapi": "3.1.1",
  "paths": {
    "/threads": {
      "post": {
        "operationId": "thread_ops.create_thread",
        "requestBody": {
          "content": {
            "application/json": {
              "example": {
                "title": "Release freeze follow-up"
              },
              "schema": {
                "$ref": "#/components/schemas/CreateThreadRequestBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/OpenAPIThreadAcceptedStatus202Response"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "bad_request",
                  "detail": "parameter 'p' must be an integer",
                  "fault": true,
                  "instance": "urn:goa:error:123abc",
                  "status": 400,
                  "temporary": true,
                  "timeout": true,
                  "title": "Bad Request",
                  "type": "https://goa.design/problems/bad-request"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "not_found: Not Found response."
          },
          "409": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "bad_request",
                  "detail": "parameter 'p' must be an integer",
                  "fault": false,
                  "instance": "urn:goa:error:123abc",
                  "status": 400,
                  "temporary": false,
                  "timeout": true,
                  "title": "Bad Request",
                  "type": "https://goa.design/problems/bad-request"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "conflict: Conflict response."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "example": {
                  "code": "bad_request",
                  "detail": "parameter 'p' must be an integer",
                  "fault": false,
                  "instance": "urn:goa:error:123abc",
                  "status": 400,
                  "temporary": false,
                  "timeout": true,
                  "title": "Bad Request",
                  "type": "https://goa.design/problems/bad-request"
                },
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "busy: Too Many Requests response."
          }
        },
        "security": [],
        "summary": "createThread threadOps",
        "tags": [
          "threadOps"
        ]
      }
    },
