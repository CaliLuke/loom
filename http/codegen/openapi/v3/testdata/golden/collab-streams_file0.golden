{
  "components": {
    "parameters": {
      "PathThreadID": {
        "example": "thr_42",
        "in": "path",
        "name": "thread_id",
        "required": true,
        "schema": {
          "pattern": "^thr_[0-9]+$",
          "type": "string"
        }
      }
    },
    "schemas": {
      "Problem": {
        "additionalProperties": false,
        "example": {
          "code": "bad_request",
          "detail": "parameter 'p' must be an integer",
          "instance": "urn:loom:error:123abc",
          "retry_hint": "Correct the payload and retry.",
          "status": 400,
          "title": "Bad Request",
          "type": "https://github.com/CaliLuke/loom/problems/bad-request"
        },
        "properties": {
          "code": {
            "description": "Code is the stable machine-readable problem code.",
            "example": "bad_request",
            "type": "string"
          },
          "detail": {
            "description": "Detail is a human-readable explanation specific to this occurrence of the problem.",
            "example": "parameter 'p' must be an integer",
            "type": "string"
          },
          "instance": {
            "description": "Instance identifies this specific occurrence of the problem.",
            "example": "urn:loom:error:123abc",
            "type": "string"
          },
          "retry_hint": {
            "description": "Retry hint is concise guidance on how to correct the request or retry the operation.",
            "example": "Correct the payload and retry.",
            "type": "string"
          },
          "status": {
            "description": "Status is the HTTP status code generated for this occurrence of the problem.",
            "example": 400,
            "format": "int64",
            "type": "integer"
          },
          "title": {
            "description": "Title is a short, human-readable summary of the problem type.",
            "example": "Bad Request",
            "type": "string"
          },
          "type": {
            "description": "Type identifies the problem category using a URI reference.",
            "example": "https://github.com/CaliLuke/loom/problems/bad-request",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "type": "object"
      },
      "ThreadSummary": {
        "additionalProperties": false,
        "example": {
          "participants": [
            "alice",
            "bob"
          ],
          "thread_id": "thr_42",
          "title": "Release freeze follow-up"
        },
        "properties": {
          "participants": {
            "example": [
              "alice",
              "bob"
            ],
            "items": {
              "example": "Quam assumenda ut vel enim rerum fugiat.",
              "type": "string"
            },
            "type": "array"
          },
          "thread_id": {
            "example": "thr_42",
            "pattern": "^thr_[0-9]+$",
            "type": "string"
          },
          "title": {
            "example": "Release freeze follow-up",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "title"
        ],
        "type": "object"
      },
      "WatchThreadResponseBody": {
        "additionalProperties": false,
        "example": {
          "data": {
            "author": "alice",
            "preview": "Shipping the OpenAPI cleanup next."
          },
          "event": "thread.message_posted",
          "id": "evt_8"
        },
        "properties": {
          "data": {
            "additionalProperties": false,
            "example": {
              "author": "alice",
              "preview": "Shipping the OpenAPI cleanup next."
            },
            "properties": {
              "author": {
                "example": "alice",
                "type": "string"
              },
              "preview": {
                "example": "Shipping the OpenAPI cleanup next.",
                "type": "string"
              }
            },
            "required": [
              "author",
              "preview"
            ],
            "type": "object"
          },
          "event": {
            "example": "thread.message_posted",
            "type": "string"
          },
          "id": {
            "example": "evt_8",
            "type": "string"
          }
        },
        "required": [
          "id",
          "event",
          "data"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Collaborative thread operations exposed through HTTP and SSE.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "title": "Collaboration Streams API",
    "version": "0.0.1"
  },
  "jsonSchemaDialect": "https://spec.openapis.org/oas/3.1/dialect/base",
  "openapi": "3.2.0",
  "paths": {
    "/threads/{thread_id}": {
      "get": {
        "operationId": "collab_streams.get_thread",
        "parameters": [
          {
            "$ref": "#/components/parameters/PathThreadID"
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "participants": [
                    "alice",
                    "bob"
                  ],
                  "thread_id": "thr_42",
                  "title": "Release freeze follow-up"
                },
                "schema": {
                  "$ref": "#/components/schemas/ThreadSummary"
                }
              }
            },
            "description": "OK response."
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "not_found: Not Found response."
          }
        },
        "security": [],
        "summary": "getThread collabStreams",
        "tags": [
          "collabStreams"
        ]
      }
    },
    "/threads/{thread_id}/events": {
      "get": {
        "operationId": "collab_streams.watch_thread",
        "parameters": [
          {
            "$ref": "#/components/parameters/PathThreadID"
          },
          {
            "allowEmptyValue": true,
            "example": "evt_7",
            "in": "query",
            "name": "last_event_id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "additionalProperties": false,
                  "properties": {
                    "data": {
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "$ref": "#/components/schemas/WatchThreadResponseBody"
                      },
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "data"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "OK response."
          },
          "429": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "busy: Too Many Requests response."
          }
        },
        "security": [],
        "summary": "watchThread collabStreams",
        "tags": [
          "collabStreams"
        ],
        "x-loom-async": {
          "direction": "server",
          "handshake": {
            "path": "/threads/{thread_id}/events",
            "request": {
              "method": "GET"
            },
            "response": {
              "contentType": "text/event-stream",
              "status": 200
            }
          },
          "messages": {
            "outbound": {
              "contentType": "application/json",
              "schema": {
                "additionalProperties": false,
                "example": {
                  "data": {
                    "author": "alice",
                    "preview": "Shipping the OpenAPI cleanup next."
                  },
                  "event": "thread.message_posted",
                  "id": "evt_8"
                },
                "properties": {
                  "data": {
                    "additionalProperties": false,
                    "example": {
                      "author": "alice",
                      "preview": "Shipping the OpenAPI cleanup next."
                    },
                    "properties": {
                      "author": {
                        "example": "alice",
                        "type": "string"
                      },
                      "preview": {
                        "example": "Shipping the OpenAPI cleanup next.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "author",
                      "preview"
                    ],
                    "type": "object"
                  },
                  "event": {
                    "example": "thread.message_posted",
                    "type": "string"
                  },
                  "id": {
                    "example": "evt_8",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "event",
                  "data"
                ],
                "type": "object"
              },
              "sse": {
                "dataField": null,
                "eventField": null,
                "idField": "id",
                "requestIDField": "last_event_id",
                "retryField": null
              }
            }
          },
          "transport": "sse"
        }
      }
    }
  },
  "servers": [
    {
      "name": "collab-streams",
      "url": "https://api.collab-streams.example.test"
    }
  ],
  "tags": [
    {
      "description": "Thread collaboration entry points.",
      "name": "collabStreams"
    }
  ]
}
