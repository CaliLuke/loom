      "get": {
        "operationId": "streaming_partial_examples.events",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/RealtimeSSEEvent"
                }
              }
            },
            "description": "OK response."
          }
        },
        "security": [],
        "summary": "events streamingPartialExamples",
        "tags": [
          "streamingPartialExamples"
        ]
      }
    },
    "/ws/projects/{projectID}": {
      "get": {
        "operationId": "streaming_partial_examples.project_socket",
        "parameters": [
          {
            "example": "proj_1",
            "in": "path",
            "name": "projectID",
            "required": true,
            "schema": {
              "example": "proj_1",
              "type": "string"
            }
          }
        ],
        "responses": {
          "101": {
            "description": "Switching Protocols response."
          }
        },
        "security": [],
        "summary": "projectSocket streamingPartialExamples",
