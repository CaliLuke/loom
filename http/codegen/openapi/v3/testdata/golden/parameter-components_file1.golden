openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /gadgets/{widgetID}:
        get:
            tags:
                - componentService
            summary: listGadgets componentService
            operationId: component_service.list_gadgets
            parameters:
                - $ref: '#/components/parameters/PathWidgetID'
                - $ref: '#/components/parameters/QueryLimit'
            responses:
                "200":
                    $ref: '#/components/responses/ComponentServiceListGadgetsStatus200Response'
    /widgets/{widgetID}:
        get:
            tags:
                - componentService
            summary: listWidgets componentService
            operationId: component_service.list_widgets
            parameters:
                - $ref: '#/components/parameters/PathWidgetID'
                - $ref: '#/components/parameters/QueryLimit'
            responses:
                "200":
                    $ref: '#/components/responses/ComponentServiceListGadgetsStatus200Response'
components:
    parameters:
        PathWidgetID:
            name: widgetID
            in: path
            description: Widget identifier.
            required: true
            schema:
                type: string
            example: widget-123
        QueryLimit:
            name: limit
            in: query
            description: Page size.
            allowEmptyValue: true
            schema:
                type: integer
                format: int64
                minimum: 1
            example: 25
    responses:
        ComponentServiceListGadgetsStatus200Response:
            description: OK response.
            content:
                application/json:
                    schema:
                        type: string
                        example: Autem rem beatae non.
                    example: Repellat ducimus.
tags:
    - name: componentService
