openapi: 3.2.0
info:
    title: Ops Socket API
    description: WebSocket control surface for operator consoles.
    license:
        name: Apache-2.0
        url: https://www.apache.org/licenses/LICENSE-2.0.html
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: ops-socket
      url: https://api.ops-socket.example.test
paths:
    /ws/ops/{channel}:
        get:
            operationId: ops_socket.stream_commands
            parameters:
                - name: channel
                  in: path
                  required: true
                  schema:
                    type: string
                  example: deployments
            responses:
                "101":
                    description: Switching Protocols response.
            security: []
            summary: streamCommands opsSocket
            tags:
                - opsSocket
            x-loom-async:
                direction: bidirectional
                handshake:
                    path: /ws/ops/{channel}
                    request:
                        method: GET
                    response:
                        contentType: ""
                        status: 101
                messages:
                    inbound:
                        contentType: application/json
                        schema:
                            type: object
                            properties:
                                op:
                                    type: string
                                    example: pause
                                target:
                                    type: string
                                    example: worker-eu-1
                            example:
                                op: pause
                                target: worker-eu-1
                            required:
                                - op
                                - target
                            additionalProperties: false
                    outbound:
                        contentType: application/json
                        schema:
                            type: object
                            properties:
                                event:
                                    type: string
                                    example: command.accepted
                                ok:
                                    type: boolean
                                    example: true
                            example:
                                event: command.accepted
                                ok: true
                            required:
                                - event
                                - ok
                            additionalProperties: false
                transport: websocket
components: {}
tags:
    - name: opsSocket
      description: Bidirectional operator control channel.
