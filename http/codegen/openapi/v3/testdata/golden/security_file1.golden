openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /:
        get:
            tags:
                - testService
            summary: testEndpointA testService
            operationId: test_service.test_endpoint_a
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
            security:
                - api_key_query_k: []
                  basic: []
                  jwt_header_X-Authorization: []
        post:
            tags:
                - testService
            summary: testEndpointB testService
            operationId: test_service.test_endpoint_b
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
            security:
                - api_key_header_X-Key: []
                - oauth2:
                    - api:read
                    - api:write
    /query-token:
        get:
            tags:
                - testService
            summary: testEndpointC testService
            operationId: test_service.test_endpoint_c
            responses:
                "204":
                    $ref: '#/components/responses/NoContentResponse'
            security:
                - jwt_query_access_token: []
components:
    responses:
        NoContentResponse:
            description: No Content response.
    securitySchemes:
        api_key_header_X-Key:
            type: apiKey
            description: Secures endpoint by requiring an API key.
            name: X-Key
            in: header
        api_key_query_k:
            type: apiKey
            description: Secures endpoint by requiring an API key.
            name: k
            in: query
        basic:
            type: http
            description: Basic authentication used to authenticate security principal during signin
            scheme: basic
        jwt_header_X-Authorization:
            type: apiKey
            description: Secures endpoint by requiring a valid JWT token retrieved via the signin endpoint. Supports scopes "api:read" and "api:write".
            name: X-Authorization
            in: header
        jwt_query_access_token:
            type: apiKey
            description: Secures endpoint by requiring a valid JWT token retrieved via the signin endpoint. Supports scopes "api:read" and "api:write".
            name: access_token
            in: query
        oauth2:
            type: oauth2
            description: Secures endpoint by requiring a valid OAuth2 token retrieved via the signin endpoint. Supports scopes "api:read" and "api:write".
            flows:
                authorizationCode:
                    authorizationUrl: http://loom.design/authorization
                    tokenUrl: http://loom.design/token
                    refreshUrl: http://loom.design/refresh
                    scopes:
                        api:read: Read-only access
                        api:write: Read and write access
tags:
    - name: testService
