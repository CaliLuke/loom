openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /inline_attribute:
        post:
            tags:
                - InlineBody
            summary: inline_attribute InlineBody
            operationId: inline_body.inline_attribute
            parameters:
                - name: q
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: string
                  example: Eos voluptatem exercitationem dolores tempora optio dolores.
            requestBody:
                content:
                    application/json:
                        schema:
                            type: object
                            properties:
                                "y":
                                    type: string
                                    example: Molestiae asperiores soluta aut pariatur qui sed.
                            example:
                                "y": Ea nihil autem facilis.
                        example:
                            "y": At omnis blanditiis consequatur.
            responses:
                "200":
                    description: OK response.
                    headers:
                        h:
                            schema:
                                type: string
                                example: Et earum modi sit eum consequatur quo.
                            example: Et earum modi sit eum consequatur quo.
                    content:
                        application/json:
                            schema:
                                example:
                                    "y": Quas reprehenderit sint.
                                $ref: '#/components/schemas/InlineBodyinlineAttributeResponseBody'
                            example:
                                "y": Quas reprehenderit sint.
    /primitive:
        post:
            tags:
                - InlineBody
            summary: primitive InlineBody
            operationId: inline_body.primitive
            parameters:
                - name: q
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: string
                  example: Natus in.
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            properties:
                                name:
                                    type: string
                                    example: Et ratione ut vero accusamus veritatis animi.
                            example:
                                name: Earum fuga et nulla similique blanditiis adipisci.
                            required:
                                - name
                        example:
                            name: Occaecati error facere.
            responses:
                "200":
                    description: OK response.
                    headers:
                        h:
                            schema:
                                type: string
                                example: Fuga ipsum officia ut natus.
                            example: Fuga ipsum officia ut natus.
                    content:
                        application/json:
                            schema:
                                example:
                                    name: Est dolores dolorem vitae saepe ea.
                                $ref: '#/components/schemas/InlineBodyprimitiveResponseBody'
                            example:
                                name: Est dolores dolorem vitae saepe ea.
    /required:
        post:
            tags:
                - InlineBody
            summary: required InlineBody
            operationId: inline_body.required
            parameters:
                - name: q
                  in: query
                  allowEmptyValue: true
                  required: true
                  schema:
                    type: string
                  example: Qui voluptate quidem dolorem expedita eius.
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            properties:
                                item:
                                    $ref: '#/components/schemas/Item'
                            example:
                                item:
                                    x: Totam necessitatibus perferendis perspiciatis.
                            required:
                                - item
                        example:
                            item:
                                x: Error rerum esse et corrupti.
            responses:
                "200":
                    description: OK response.
                    headers:
                        h:
                            schema:
                                type: string
                                example: Nostrum quia natus eveniet delectus nobis.
                            example: Nostrum quia natus eveniet delectus nobis.
                    content:
                        application/json:
                            schema:
                                example:
                                    item:
                                        x: Vel eius exercitationem qui et corrupti a.
                                $ref: '#/components/schemas/InlineBodyrequiredResponseBody'
                            example:
                                item:
                                    x: Vel eius exercitationem qui et corrupti a.
    /several:
        post:
            tags:
                - InlineBody
            summary: several InlineBody
            operationId: inline_body.several
            parameters:
                - name: q
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: string
                  example: Accusamus nisi sed consequatur.
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            properties:
                                count:
                                    type: integer
                                    example: 4112760733247613420
                                    format: int64
                                item:
                                    $ref: '#/components/schemas/Item'
                                items:
                                    type: array
                                    items:
                                        $ref: '#/components/schemas/Item'
                                    example:
                                        - x: Consequatur consequatur.
                                        - x: Consequatur consequatur.
                                        - x: Consequatur consequatur.
                                        - x: Consequatur consequatur.
                                name:
                                    type: string
                                    example: Qui similique voluptatem dolor dicta voluptas.
                            example:
                                count: 5588012325558585925
                                item:
                                    x: Unde qui aperiam laboriosam distinctio sunt.
                                items:
                                    - x: Unde qui aperiam laboriosam distinctio sunt.
                                    - x: Unde qui aperiam laboriosam distinctio sunt.
                                name: Labore assumenda.
                            required:
                                - name
                        example:
                            count: 3887349582176772536
                            item:
                                x: Magnam assumenda cupiditate praesentium consectetur aspernatur.
                            items:
                                - x: Magnam assumenda cupiditate praesentium consectetur aspernatur.
                                - x: Magnam assumenda cupiditate praesentium consectetur aspernatur.
                                - x: Magnam assumenda cupiditate praesentium consectetur aspernatur.
                            name: Nam ipsum.
            responses:
                "200":
                    description: OK response.
                    headers:
                        h:
                            schema:
                                type: string
                                example: Odio aut perspiciatis.
                            example: Odio aut perspiciatis.
                    content:
                        application/json:
                            schema:
                                example:
                                    item:
                                        x: Ea dolor sint aut.
                                    items:
                                        - x: Ea dolor sint aut.
                                        - x: Ea dolor sint aut.
                                        - x: Ea dolor sint aut.
                                    name: Neque voluptates et reiciendis alias.
                                $ref: '#/components/schemas/InlineBodyseveralResponseBody'
                            example:
                                item:
                                    x: Ea dolor sint aut.
                                items:
                                    - x: Ea dolor sint aut.
                                    - x: Ea dolor sint aut.
                                    - x: Ea dolor sint aut.
                                name: Neque voluptates et reiciendis alias.
    /single:
        post:
            tags:
                - InlineBody
            summary: single InlineBody
            operationId: inline_body.single
            parameters:
                - name: q
                  in: query
                  allowEmptyValue: true
                  schema:
                    type: string
                  example: Odio vel et facilis ratione iste.
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            properties:
                                item:
                                    $ref: '#/components/schemas/Item'
                            example:
                                item:
                                    x: Ipsa quia.
                        example:
                            item:
                                x: Aperiam eveniet sint et voluptatibus expedita.
            responses:
                "200":
                    description: OK response.
                    headers:
                        h:
                            schema:
                                type: string
                                example: Necessitatibus id velit dicta quos.
                            example: Necessitatibus id velit dicta quos.
                    content:
                        application/json:
                            schema:
                                example:
                                    item:
                                        x: Numquam quibusdam ipsa quo.
                                $ref: '#/components/schemas/InlineBodysingleResponseBody'
                            example:
                                item:
                                    x: Numquam quibusdam ipsa quo.
components:
    schemas:
        InlineBodyinlineAttributeResponseBody:
            type: object
            properties:
                "y":
                    type: string
                    example: Id consequatur vel sit ut voluptas.
            example:
                "y": Recusandae deleniti.
        InlineBodyprimitiveResponseBody:
            type: object
            properties:
                name:
                    type: string
                    example: Fugit omnis ut saepe.
            example:
                name: Commodi nulla fugiat consequatur et.
        InlineBodyrequiredResponseBody:
            type: object
            properties:
                item:
                    $ref: '#/components/schemas/Item'
            example:
                item:
                    x: Minima soluta illum voluptatem at.
            required:
                - item
        InlineBodyseveralResponseBody:
            type: object
            properties:
                item:
                    $ref: '#/components/schemas/Item'
                items:
                    type: array
                    items:
                        $ref: '#/components/schemas/Item'
                    example:
                        - x: A vel ullam vitae possimus.
                        - x: A vel ullam vitae possimus.
                        - x: A vel ullam vitae possimus.
                name:
                    type: string
                    example: Veritatis fuga.
            example:
                item:
                    x: Adipisci nobis.
                items:
                    - x: Adipisci nobis.
                    - x: Adipisci nobis.
                name: Rem incidunt in.
            required:
                - name
        InlineBodysingleResponseBody:
            type: object
            properties:
                item:
                    $ref: '#/components/schemas/Item'
            example:
                item:
                    x: Quia sit dolores odio minima reprehenderit.
        Item:
            type: object
            properties:
                x:
                    type: string
                    example: Dignissimos vero beatae quis.
            example:
                x: Atque dolor debitis.
tags:
    - name: InlineBody
