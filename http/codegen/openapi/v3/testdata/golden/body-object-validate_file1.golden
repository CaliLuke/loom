openapi: 3.2.0
info:
    title: Loom API
    version: 0.0.1
jsonSchemaDialect: https://spec.openapis.org/oas/3.1/dialect/base
servers:
    - name: test api
      url: http://localhost:80
      description: Default server for test api
paths:
    /:
        post:
            tags:
                - ServiceBodyObjectValidate
            summary: MethodBodyObjectValidate ServiceBodyObjectValidate
            operationId: service_body_object_validate.method_body_object_validate
            requestBody:
                required: true
                content:
                    application/json:
                        schema:
                            type: object
                            properties:
                                b:
                                    type: string
                                    example: pattern
                                    pattern: pattern
                            example:
                                b: pattern
                        example:
                            b: pattern
            responses:
                "204":
                    description: No Content response.
components: {}
tags:
    - name: ServiceBodyObjectValidate
