// NewClient instantiates HTTP clients for all the ServiceMultiEndpoints
// service servers.
func NewClient(scheme string, host string, doer loomhttp.Doer, enc func(*http.Request) loomhttp.Encoder, dec func(*http.Response) loomhttp.Decoder, restoreBody bool) *Client {
	return &Client{MethodMultiEndpoints1Doer: doer, MethodMultiEndpoints2Doer: doer, RestoreResponseBody: restoreBody, scheme: scheme, host: host, decoder: dec, encoder: enc}
}
