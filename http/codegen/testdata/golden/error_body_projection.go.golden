// EncodeHTMLError returns an encoder for errors returned by the html
// projection endpoint.
func EncodeHTMLError(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder, formatter func(ctx context.Context, err error) loomhttp.StatusCoder) func(context.Context, http.ResponseWriter, error) error {
	encodeError := loomhttp.ErrorEncoder(encoder, formatter)
	return func(ctx context.Context, w http.ResponseWriter, v error) error {
		errorResponse := loom.ResolveErrorResponse(v)
		if errorResponse.Owner == nil {
			return encodeError(ctx, w, v)
		}
		switch errorResponse.Name {
		case "html":
			//nolint:errorlint // Response ownership is already resolved.
			res, ok := errorResponse.Owner.(*projection.HTMLError)
			if !ok {
				return encodeError(ctx, w, v)
			}
			ctx = context.WithValue(ctx, loomhttp.ContentTypeKey, "text/html; charset=utf-8")
			enc := encoder(ctx, w)
			var body any
			if formatter != nil {
				body = formatter(ctx, v)
			} else {
				body = res.Body
			}
			w.Header().Set("X-Kind", res.Kind)
			w.Header().Set("loom-error", res.LoomErrorName())
			w.WriteHeader(http.StatusInternalServerError)
			return enc.Encode(body)
		default:
			return encodeError(ctx, w, v)
		}
	}
}

