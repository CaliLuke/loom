// BuildMethodPathStringRequest instantiates a HTTP request object with method
// and path set to call the "ServicePathString" service "MethodPathString"
// endpoint
func (c *Client) BuildMethodPathStringRequest(ctx context.Context, v any) (*http.Request, error) {
	if parameterError := func() error {
		p, ok := v.(*servicepathstring.MethodPathStringPayload)
		if !ok {
			return loomhttp.ErrInvalidType("ServicePathString", "MethodPathString", "*servicepathstring.MethodPathStringPayload", v)
		}
		if p == nil {
			return fmt.Errorf("%s", "parameter payload is absent")
		}
		{
			parameterValue := loomhttp.ParamValue{Kind: loomhttp.ParamScalar}
			if p.P != nil {
				parameterValue.Present = true
				parameterValue.Text = *p.P
			}
			if _, parameterError := loomhttp.EncodePathParam("p", loomhttp.ParamCodec{Style: loomhttp.ParamSimple, Explode: false}, parameterValue); parameterError != nil {
				return parameterError
			}
		}
		return nil
	}(); parameterError != nil {
		return nil, loomhttp.ErrEncodingError("ServicePathString", "MethodPathString", parameterError)
	}
	var (
		p2 string
	)
	{
		p, ok := v.(*servicepathstring.MethodPathStringPayload)
		if !ok {
			return nil, loomhttp.ErrInvalidType("ServicePathString", "MethodPathString", "*servicepathstring.MethodPathStringPayload", v)
		}
		if p.P != nil {
			p2 = *p.P
		}
	}
	u, err := loomhttp.RequestURL(c.scheme, c.host, MethodPathStringServicePathStringPath(p2))
	if err != nil {
		return nil, loomhttp.ErrInvalidURL("ServicePathString", "MethodPathString", u.String(), err)
	}
	req, err := http.NewRequest("GET", u.String(), nil)
	if err != nil {
		return nil, loomhttp.ErrInvalidURL("ServicePathString", "MethodPathString", u.String(), err)
	}
	if ctx != nil {
		req = req.WithContext(ctx)
	}

	return req, nil
}
