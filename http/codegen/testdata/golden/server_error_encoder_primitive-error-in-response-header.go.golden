// EncodeMethodPrimitiveErrorInResponseHeaderError returns an encoder for
// errors returned by the MethodPrimitiveErrorInResponseHeader
// ServicePrimitiveErrorInResponseHeader endpoint.
func EncodeMethodPrimitiveErrorInResponseHeaderError(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder, formatter func(ctx context.Context, err error) loomhttp.StatusCoder) func(context.Context, http.ResponseWriter, error) error {
	encodeError := loomhttp.ErrorEncoder(encoder, formatter)
	return func(ctx context.Context, w http.ResponseWriter, v error) error {
		errorResponse := loom.ResolveErrorResponse(v)
		if errorResponse.Owner == nil {
			return encodeError(ctx, w, v)
		}
		switch errorResponse.Name {
		case "bad_request":
			//nolint:errorlint // Response ownership is already resolved.
			res, ok := errorResponse.Owner.(serviceprimitiveerrorinresponseheader.BadRequest)
			if !ok {
				return encodeError(ctx, w, v)
			}
			{
				val := res
				string_s := string(val)
				w.Header().Set("String", string_s)
			}
			w.Header().Set("loom-error", res.LoomErrorName())
			w.WriteHeader(http.StatusBadRequest)
			return nil
		case "internal_error":
			//nolint:errorlint // Response ownership is already resolved.
			res, ok := errorResponse.Owner.(serviceprimitiveerrorinresponseheader.InternalError)
			if !ok {
				return encodeError(ctx, w, v)
			}
			{
				val := res
				int_s := strconv.Itoa(int(val))
				w.Header().Set("Int", int_s)
			}
			w.Header().Set("loom-error", res.LoomErrorName())
			w.WriteHeader(http.StatusInternalServerError)
			return nil
		default:
			return encodeError(ctx, w, v)
		}
	}
}
