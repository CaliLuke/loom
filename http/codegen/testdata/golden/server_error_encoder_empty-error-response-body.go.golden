// EncodeMethodEmptyErrorResponseBodyError returns an encoder for errors
// returned by the MethodEmptyErrorResponseBody ServiceEmptyErrorResponseBody
// endpoint.
func EncodeMethodEmptyErrorResponseBodyError(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder, formatter func(ctx context.Context, err error) loomhttp.StatusCoder) func(context.Context, http.ResponseWriter, error) error {
	encodeError := loomhttp.ErrorEncoder(encoder, formatter)
	return func(ctx context.Context, w http.ResponseWriter, v error) error {
		errorResponse := loom.ResolveErrorResponse(v)
		if errorResponse.Owner == nil {
			return encodeError(ctx, w, v)
		}
		switch errorResponse.Name {
		case "internal_error":
			//nolint:errorlint // Response ownership is already resolved.
			res, ok := errorResponse.Owner.(*loom.ServiceError)
			if !ok {
				return encodeError(ctx, w, v)
			}
			problem := loomhttp.NewProblemResponse(ctx, v, 500, "", "")
			w.Header().Set("Error-Code", problem.Code)
			w.Header().Set("Loom-Attribute-Type", problem.Type)
			w.Header().Set("Loom-Attribute-Title", problem.Title)
			{
				val := problem.Status
				statuss := strconv.Itoa(val)
				w.Header().Set("Loom-Attribute-Status", statuss)
			}
			w.Header().Set("Loom-Attribute-Detail", problem.Detail)
			w.Header().Set("Loom-Attribute-Instance", problem.Instance)
			{
				val := problem.Timeout
				timeouts := strconv.FormatBool(val)
				w.Header().Set("Loom-Attribute-Timeout", timeouts)
			}
			{
				val := problem.Temporary
				temporarys := strconv.FormatBool(val)
				w.Header().Set("Loom-Attribute-Temporary", temporarys)
			}
			{
				val := problem.Fault
				faults := strconv.FormatBool(val)
				w.Header().Set("Loom-Attribute-Fault", faults)
			}
			if problem.RetryHint != nil {
				w.Header().Set("Loom-Attribute-Retry_hint", *problem.RetryHint)
			}
			w.Header().Set("loom-error", res.LoomErrorName())
			w.WriteHeader(http.StatusInternalServerError)
			return nil
		case "not_found":
			//nolint:errorlint // Response ownership is already resolved.
			res, ok := errorResponse.Owner.(serviceemptyerrorresponsebody.NotFound)
			if !ok {
				return encodeError(ctx, w, v)
			}
			{
				val := res
				inHeaders := string(val)
				w.Header().Set("In-Header", inHeaders)
			}
			w.Header().Set("loom-error", res.LoomErrorName())
			w.WriteHeader(http.StatusNotFound)
			return nil
		default:
			return encodeError(ctx, w, v)
		}
	}
}
