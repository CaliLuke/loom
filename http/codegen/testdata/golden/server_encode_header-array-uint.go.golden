// EncodeMethodHeaderArrayUIntResponse returns an encoder for responses
// returned by the ServiceHeaderArrayUInt MethodHeaderArrayUInt endpoint.
func EncodeMethodHeaderArrayUIntResponse(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, ok := v.(*serviceheaderarrayuint.MethodHeaderArrayUIntResult)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceHeaderArrayUInt", "MethodHeaderArrayUInt", "*serviceheaderarrayuint.MethodHeaderArrayUIntResult", v)
		}
		if res.H != nil {
			val := res.H
			var hs []string
			if val != nil {
				hs = make([]string, len(val))
				for i, e := range val {
					hs[i] = strconv.FormatUint(uint64(e), 10)
				}
			}
			if err := loomhttp.SetHeaderValues(w.Header(), "H", hs); err != nil {
				return err
			}
		}
		w.WriteHeader(http.StatusOK)
		return nil
	}
}
