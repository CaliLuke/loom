// DecodeMethodQueryPrimitiveBoolValidateRequest returns a decoder for requests
// sent to the ServiceQueryPrimitiveBoolValidate
// MethodQueryPrimitiveBoolValidate endpoint.
func DecodeMethodQueryPrimitiveBoolValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (bool, error) {
	return func(r *http.Request) (bool, error) {
		var payload bool
		var (
			q   bool
			err error
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp.Get("q")
			if qRaw == "" {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
			v, err2 := strconv.ParseBool(qRaw)
			if err2 != nil {
				err = loom.MergeErrors(err, loom.InvalidFieldTypeError("q", qRaw, "boolean"))
			}
			q = v
		}
		if !(q == true) {
			err = loom.MergeErrors(err, loom.InvalidEnumValueError("q", q, []any{true}))
		}
		if err != nil {
			return payload, err
		}
		payload = q

		return payload, nil
	}
}
