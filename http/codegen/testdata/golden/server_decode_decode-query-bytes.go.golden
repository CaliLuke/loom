// DecodeMethodQueryBytesRequest returns a decoder for requests sent to the
// ServiceQueryBytes MethodQueryBytes endpoint.
func DecodeMethodQueryBytesRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerybytes.MethodQueryBytesPayload, error) {
	return func(r *http.Request) (*servicequerybytes.MethodQueryBytesPayload, error) {
		var payload *servicequerybytes.MethodQueryBytesPayload
		var (
			q []byte
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp.Get("q")
			if qRaw != "" {
				q = []byte(qRaw)
			}
		}
		payload = NewMethodQueryBytesPayload(q)

		return payload, nil
	}
}
