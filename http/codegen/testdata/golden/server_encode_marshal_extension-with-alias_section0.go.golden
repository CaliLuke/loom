// unmarshalExtensionRequestBodyToFooserviceExtension builds a value of type
// *fooservice.Extension from a value of type *ExtensionRequestBody.
func unmarshalExtensionRequestBodyToFooserviceExtension(v *ExtensionRequestBody) *fooservice.Extension {
	if v == nil {
		return nil
	}
	res := &fooservice.Extension{}
	if actual, ok := v.Bar.Value(); ok {
		resBarValue := unmarshalBarRequestBodyToFooserviceBar(&actual)

		res.Bar = resBarValue
	}

	return res
}
