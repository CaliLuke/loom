// NewClient instantiates HTTP clients for all the LargeTypes service servers.
func NewClient(scheme string, host string, doer loomhttp.Doer, enc func(*http.Request) loomhttp.Encoder, dec func(*http.Response) loomhttp.Decoder, restoreBody bool) *Client {
	client := &Client{Method0Doer: doer, Method1Doer: doer, Method2Doer: doer, Method3Doer: doer, Method4Doer: doer, Method5Doer: doer, Method6Doer: doer, Method7Doer: doer, Method8Doer: doer, Method9Doer: doer, RestoreResponseBody: restoreBody, scheme: scheme, host: host, decoder: dec, encoder: enc}
	client.Items = &ItemsClient{client: client}
	return client
}
