type commandLine struct {
	SkipRequestBodyEncodeDecode struct {
		SkipRequestBodyEncodeDecodeMethod struct {
			Stream string `help:"path to file containing the streamed request body" name:"stream" required:""`
		} `cmd:"" help:"SkipRequestBodyEncodeDecodeMethod implements SkipRequestBodyEncodeDecodeMethod." name:"skip-request-body-encode-decode-method"`
	} `cmd:"" help:"Service is the SkipRequestBodyEncodeDecode service interface." name:"skip-request-body-encode-decode"`
}

// ParseEndpoint returns the endpoint and payload as specified on the command
// line.
func ParseEndpoint(scheme string, host string, doer loomhttp.Doer, enc func(*http.Request) loomhttp.Encoder, dec func(*http.Response) loomhttp.Decoder, restore bool) (loom.Endpoint, any, error) {
	var (
		command                                                                commandLine
		args                                                                   []string
		svcn                                                                   string
		epn                                                                    string
		skipRequestBodyEncodeDecodeSkipRequestBodyEncodeDecodeMethodStreamFlag *string
	)
	{
		args = flag.Args()
		if len(args) == 0 {
			args = os.Args[1:]
		}
		path, err := loomhttpcli.Parse(&command, os.Args[0], args)
		if err != nil {
			return nil, nil, fmt.Errorf("parse command: %w", err)
		}
		skipRequestBodyEncodeDecodeSkipRequestBodyEncodeDecodeMethodStreamFlag = &command.SkipRequestBodyEncodeDecode.SkipRequestBodyEncodeDecodeMethod.Stream
		switch path {
		case "skip-request-body-encode-decode skip-request-body-encode-decode-method":
			svcn = "skip-request-body-encode-decode"
			epn = "skip-request-body-encode-decode-method"
		}
	}

	var (
		data     any
		endpoint loom.Endpoint
		err      error
	)
	{
		switch svcn {
		case "skip-request-body-encode-decode":
			c := skiprequestbodyencodedecodec.NewClient(scheme, host, doer, enc, dec, restore)
			switch epn {
			case "skip-request-body-encode-decode-method":
				endpoint = c.SkipRequestBodyEncodeDecodeMethod()
				data, err = skiprequestbodyencodedecodec.BuildSkipRequestBodyEncodeDecodeMethodStreamPayload(*skipRequestBodyEncodeDecodeSkipRequestBodyEncodeDecodeMethodStreamFlag)
			}
		}
	}
	if err != nil {
		return nil, nil, err
	}
	return endpoint, data, nil
}
