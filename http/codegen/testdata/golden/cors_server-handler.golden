// MountListHandler configures the mux to serve the "ServiceCORS" service
// "List" endpoint.
func MountListHandler(mux loomhttp.Muxer, h http.Handler) {
	h = loomhttp.CORSHandler(loomhttp.CORSPolicy{Origins: []loomhttp.CORSOrigin{{Pattern: "https://app.example.com", Methods: []string{"GET", "POST"}, Headers: []string{"Authorization", "Content-Type"}, Expose: []string{"X-Request-Id"}, MaxAge: 600, Credentials: true}}}, loomhttp.AsHandlerFunc(h))
	loomhttp.MountHandler(mux, "GET", "/items", h)
}
