// MountListHandler configures the mux to serve the "ServiceCORS" service
// "List" endpoint.
func MountListHandler(mux loomhttp.Muxer, h http.Handler) {
	f, ok := h.(http.HandlerFunc)
	if !ok {
		f = func(w http.ResponseWriter, r *http.Request) {
			h.ServeHTTP(w, r)
		}
	}
	f = loomhttp.CORSHandler(loomhttp.CORSPolicy{Origins: []loomhttp.CORSOrigin{{Pattern: "https://app.example.com", Methods: []string{"GET", "POST"}, Headers: []string{"Authorization", "Content-Type"}, Expose: []string{"X-Request-Id"}, MaxAge: 600, Credentials: true}}}, f)
	mux.Handle("GET", "/items", f)
}
