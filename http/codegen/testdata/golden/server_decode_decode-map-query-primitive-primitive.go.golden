// DecodeMapQueryPrimitivePrimitiveRequest returns a decoder for requests sent
// to the ServiceMapQueryPrimitivePrimitive MapQueryPrimitivePrimitive endpoint.
func DecodeMapQueryPrimitivePrimitiveRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (map[string]string, error) {
	return func(r *http.Request) (map[string]string, error) {
		var payload map[string]string
		var err error
		var (
			query map[string]string
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			queryRaw := qp
			if len(queryRaw) == 0 {
				err = loom.MergeErrors(err, loom.MissingFieldError("query", "query string"))
			}
			if query == nil {
				query = make(map[string]string)
			}
			for keyRaw, valRaw := range queryRaw {
				var key string
				var keyErr error
				key = keyRaw
				if keyErr != nil {
					continue
				}
				query[key] = valRaw[0]
			}
		}
		if err != nil {
			return payload, err
		}
		payload = query

		return payload, nil
	}
}
