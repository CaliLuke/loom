// DecodeMethodQueryCustomTextUnmarshalerRequest returns a decoder for requests
// sent to the ServiceQueryCustomTextUnmarshaler
// MethodQueryCustomTextUnmarshaler endpoint.
func DecodeMethodQueryCustomTextUnmarshalerRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerycustomtextunmarshaler.MethodQueryCustomTextUnmarshalerPayload, error) {
	return func(r *http.Request) (*servicequerycustomtextunmarshaler.MethodQueryCustomTextUnmarshalerPayload, error) {
		var payload *servicequerycustomtextunmarshaler.MethodQueryCustomTextUnmarshalerPayload
		var (
			id  uuid.UUID
			err error
		)
		idRaw := r.URL.Query().Get("id")
		if idRaw == "" {
			err = loom.MergeErrors(err, loom.MissingFieldError("id", "query string"))
		}
		if err2 := id.UnmarshalText([]byte(idRaw)); err2 != nil {
			err = loom.MergeErrors(err, loom.InvalidFieldTypeError("id", idRaw, "uuid.UUID"))
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodQueryCustomTextUnmarshalerPayload(id)

		return payload, nil
	}
}
