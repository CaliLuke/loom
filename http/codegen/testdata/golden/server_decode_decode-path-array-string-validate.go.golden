func DecodeMethodPathArrayStringValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicepatharraystringvalidate.MethodPathArrayStringValidatePayload, error) {
