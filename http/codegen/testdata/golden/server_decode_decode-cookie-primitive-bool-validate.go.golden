// DecodeMethodCookiePrimitiveBoolValidateRequest returns a decoder for
// requests sent to the ServiceCookiePrimitiveBoolValidate
// MethodCookiePrimitiveBoolValidate endpoint.
func DecodeMethodCookiePrimitiveBoolValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (bool, error) {
	return func(r *http.Request) (bool, error) {
		var payload bool
		var err error
		var (
			c2 bool
		)
		{
			c, cookieErr := r.Cookie("c")
			if cookieErr != nil && !errors.Is(cookieErr, http.ErrNoCookie) {
				return payload, cookieErr
			}
			var c2Raw string
			c2Present := c != nil
			if c2Present {
				c2Raw = c.Value
			}

			if c2Present {
				v, err2 := strconv.ParseBool(c2Raw)
				if err2 != nil {
					err = loom.MergeErrors(err, loom.InvalidFieldTypeError("c", c2Raw, "boolean"))
				}
				c2 = v
				if !(c2 == true) {
					err = loom.MergeErrors(err, loom.InvalidEnumValueError("c", c2, []any{true}))
				}
			} else {
				err = loom.MergeErrors(err, loom.MissingFieldError("c", "cookie"))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = c2

		return payload, nil
	}
}
