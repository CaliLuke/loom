// NewMethodPayloadResultHandler creates a HTTP handler which loads the HTTP
// request and calls the "ServicePayloadResult" service "MethodPayloadResult"
// endpoint.
func NewMethodPayloadResultHandler(
	endpoint loom.Endpoint,
	mux loomhttp.Muxer,
	decoder func(*http.Request) loomhttp.Decoder,
	encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder,
	errhandler func(context.Context, http.ResponseWriter, error),
	formatter func(ctx context.Context, err error) loomhttp.Statuser,
) http.Handler {
	var (
		decodeRequest  = DecodeMethodPayloadResultRequest(mux, decoder)
		encodeResponse = EncodeMethodPayloadResultResponse(encoder)
		encodeError    = loomhttp.ErrorEncoder(encoder, formatter)
	)
	return loomhttp.NewUnaryHandler(loomhttp.UnaryHandlerSpec[*servicepayloadresult.MethodPayloadResultPayload, loomhttp.UnaryResult[*servicepayloadresult.MethodPayloadResultResult]]{
		Service: "ServicePayloadResult",
		Method:  "MethodPayloadResult",
		Decode:  decodeRequest,
		Invoke: func(ctx context.Context, payload *servicepayloadresult.MethodPayloadResultPayload) (loomhttp.UnaryResult[*servicepayloadresult.MethodPayloadResultResult], error) {
			res, err := endpoint(ctx, payload)
			if err != nil {
				var zero loomhttp.UnaryResult[*servicepayloadresult.MethodPayloadResultResult]
				return zero, err
			}
			return loomhttp.UnaryResult[*servicepayloadresult.MethodPayloadResultResult]{Value: res}, nil
		},
		EncodeResponse: func(ctx context.Context, w http.ResponseWriter, result loomhttp.UnaryResult[*servicepayloadresult.MethodPayloadResultResult]) error {
			return encodeResponse(ctx, w, result.Value)
		},
		EncodeError:   encodeError,
		HandleFailure: errhandler,
	})
}
