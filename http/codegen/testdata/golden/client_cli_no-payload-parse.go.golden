type commandLine struct {
	ServiceMultiNoPayload1 struct {
		MethodServiceNoPayload11 struct{} `cmd:"" help:"MethodServiceNoPayload11 implements MethodServiceNoPayload11." name:"method-service-no-payload11"`
		MethodServiceNoPayload12 struct{} `cmd:"" help:"MethodServiceNoPayload12 implements MethodServiceNoPayload12." name:"method-service-no-payload12"`
	} `cmd:"" help:"Service is the ServiceMultiNoPayload1 service interface." name:"service-multi-no-payload1"`
	ServiceMultiNoPayload2 struct {
		MethodServiceNoPayload21 struct{} `cmd:"" help:"MethodServiceNoPayload21 implements MethodServiceNoPayload21." name:"method-service-no-payload21"`
		MethodServiceNoPayload22 struct{} `cmd:"" help:"MethodServiceNoPayload22 implements MethodServiceNoPayload22." name:"method-service-no-payload22"`
	} `cmd:"" help:"Service is the ServiceMultiNoPayload2 service interface." name:"service-multi-no-payload2"`
}

// ParseEndpoint returns the endpoint and payload as specified on the command
// line.
func ParseEndpoint(scheme string, host string, doer loomhttp.Doer, enc func(*http.Request) loomhttp.Encoder, dec func(*http.Response) loomhttp.Decoder, restore bool) (loom.Endpoint, any, error) {
	var (
		command commandLine
		args    []string
		svcn    string
		epn     string
	)
	{
		args = flag.Args()
		if len(args) == 0 {
			args = os.Args[1:]
		}
		path, err := loomhttpcli.Parse(&command, os.Args[0], args)
		if err != nil {
			return nil, nil, err
		}
		switch path {
		case "service-multi-no-payload1 method-service-no-payload11":
			svcn = "service-multi-no-payload1"
			epn = "method-service-no-payload11"
		case "service-multi-no-payload1 method-service-no-payload12":
			svcn = "service-multi-no-payload1"
			epn = "method-service-no-payload12"
		case "service-multi-no-payload2 method-service-no-payload21":
			svcn = "service-multi-no-payload2"
			epn = "method-service-no-payload21"
		case "service-multi-no-payload2 method-service-no-payload22":
			svcn = "service-multi-no-payload2"
			epn = "method-service-no-payload22"
		}
	}

	var (
		data     any
		endpoint loom.Endpoint
		err      error
	)
	{
		switch svcn {
		case "service-multi-no-payload1":
			c := servicemultinopayload1c.NewClient(scheme, host, doer, enc, dec, restore)
			switch epn {
			case "method-service-no-payload11":
				endpoint = c.MethodServiceNoPayload11()
			case "method-service-no-payload12":
				endpoint = c.MethodServiceNoPayload12()
			}
		case "service-multi-no-payload2":
			c := servicemultinopayload2c.NewClient(scheme, host, doer, enc, dec, restore)
			switch epn {
			case "method-service-no-payload21":
				endpoint = c.MethodServiceNoPayload21()
			case "method-service-no-payload22":
				endpoint = c.MethodServiceNoPayload22()
			}
		}
	}
	if err != nil {
		return nil, nil, err
	}
	return endpoint, data, nil
}
