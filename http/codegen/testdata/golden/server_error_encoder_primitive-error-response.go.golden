// EncodeMethodPrimitiveErrorResponseError returns an encoder for errors
// returned by the MethodPrimitiveErrorResponse ServicePrimitiveErrorResponse
// endpoint.
func EncodeMethodPrimitiveErrorResponseError(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder, formatter func(ctx context.Context, err error) loomhttp.StatusCoder) func(context.Context, http.ResponseWriter, error) error {
	encodeError := loomhttp.ErrorEncoder(encoder, formatter)
	return func(ctx context.Context, w http.ResponseWriter, v error) error {
		errorResponse := loom.ResolveErrorResponse(v)
		if errorResponse.Owner == nil {
			return encodeError(ctx, w, v)
		}
		switch errorResponse.Name {
		case "bad_request":
			//nolint:errorlint // Response ownership is already resolved.
			res, ok := errorResponse.Owner.(serviceprimitiveerrorresponse.BadRequest)
			if !ok {
				return encodeError(ctx, w, v)
			}
			enc := encoder(ctx, w)
			var body any
			if formatter != nil {
				body = formatter(ctx, v)
			} else {
				body = res
			}
			w.Header().Set("loom-error", res.LoomErrorName())
			w.WriteHeader(http.StatusBadRequest)
			return enc.Encode(body)
		case "internal_error":
			//nolint:errorlint // Response ownership is already resolved.
			res, ok := errorResponse.Owner.(serviceprimitiveerrorresponse.InternalError)
			if !ok {
				return encodeError(ctx, w, v)
			}
			enc := encoder(ctx, w)
			var body any
			if formatter != nil {
				body = formatter(ctx, v)
			} else {
				body = res
			}
			w.Header().Set("loom-error", res.LoomErrorName())
			w.WriteHeader(http.StatusInternalServerError)
			return enc.Encode(body)
		default:
			return encodeError(ctx, w, v)
		}
	}
}
