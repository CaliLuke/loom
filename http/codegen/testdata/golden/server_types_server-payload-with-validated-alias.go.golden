import "regexp"

// MethodStreamingBody is the type of the "ServicePayloadValidatedAlias"
// service "Method" endpoint HTTP request body.
type MethodStreamingBody struct {
	Name loom.Optional[ValidatedStringStreamingBody] `form:"name,omitempty" json:"name,omitzero" xml:"name,omitempty"`
}

// ValidatedStringStreamingBody is used to define fields on request body types.
type ValidatedStringStreamingBody string

// NewMethodStreamingBody builds a ServicePayloadValidatedAlias service Method
// endpoint payload.
func NewMethodStreamingBody(body *MethodStreamingBody) *servicepayloadvalidatedalias.MethodStreamingPayload {
	v := &servicepayloadvalidatedalias.MethodStreamingPayload{}
	if actual, ok := body.Name.Value(); ok {
		vNameValue := servicepayloadvalidatedalias.ValidatedString(actual)

		v.Name = &vNameValue
	}

	return v
}

// ValidateMethodStreamingBody runs the validations defined on
// MethodStreamingBody
func ValidateMethodStreamingBody(body *MethodStreamingBody) (err error) {
	if actual, ok := body.Name.Value(); ok {
		err = loom.MergeErrors(err, loom.ValidatePatternCompiled("body.name", actual, loomPatternTest0))
		if len(actual) < 10 {
			err = loom.MergeErrors(err, loom.InvalidLengthError("body.name", actual, len(actual), 10, true))
		}
	}
	return
}

var loomPatternTest0 = regexp.MustCompile("^[a-zA-Z]+$")
