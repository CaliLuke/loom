// DecodeMethodQueryPrimitiveMapBoolArrayBoolValidateRequest returns a decoder
// for requests sent to the ServiceQueryPrimitiveMapBoolArrayBoolValidate
// MethodQueryPrimitiveMapBoolArrayBoolValidate endpoint.
func DecodeMethodQueryPrimitiveMapBoolArrayBoolValidateRequest(mux loomhttp.Muxer, decoder func(*http.Request) loomhttp.Decoder) func(*http.Request) (map[bool][]bool, error) {
	return func(r *http.Request) (map[bool][]bool, error) {
		var payload map[bool][]bool
		var (
			q   map[bool][]bool
			err error
		)
		{
			qRaw := r.URL.Query()
			qHasValues := false
			for keyRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					qHasValues = true
					break
				}
			}
			if !qHasValues {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
			for keyRaw, valRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					if q == nil {
						q = make(map[bool][]bool)
					}
					var keya bool
					var keyaErr error
					{
						openIdx := strings.IndexRune(keyRaw, '[')
						closeIdx := strings.IndexRune(keyRaw, ']')
						if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
							keyaErr = loom.DecodePayloadError("invalid query string: malformed brackets")
							err = loom.MergeErrors(err, keyaErr)
						} else {
							keyaRaw := keyRaw[openIdx+1 : closeIdx]
							v, err2 := strconv.ParseBool(keyaRaw)
							if err2 != nil {
								keyaErr = loom.InvalidFieldTypeError("query", keyaRaw, "boolean")
								err = loom.MergeErrors(err, keyaErr)
							}
							keya = bool(v)
						}
					}
					if keyaErr != nil {
						continue
					}
					var val []bool
					{
						val = make([]bool, len(valRaw))
						for i, rv := range valRaw {
							v, err2 := strconv.ParseBool(rv)
							if err2 != nil {
								err = loom.MergeErrors(err, loom.InvalidFieldTypeError("query", valRaw, "array of booleans"))
							}
							val[i] = v
						}
					}
					q[keya] = val
				}
			}
		}
		if len(q) < 1 {
			err = loom.MergeErrors(err, loom.InvalidLengthError("q", q, len(q), 1, true))
		}
		for k, v := range q {
			if !(k == true) {
				err = loom.MergeErrors(err, loom.InvalidEnumValueError("q.key", k, []any{true}))
			}
			if len(v) < 2 {
				err = loom.MergeErrors(err, loom.InvalidLengthError("q[key]", v, len(v), 2, true))
			}
			for _, e := range v {
				if !(e == false) {
					err = loom.MergeErrors(err, loom.InvalidEnumValueError("q[key][*]", e, []any{false}))
				}
			}
		}
		if err != nil {
			return payload, err
		}
		payload = q

		return payload, nil
	}
}
