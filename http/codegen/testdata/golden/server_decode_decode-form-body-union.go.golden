// DecodeMethodFormBodyUnionRequest returns a decoder for requests sent to the
// ServiceFormBodyUnion MethodFormBodyUnion endpoint.
func DecodeMethodFormBodyUnionRequest(mux loomhttp.Muxer, decoder func(*http.Request) loomhttp.Decoder) func(*http.Request) (*serviceformbodyunion.FormGrant, error) {
	return func(r *http.Request) (*serviceformbodyunion.FormGrant, error) {
		var payload *serviceformbodyunion.FormGrant
		var (
			body MethodFormBodyUnionRequestBody
			err  error
		)
		if err = r.ParseForm(); err != nil {
			return payload, loom.DecodePayloadError(err.Error())
		}
		if len(r.PostForm) == 0 {
			return payload, loom.MissingPayloadError()
		} else {
			if _, err = loomhttp.DecodeFormValue(r.PostForm, "", &body); err != nil {
				var gerr *loom.ServiceError
				if errors.As(err, &gerr) {
					return payload, gerr
				}
				return payload, loom.DecodePayloadError(err.Error())
			}
		}
		err = ValidateMethodFormBodyUnionRequestBody(&body)
		if err != nil {
			return payload, err
		}
		payload = NewMethodFormBodyUnionFormGrant(&body)

		return payload, nil
	}
}
