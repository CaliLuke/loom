	RetryHint loom.Optional[string] `form:"retry_hint,omitempty" json:"retry_hint,omitzero" xml:"retry_hint,omitempty"`
}

// NewListStreamingBody builds the HTTP request body from the payload of the
// "list" endpoint of the "ServiceB" service.
func NewListStreamingBody(p *serviceb.ListStreamingPayload) *ListStreamingBody {
	body := &ListStreamingBody{
		Name: p.Name,
	}
	return body
}

// NewListResultOK builds a "ServiceB" service "list" endpoint result from a
// HTTP "OK" response.
func NewListResultOK(body *ListResponseBody) *serviceb.ListResult {
	v := &serviceb.ListResult{
		ID:   *body.ID,
		Name: *body.Name,
	}

	return v
}

// NewListSomethingWentWrong builds a ServiceB service list endpoint
// something_went_wrong error.
func NewListSomethingWentWrong(body *ListSomethingWentWrongResponseBody) *loom.ServiceError {
	problem := &loomhttp.ProblemResponse{
		Type:      *body.Type,
		Title:     *body.Title,
		Status:    *body.Status,
		Detail:    *body.Detail,
		Instance:  *body.Instance,
		Code:      *body.Code,
		Timeout:   *body.Timeout,
		Temporary: *body.Temporary,
		Fault:     *body.Fault,
	}
	if actual, ok := body.RetryHint.Value(); ok {
		problemRetryHintValue := actual

		problem.RetryHint = &problemRetryHintValue
	}
	v := loomhttp.ProblemErrorFromBody(*problem)

	return v
}

