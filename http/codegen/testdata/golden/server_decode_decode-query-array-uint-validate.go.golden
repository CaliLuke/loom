func DecodeMethodQueryArrayUIntValidateRequest(mux loomhttp.Muxer, decoder func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequeryarrayuintvalidate.MethodQueryArrayUIntValidatePayload, error) {
	return func(r *http.Request) (*servicequeryarrayuintvalidate.MethodQueryArrayUIntValidatePayload, error) {
