// EncodeMethodCookiePrimitiveStringValidateRequest returns an encoder for
// requests sent to the ServiceCookiePrimitiveStringValidate
// MethodCookiePrimitiveStringValidate server.
func EncodeMethodCookiePrimitiveStringValidateRequest(encoder func(*http.Request) loomhttp.Encoder) func(*http.Request, any) error {
	return func(req *http.Request, v any) error {
		p, ok := v.(string)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceCookiePrimitiveStringValidate", "MethodCookiePrimitiveStringValidate", "string", v)
		}
		{
			v := p
			if err := loomhttp.AddRequestCookie(req, "c", v); err != nil {
				return loomhttp.ErrEncodingError("ServiceCookiePrimitiveStringValidate", "MethodCookiePrimitiveStringValidate", err)
			}
		}
		return nil
	}
}
