// DecodeMethodARequest returns a decoder for requests sent to the
// ServiceQueryMapAlias MethodA endpoint.
func DecodeMethodARequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerymapalias.MethodAPayload, error) {
	return func(r *http.Request) (*servicequerymapalias.MethodAPayload, error) {
		var payload *servicequerymapalias.MethodAPayload
		var err error
		var (
			map_ servicequerymapalias.MapAlias
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			var decoded map[float32]loom.Optional[bool]
			present, decodeErr := loomhttp.DecodeJSONField(qp, "map", &decoded, false, loomhttp.FieldValue)
			if decodeErr != nil {
				return payload, loom.DecodePayloadError(loomhttp.SafeDecodePayloadMessage(decodeErr))
			}
			if present {
				for _, v := range decoded {
					if _, ok := v.Value(); !ok {
						err = loom.MergeErrors(err, loom.InvalidNullMapValueError("map[key]"))
					}
				}
				if err != nil {
					return payload, err
				}
				if decoded != nil {
					map_ = make(map[float32]bool, len(decoded))
					for key, val := range decoded {
						tk := key
						actual, ok := val.Value()
						if !ok {
							var mapMissingValue bool
							map_[tk] = mapMissingValue
							continue
						}
						tv := actual
						map_[tk] = tv
					}
				} else {
					map_ = nil
				}
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodAPayload(map_)

		return payload, nil
	}
}
