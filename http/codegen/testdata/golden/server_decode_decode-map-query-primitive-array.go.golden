// DecodeMapQueryPrimitiveArrayRequest returns a decoder for requests sent to
// the ServiceMapQueryPrimitiveArray MapQueryPrimitiveArray endpoint.
func DecodeMapQueryPrimitiveArrayRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (map[string][]uint, error) {
	return func(r *http.Request) (map[string][]uint, error) {
		var payload map[string][]uint
		var err error
		var (
			query map[string][]uint
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			queryRaw := qp
			if len(queryRaw) == 0 {
				err = loom.MergeErrors(err, loom.MissingFieldError("query", "query string"))
			}
			if query == nil {
				query = make(map[string][]uint)
			}
			for keyRaw, valRaw := range queryRaw {
				var key string
				var keyErr error
				key = keyRaw
				if keyErr != nil {
					continue
				}
				var val []uint
				{
					val = make([]uint, len(valRaw))
					for i, rv := range valRaw {
						v, err2 := strconv.ParseUint(rv, 10, strconv.IntSize)
						if err2 != nil {
							err = loom.MergeErrors(err, loom.InvalidFieldTypeError("query", valRaw, "array of unsigned integers"))
						}
						val[i] = uint(v)
					}
				}
				query[key] = val
			}
		}
		if err != nil {
			return payload, err
		}
		payload = query

		return payload, nil
	}
}
