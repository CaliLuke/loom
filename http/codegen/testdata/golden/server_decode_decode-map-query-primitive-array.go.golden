// DecodeMapQueryPrimitiveArrayRequest returns a decoder for requests sent to
// the ServiceMapQueryPrimitiveArray MapQueryPrimitiveArray endpoint.
func DecodeMapQueryPrimitiveArrayRequest(mux loomhttp.Muxer, decoder func(*http.Request) loomhttp.Decoder) func(*http.Request) (map[string][]uint, error) {
	return func(r *http.Request) (map[string][]uint, error) {
		var payload map[string][]uint
		var (
			query map[string][]uint
			err   error
		)
		{
			queryRaw := r.URL.Query()
			queryHasValues := false
			for keyRaw := range queryRaw {
				if strings.HasPrefix(keyRaw, "query[") {
					queryHasValues = true
					break
				}
			}
			if !queryHasValues {
				err = loom.MergeErrors(err, loom.MissingFieldError("query", "query string"))
			}
			for keyRaw, valRaw := range queryRaw {
				if strings.HasPrefix(keyRaw, "query[") {
					if query == nil {
						query = make(map[string][]uint)
					}
					var keya string
					var keyaErr error
					{
						openIdx := strings.IndexRune(keyRaw, '[')
						closeIdx := strings.IndexRune(keyRaw, ']')
						if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
							keyaErr = loom.DecodePayloadError("invalid query string: malformed brackets")
							err = loom.MergeErrors(err, keyaErr)
						} else {
							keya = keyRaw[openIdx+1 : closeIdx]
						}
					}
					if keyaErr != nil {
						continue
					}
					var val []uint
					{
						val = make([]uint, len(valRaw))
						for i, rv := range valRaw {
							v, err2 := strconv.ParseUint(rv, 10, strconv.IntSize)
							if err2 != nil {
								err = loom.MergeErrors(err, loom.InvalidFieldTypeError("query", valRaw, "array of unsigned integers"))
							}
							val[i] = uint(v)
						}
					}
					query[keya] = val
				}
			}
		}
		if err != nil {
			return payload, err
		}
		payload = query

		return payload, nil
	}
}
