									keyaErr = loom.InvalidFieldTypeError("query", keyaRaw, "boolean")
									err = loom.MergeErrors(err, keyaErr)
								}
								keya = bool(v)
							}
						}
						if keyaErr != nil {
							continue
						}
						var vala bool
						{
							valaRaw := valRaw[0]
							v, err2 := strconv.ParseBool(valaRaw)
							if err2 != nil {
								err = loom.MergeErrors(err, loom.InvalidFieldTypeError("query", valaRaw, "boolean"))
							}
							vala = v
						}
						q[keya] = vala
					}
				}
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodQueryMapBoolBoolPayload(q)

