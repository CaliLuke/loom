func DecodeMethodQueryMapBoolBoolRequest(mux loomhttp.Muxer, decoder func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerymapboolbool.MethodQueryMapBoolBoolPayload, error) {
	return func(r *http.Request) (*servicequerymapboolbool.MethodQueryMapBoolBoolPayload, error) {
		var payload *servicequerymapboolbool.MethodQueryMapBoolBoolPayload
		var (
			q   map[bool]bool
			err error
		)
		{
			qRaw := r.URL.Query()
			qHasValues := false
			for keyRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					qHasValues = true
					break
				}
			}
			if qHasValues {
				for keyRaw, valRaw := range qRaw {
					if strings.HasPrefix(keyRaw, "q[") {
