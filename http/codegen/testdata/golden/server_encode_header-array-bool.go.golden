// EncodeMethodHeaderArrayBoolResponse returns an encoder for responses
// returned by the ServiceHeaderArrayBool MethodHeaderArrayBool endpoint.
func EncodeMethodHeaderArrayBoolResponse(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, ok := v.(*serviceheaderarraybool.MethodHeaderArrayBoolResult)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceHeaderArrayBool", "MethodHeaderArrayBool", "*serviceheaderarraybool.MethodHeaderArrayBoolResult", v)
		}
		if res.H != nil {
			val := res.H
			var hs []string
			if val != nil {
				hs = make([]string, len(val))
				for i, e := range val {
					hs[i] = strconv.FormatBool(e)
				}
			}
			if err := loomhttp.SetHeaderValues(w.Header(), "H", hs); err != nil {
				return err
			}
		}
		w.WriteHeader(http.StatusOK)
		return nil
	}
}
