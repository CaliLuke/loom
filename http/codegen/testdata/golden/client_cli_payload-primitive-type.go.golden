type commandLine struct {
	ServiceBodyPrimitiveBoolValidate struct {
		MethodBodyPrimitiveBoolValidate struct {
			P string `help:"bool is the payload type of the ServiceBodyPrimitiveBoolValidate service MethodBodyPrimitiveBoolValidate method." name:"p" required:"" short:"p"`
		} `cmd:"" help:"MethodBodyPrimitiveBoolValidate implements MethodBodyPrimitiveBoolValidate." name:"method-body-primitive-bool-validate"`
	} `cmd:"" help:"Service is the ServiceBodyPrimitiveBoolValidate service interface." name:"service-body-primitive-bool-validate"`
}

// ParseEndpoint returns the endpoint and payload as specified on the command
// line.
func ParseEndpoint(scheme string, host string, doer loomhttp.Doer, enc func(*http.Request) loomhttp.Encoder, dec func(*http.Response) loomhttp.Decoder, restore bool) (loom.Endpoint, any, error) {
	var (
		command                                                              commandLine
		args                                                                 []string
		svcn                                                                 string
		epn                                                                  string
		serviceBodyPrimitiveBoolValidateMethodBodyPrimitiveBoolValidatePFlag *string
	)
	{
		args = flag.Args()
		if len(args) == 0 {
			args = os.Args[1:]
		}
		path, err := loomhttpcli.Parse(&command, os.Args[0], args)
		if err != nil {
			return nil, nil, err
		}
		serviceBodyPrimitiveBoolValidateMethodBodyPrimitiveBoolValidatePFlag = &command.ServiceBodyPrimitiveBoolValidate.MethodBodyPrimitiveBoolValidate.P
		switch path {
		case "service-body-primitive-bool-validate method-body-primitive-bool-validate":
			svcn = "service-body-primitive-bool-validate"
			epn = "method-body-primitive-bool-validate"
		}
	}

	var (
		data     any
		endpoint loom.Endpoint
		err      error
	)
	{
		switch svcn {
		case "service-body-primitive-bool-validate":
			c := servicebodyprimitiveboolvalidatec.NewClient(scheme, host, doer, enc, dec, restore)
			switch epn {
			case "method-body-primitive-bool-validate":
				endpoint = c.MethodBodyPrimitiveBoolValidate()
				var err error
				data, err = strconv.ParseBool(*serviceBodyPrimitiveBoolValidateMethodBodyPrimitiveBoolValidatePFlag)
				if err != nil {
					return nil, nil, fmt.Errorf("invalid value for serviceBodyPrimitiveBoolValidateMethodBodyPrimitiveBoolValidatePFlag, must be BOOL")
				}
			}
		}
	}
	if err != nil {
		return nil, nil, err
	}
	return endpoint, data, nil
}
