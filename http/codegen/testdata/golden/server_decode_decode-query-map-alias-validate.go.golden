// DecodeMethodARequest returns a decoder for requests sent to the
// ServiceQueryMapAliasValidate MethodA endpoint.
func DecodeMethodARequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerymapaliasvalidate.MethodAPayload, error) {
	return func(r *http.Request) (*servicequerymapaliasvalidate.MethodAPayload, error) {
		var payload *servicequerymapaliasvalidate.MethodAPayload
		var err error
		var (
			map_ map[float32]bool
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			var decoded map[float32]loom.Optional[bool]
			present, decodeErr := loomhttp.DecodeJSONField(qp, "map", &decoded)
			if decodeErr != nil {
				return payload, loom.DecodePayloadError(loomhttp.SafeDecodePayloadMessage(decodeErr))
			}
			if present {
				if decoded != nil {
					map_ = make(map[float32]bool, len(decoded))
					for key, val := range decoded {
						actual, ok := val.Value()
						if !ok {
							continue
						}
						tk := key
						tv := actual
						map_[tk] = tv
					}
				} else {
					map_ = nil
				}
			}
		}
		if map_ != nil {
			if len(map_) < 5 {
				err = loom.MergeErrors(err, loom.InvalidLengthError("map", len(map_), 5, true))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodAPayload(map_)

		return payload, nil
	}
}
