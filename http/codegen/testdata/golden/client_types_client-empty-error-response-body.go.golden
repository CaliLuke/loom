// NewMethodEmptyErrorResponseBodyInternalError builds a
// ServiceEmptyErrorResponseBody service MethodEmptyErrorResponseBody endpoint
// internal_error error.
func NewMethodEmptyErrorResponseBodyInternalError(code string, type_ string, title string, status int, detail string, instance string, timeout bool, temporary bool, fault bool, retryHint *string) *loom.ServiceError {
	problem := &loomhttp.ProblemResponse{}
	problem.Code = code
	problem.Type = type_
	problem.Title = title
	problem.Status = status
	problem.Detail = detail
	problem.Instance = instance
	problem.Timeout = timeout
	problem.Temporary = temporary
	problem.Fault = fault
	problem.RetryHint = retryHint
	v := loomhttp.ProblemErrorFromBody(*problem)

	return v
}

// NewMethodEmptyErrorResponseBodyNotFound builds a
// ServiceEmptyErrorResponseBody service MethodEmptyErrorResponseBody endpoint
// not_found error.
func NewMethodEmptyErrorResponseBodyNotFound(inHeader string) serviceemptyerrorresponsebody.NotFound {
	v := serviceemptyerrorresponsebody.NotFound(inHeader)

