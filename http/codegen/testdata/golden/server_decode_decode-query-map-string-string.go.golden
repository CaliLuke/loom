// DecodeMethodQueryMapStringStringRequest returns a decoder for requests sent
// to the ServiceQueryMapStringString MethodQueryMapStringString endpoint.
func DecodeMethodQueryMapStringStringRequest(mux loomhttp.Muxer, decoder func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerymapstringstring.MethodQueryMapStringStringPayload, error) {
	return func(r *http.Request) (*servicequerymapstringstring.MethodQueryMapStringStringPayload, error) {
		var payload *servicequerymapstringstring.MethodQueryMapStringStringPayload
		var (
			q   map[string]string
			err error
		)
		{
			qRaw := r.URL.Query()
			qHasValues := false
			for keyRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					qHasValues = true
					break
				}
			}
			if qHasValues {
				for keyRaw, valRaw := range qRaw {
					if strings.HasPrefix(keyRaw, "q[") {
						if q == nil {
							q = make(map[string]string)
						}
						var keya string
						var keyaErr error
						{
							openIdx := strings.IndexRune(keyRaw, '[')
							closeIdx := strings.IndexRune(keyRaw, ']')
							if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
								keyaErr = loom.DecodePayloadError("invalid query string: malformed brackets")
								err = loom.MergeErrors(err, keyaErr)
							} else {
								keya = keyRaw[openIdx+1 : closeIdx]
							}
						}
						if keyaErr != nil {
							continue
						}
						q[keya] = valRaw[0]
					}
				}
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodQueryMapStringStringPayload(q)

		return payload, nil
	}
}
