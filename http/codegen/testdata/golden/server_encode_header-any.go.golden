// EncodeMethodHeaderAnyResponse returns an encoder for responses returned by
// the ServiceHeaderAny MethodHeaderAny endpoint.
func EncodeMethodHeaderAnyResponse(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, ok := v.(*serviceheaderany.MethodHeaderAnyResult)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceHeaderAny", "MethodHeaderAny", "*serviceheaderany.MethodHeaderAnyResult", v)
		}
		if res.H != nil {
			val := res.H
			hs := fmt.Sprintf("%v", val)
			w.Header().Set("H", hs)
		}
		w.WriteHeader(http.StatusOK)
		return nil
	}
}
