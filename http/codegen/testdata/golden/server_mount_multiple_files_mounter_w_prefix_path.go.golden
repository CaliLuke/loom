// MountPathToFolder configures the mux to serve GET request made to
// "/server_file_server/static".
func MountPathToFolder(mux loomhttp.Muxer, h http.Handler) {
	mux.Handle("GET", "/server_file_server/static/", h.ServeHTTP)
	mux.Handle("GET", "/server_file_server/static/{*wildcard}", h.ServeHTTP)
}
