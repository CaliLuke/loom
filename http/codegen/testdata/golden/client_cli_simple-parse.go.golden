type commandLine struct {
	ServiceMultiSimple1 struct {
		MethodMultiSimpleNoPayload struct{} `cmd:"" help:"MethodMultiSimpleNoPayload implements MethodMultiSimpleNoPayload." name:"method-multi-simple-no-payload"`
		MethodMultiSimplePayload   struct {
			Body string `help:"" name:"body" required:""`
		} `cmd:"" help:"MethodMultiSimplePayload implements MethodMultiSimplePayload." name:"method-multi-simple-payload"`
	} `cmd:"" help:"Service is the ServiceMultiSimple1 service interface." name:"service-multi-simple1"`
	ServiceMultiSimple2 struct {
		MethodMultiSimpleNoPayload struct{} `cmd:"" help:"MethodMultiSimpleNoPayload implements MethodMultiSimpleNoPayload." name:"method-multi-simple-no-payload"`
		MethodMultiSimplePayload   struct {
			Body string `help:"" name:"body" required:""`
		} `cmd:"" help:"MethodMultiSimplePayload implements MethodMultiSimplePayload." name:"method-multi-simple-payload"`
	} `cmd:"" help:"Service is the ServiceMultiSimple2 service interface." name:"service-multi-simple2"`
}

// ParseEndpoint returns the endpoint and payload as specified on the command
// line.
func ParseEndpoint(scheme string, host string, doer loomhttp.Doer, enc func(*http.Request) loomhttp.Encoder, dec func(*http.Response) loomhttp.Decoder, restore bool) (loom.Endpoint, any, error) {
	var (
		command                                             commandLine
		args                                                []string
		svcn                                                string
		epn                                                 string
		serviceMultiSimple1MethodMultiSimplePayloadBodyFlag *string
		serviceMultiSimple2MethodMultiSimplePayloadBodyFlag *string
	)
	{
		args = flag.Args()
		if len(args) == 0 {
			args = os.Args[1:]
		}
		path, err := loomhttpcli.Parse(&command, os.Args[0], args)
		if err != nil {
			return nil, nil, fmt.Errorf("parse command: %w", err)
		}
		serviceMultiSimple1MethodMultiSimplePayloadBodyFlag = &command.ServiceMultiSimple1.MethodMultiSimplePayload.Body
		serviceMultiSimple2MethodMultiSimplePayloadBodyFlag = &command.ServiceMultiSimple2.MethodMultiSimplePayload.Body
		switch path {
		case "service-multi-simple1 method-multi-simple-no-payload":
			svcn = "service-multi-simple1"
			epn = "method-multi-simple-no-payload"
		case "service-multi-simple1 method-multi-simple-payload":
			svcn = "service-multi-simple1"
			epn = "method-multi-simple-payload"
		case "service-multi-simple2 method-multi-simple-no-payload":
			svcn = "service-multi-simple2"
			epn = "method-multi-simple-no-payload"
		case "service-multi-simple2 method-multi-simple-payload":
			svcn = "service-multi-simple2"
			epn = "method-multi-simple-payload"
		}
	}

	var (
		data     any
		endpoint loom.Endpoint
		err      error
	)
	{
		switch svcn {
		case "service-multi-simple1":
			c := servicemultisimple1c.NewClient(scheme, host, doer, enc, dec, restore)
			switch epn {
			case "method-multi-simple-no-payload":
				endpoint = c.MethodMultiSimpleNoPayload()
			case "method-multi-simple-payload":
				endpoint = c.MethodMultiSimplePayload()
				data, err = servicemultisimple1c.BuildMethodMultiSimplePayloadPayload(*serviceMultiSimple1MethodMultiSimplePayloadBodyFlag)
			}
		case "service-multi-simple2":
			c := servicemultisimple2c.NewClient(scheme, host, doer, enc, dec, restore)
			switch epn {
			case "method-multi-simple-no-payload":
				endpoint = c.MethodMultiSimpleNoPayload()
			case "method-multi-simple-payload":
				endpoint = c.MethodMultiSimplePayload()
				data, err = servicemultisimple2c.BuildMethodMultiSimplePayloadPayload(*serviceMultiSimple2MethodMultiSimplePayloadBodyFlag)
			}
		}
	}
	if err != nil {
		return nil, nil, err
	}
	return endpoint, data, nil
}
