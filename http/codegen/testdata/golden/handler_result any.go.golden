// NewMethodBodyPrimitiveAnyHandler creates a HTTP handler which loads the HTTP
// request and calls the "ServiceBodyPrimitiveAny" service
// "MethodBodyPrimitiveAny" endpoint.
func NewMethodBodyPrimitiveAnyHandler(
	endpoint loom.Endpoint,
	mux loomhttp.Muxer,
	decoder func(*http.Request) loomhttp.Decoder,
	encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder,
	errhandler func(context.Context, http.ResponseWriter, error),
	formatter func(ctx context.Context, err error) loomhttp.StatusCoder,
) http.Handler {
	var (
		encodeResponse = EncodeMethodBodyPrimitiveAnyResponse(encoder)
		encodeError    = loomhttp.ErrorEncoder(encoder, formatter)
	)
	return loomhttp.NewUnaryHandler(loomhttp.UnaryHandlerSpec[struct{}, loomhttp.UnaryResult[any]]{
		Service: "ServiceBodyPrimitiveAny",
		Method:  "MethodBodyPrimitiveAny",
		Invoke: func(ctx context.Context, _ struct{}) (loomhttp.UnaryResult[any], error) {
			res, err := endpoint(ctx, nil)
			if err != nil {
				var zero loomhttp.UnaryResult[any]
				return zero, err
			}
			return loomhttp.UnaryResult[any]{Value: res}, nil
		},
		EncodeResponse: func(ctx context.Context, w http.ResponseWriter, result loomhttp.UnaryResult[any]) error {
			return encodeResponse(ctx, w, result.Value)
		},
		EncodeError:   encodeError,
		HandleFailure: errhandler,
	})
}
