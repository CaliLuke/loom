// DecodeMethodQueryStringDefaultRequest returns a decoder for requests sent to
// the ServiceQueryStringDefault MethodQueryStringDefault endpoint.
func DecodeMethodQueryStringDefaultRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerystringdefault.MethodQueryStringDefaultPayload, error) {
	return func(r *http.Request) (*servicequerystringdefault.MethodQueryStringDefaultPayload, error) {
		var payload *servicequerystringdefault.MethodQueryStringDefaultPayload
		var (
			q string
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp.Get("q")
			qPresent := qp.Has("q")

			if qPresent {
				q = qRaw
			} else {
				q = "def"
			}
		}
		payload = NewMethodQueryStringDefaultPayload(q)

		return payload, nil
	}
}
