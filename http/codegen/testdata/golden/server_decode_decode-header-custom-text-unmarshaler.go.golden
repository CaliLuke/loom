// DecodeMethodHeaderCustomTextUnmarshalerRequest returns a decoder for
// requests sent to the ServiceHeaderCustomTextUnmarshaler
// MethodHeaderCustomTextUnmarshaler endpoint.
func DecodeMethodHeaderCustomTextUnmarshalerRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*serviceheadercustomtextunmarshaler.MethodHeaderCustomTextUnmarshalerPayload, error) {
	return func(r *http.Request) (*serviceheadercustomtextunmarshaler.MethodHeaderCustomTextUnmarshalerPayload, error) {
		var payload *serviceheadercustomtextunmarshaler.MethodHeaderCustomTextUnmarshalerPayload
		var err error
		var (
			id uuid.UUID
		)
		{
			idRaw := r.Header.Get("id")
			idPresent := len(r.Header.Values("id")) > 0

			if idPresent {
				if err2 := id.UnmarshalText([]byte(idRaw)); err2 != nil {
					err = loom.MergeErrors(err, loom.InvalidFieldTypeError("id", idRaw, "uuid.UUID"))
				}
			} else {
				err = loom.MergeErrors(err, loom.MissingFieldError("id", "header"))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodHeaderCustomTextUnmarshalerPayload(id)

		return payload, nil
	}
}
