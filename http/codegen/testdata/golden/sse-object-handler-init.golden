// NewSSEObjectMethodHandler creates a HTTP handler which loads the HTTP
// request and calls the "SSEObjectService" service "SSEObjectMethod" endpoint.
func NewSSEObjectMethodHandler(
	endpoint loom.Endpoint,
	mux loomhttp.Muxer,
	decoder func(*http.Request) loomhttp.Decoder,
	encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder,
	errhandler func(context.Context, http.ResponseWriter, error),
	formatter func(ctx context.Context, err error) loomhttp.Statuser,
) http.Handler {
	var (
		encodeError = loomhttp.ErrorEncoder(encoder, formatter)
	)
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		ctx := context.WithValue(r.Context(), loomhttp.AcceptTypeKey, r.Header.Get("Accept"))
		ctx = context.WithValue(ctx, loom.MethodKey, "SSEObjectMethod")
		ctx = context.WithValue(ctx, loom.ServiceKey, "SSEObjectService")
		obs, w := loomtransport.BeginHTTPRequest(ctx, w, "SSEObjectService", "SSEObjectMethod", r)
		defer obs.End()
		var err error
		stream := &SSEObjectMethodServerStream{
			w: w,
			r: r,
		}
		v := &sseobjectservice.SSEObjectMethodEndpointInput{
			Stream: stream,
		}
		_, err = endpoint(ctx, v)
		if err != nil {
			obs.Fail(loomtransport.ReasonHandlerError)
			if stream.started() {
				if errhandler != nil {
					errhandler(ctx, w, err)
				}
				return
			}
			if err := encodeError(ctx, w, err); err != nil && errhandler != nil {
				errhandler(ctx, w, err)
			}
			return
		}
	})
}
