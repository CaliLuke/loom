// Mount configures the mux to serve the ServiceFileServer endpoints.
func Mount(mux loomhttp.Muxer, h *Server) {
	mux.Handle("GET", "/file.json", h.PathToFileJSON.ServeHTTP)
	mux.Handle("GET", "/", h.PathToFileJSON2.ServeHTTP)
	mux.Handle("GET", "/relative-file.json", h.FileJSON.ServeHTTP)
	mux.Handle("GET", "/static/", http.StripPrefix("/static", h.PathToFolder).ServeHTTP)
	mux.Handle("GET", "/static/{*wildcard}", http.StripPrefix("/static", h.PathToFolder).ServeHTTP)
}

// Mount configures the mux to serve the ServiceFileServer endpoints.
func (s *Server) Mount(mux loomhttp.Muxer) {
	Mount(mux, s)
}
