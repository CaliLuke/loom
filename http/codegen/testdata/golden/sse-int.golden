// SSEIntMethodServerStream implements the
// sseintservice.SSEIntMethodServerStream interface using Server-Sent Events.
type SSEIntMethodServerStream struct {
	// writer owns the serialized SSE response lifecycle.
	writer *loomhttp.SSEStreamWriter
}

// Send streams instances of "int" to the "SSEIntMethod" endpoint SSE
// connection.
func (s *SSEIntMethodServerStream) Send(v int) error {
	return s.SendWithContext(s.writer.Context(), v)
}

func (s *SSEIntMethodServerStream) started() bool {
	return s.writer.Started()
}

// Open commits and flushes the successful SSE response before the first event.
func (s *SSEIntMethodServerStream) Open(ctx context.Context) error {
	return s.writer.Open(ctx)
}

// SendComment writes and flushes an SSE heartbeat comment.
func (s *SSEIntMethodServerStream) SendComment(ctx context.Context, text string) error {
	return s.writer.SendComment(ctx, text)
}

// SendWithContext streams instances of "int" to the "SSEIntMethod" endpoint
// SSE connection with context.
func (s *SSEIntMethodServerStream) SendWithContext(ctx context.Context, v int) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	res := v

	var payload any
	body := NewSSEIntMethodResponseBody(res)
	payload = body
	data, err := loomhttp.EncodeSSEData(payload)
	if err != nil {
		return err
	}

	msg := loomhttp.SSEMessage{Data: data}

	return s.writer.WriteEvent(ctx, func(w io.Writer) error {
		return loomhttp.WriteSSEEvent(w, msg)
	})
}

// Close prevents later SSE control or event writes.
func (s *SSEIntMethodServerStream) Close() error {
	return s.writer.Close()
}
