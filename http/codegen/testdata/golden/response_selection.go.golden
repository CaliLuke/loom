// EncodeBodylessResponse returns an encoder for responses returned by the
// selection bodyless endpoint.
func EncodeBodylessResponse(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, ok := v.(*selection.BodylessResult)
		if !ok {
			return loomhttp.ErrInvalidType("selection", "bodyless", "*selection.BodylessResult", v)
		}
		if func() bool {
			if res == nil {
				return false
			}
			if res.Kind != nil && *res.Kind == "accepted" {
				return true
			}
			return false
		}() {
			w.WriteHeader(http.StatusAccepted)
			return nil
		}
		w.WriteHeader(http.StatusOK)
		return nil
	}
}

// EncodeDefaultFirstResponse returns an encoder for responses returned by the
// selection default_first endpoint.
func EncodeDefaultFirstResponse(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, ok := v.(*selection.SelectionResult)
		if !ok {
			return loomhttp.ErrInvalidType("selection", "default_first", "*selection.SelectionResult", v)
		}
		if func() bool {
			if res == nil {
				return false
			}
			if res.First == "yes" {
				return true
			}
			return false
		}() {
			if res == nil {
				return fmt.Errorf("selected response value is absent")
			}

			enc := encoder(ctx, w)
			body := res.Message
			w.Header().Set("X-Trace", res.Trace)
			w.Header().Set("X-First", res.First)
			w.Header().Set("X-Second", res.Second)
			w.WriteHeader(http.StatusCreated)
			return enc.Encode(body)
		}
		if func() bool {
			if res == nil {
				return false
			}
			if res.Second == "yes" {
				return true
			}
			return false
		}() {
			if res == nil {
				return fmt.Errorf("selected response value is absent")
			}

			enc := encoder(ctx, w)
			body := res.Message
			w.Header().Set("X-Trace", res.Trace)
			w.Header().Set("X-First", res.First)
			w.Header().Set("X-Second", res.Second)
			w.WriteHeader(http.StatusAccepted)
			return enc.Encode(body)
		}
		if res == nil {
			return fmt.Errorf("selected response value is absent")
		}

		enc := encoder(ctx, w)
		body := res.Message
		w.Header().Set("X-Trace", res.Trace)
		w.Header().Set("X-First", res.First)
		w.Header().Set("X-Second", res.Second)
		w.WriteHeader(http.StatusOK)
		return enc.Encode(body)
	}
}

