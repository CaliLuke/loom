// EncodeCreateResponse returns an encoder for responses returned by the
// multiSessionCookieResponse create endpoint.
func EncodeCreateResponse(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, ok := v.(*multisessioncookieresponse.CreateResult)
		if !ok {
			return loomhttp.ErrInvalidType("multiSessionCookieResponse", "create", "*multisessioncookieresponse.CreateResult", v)
		}
		if res.Session != nil {
			session := *res.Session
			if err := loomhttp.SetResponseCookie(ctx, w, &http.Cookie{
				Name:     "__Host-ak_session",
				Value:    session,
				Path:     "/",
				Secure:   true,
				HttpOnly: true,
				SameSite: http.SameSiteLaxMode,
			}); err != nil {
				return err
			}
		}
		if res.Refresh != nil {
			refresh := *res.Refresh
			if err := loomhttp.SetResponseCookie(ctx, w, &http.Cookie{
				Name:   "ak_refresh",
				Value:  refresh,
				Path:   "/tokens",
				Domain: "accounts.loom.design",
			}); err != nil {
				return err
			}
		}
		w.WriteHeader(http.StatusCreated)
		return nil
	}
}
