// EncodeMethodHeaderArrayIntResponse returns an encoder for responses returned
// by the ServiceHeaderArrayInt MethodHeaderArrayInt endpoint.
func EncodeMethodHeaderArrayIntResponse(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, ok := v.(*serviceheaderarrayint.MethodHeaderArrayIntResult)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceHeaderArrayInt", "MethodHeaderArrayInt", "*serviceheaderarrayint.MethodHeaderArrayIntResult", v)
		}
		if res.H != nil {
			val := res.H
			var hs []string
			if val != nil {
				hs = make([]string, len(val))
				for i, e := range val {
					hs[i] = strconv.Itoa(e)
				}
			}
			if err := loomhttp.SetHeaderValues(w.Header(), "H", hs); err != nil {
				return err
			}
		}
		w.WriteHeader(http.StatusOK)
		return nil
	}
}
