type commandLine struct {
	ServiceMulti struct {
		MethodMultiNoPayload struct{} `cmd:"" help:"MethodMultiNoPayload implements MethodMultiNoPayload." name:"method-multi-no-payload"`
		MethodMultiPayload   struct {
			Body string `help:"" name:"body" required:""`
			B    string `help:"" name:"b" short:"b"`
			A    string `help:"" name:"a" short:"a"`
		} `cmd:"" help:"MethodMultiPayload implements MethodMultiPayload." name:"method-multi-payload"`
	} `cmd:"" help:"Service is the ServiceMulti service interface." name:"service-multi"`
}

// ParseEndpoint returns the endpoint and payload as specified on the command
// line.
func ParseEndpoint(scheme string, host string, doer loomhttp.Doer, enc func(*http.Request) loomhttp.Encoder, dec func(*http.Response) loomhttp.Decoder, restore bool) (loom.Endpoint, any, error) {
	var (
		command                                commandLine
		args                                   []string
		svcn                                   string
		epn                                    string
		serviceMultiMethodMultiPayloadBodyFlag *string
		serviceMultiMethodMultiPayloadBFlag    *string
		serviceMultiMethodMultiPayloadAFlag    *string
	)
	{
		args = flag.Args()
		if len(args) == 0 {
			args = os.Args[1:]
		}
		path, err := loomhttpcli.Parse(&command, os.Args[0], args)
		if err != nil {
			return nil, nil, err
		}
		serviceMultiMethodMultiPayloadBodyFlag = &command.ServiceMulti.MethodMultiPayload.Body
		serviceMultiMethodMultiPayloadBFlag = &command.ServiceMulti.MethodMultiPayload.B
		serviceMultiMethodMultiPayloadAFlag = &command.ServiceMulti.MethodMultiPayload.A
		switch path {
		case "service-multi method-multi-no-payload":
			svcn = "service-multi"
			epn = "method-multi-no-payload"
		case "service-multi method-multi-payload":
			svcn = "service-multi"
			epn = "method-multi-payload"
		}
	}

	var (
		data     any
		endpoint loom.Endpoint
		err      error
	)
	{
		switch svcn {
		case "service-multi":
			c := servicemultic.NewClient(scheme, host, doer, enc, dec, restore)
			switch epn {
			case "method-multi-no-payload":
				endpoint = c.MethodMultiNoPayload()
			case "method-multi-payload":
				endpoint = c.MethodMultiPayload()
				data, err = servicemultic.BuildMethodMultiPayloadPayload(*serviceMultiMethodMultiPayloadBodyFlag, *serviceMultiMethodMultiPayloadBFlag, *serviceMultiMethodMultiPayloadAFlag)
			}
		}
	}
	if err != nil {
		return nil, nil, err
	}
	return endpoint, data, nil
}
