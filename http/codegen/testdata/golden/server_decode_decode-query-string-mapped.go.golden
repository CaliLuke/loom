// DecodeMethodQueryStringMappedRequest returns a decoder for requests sent to
// the ServiceQueryStringMapped MethodQueryStringMapped endpoint.
func DecodeMethodQueryStringMappedRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerystringmapped.MethodQueryStringMappedPayload, error) {
	return func(r *http.Request) (*servicequerystringmapped.MethodQueryStringMappedPayload, error) {
		var payload *servicequerystringmapped.MethodQueryStringMappedPayload
		var (
			query *string
		)
		{
			rawValues, present := r.URL.Query()["q"]
			if present {
				raw := ""
				if len(rawValues) > 0 {
					raw = rawValues[0]
				}
				query = &raw
			}
		}
		payload = NewMethodQueryStringMappedPayload(query)

		return payload, nil
	}
}
