type commandLine struct {
	ServiceMultiRequired1 struct {
		MethodMultiRequiredPayload struct {
			Body string `help:"" name:"body" required:""`
		} `cmd:"" help:"MethodMultiRequiredPayload implements MethodMultiRequiredPayload." name:"method-multi-required-payload"`
	} `cmd:"" help:"Service is the ServiceMultiRequired1 service interface." name:"service-multi-required1"`
	ServiceMultiRequired2 struct {
		MethodMultiRequiredNoPayload struct{} `cmd:"" help:"MethodMultiRequiredNoPayload implements MethodMultiRequiredNoPayload." name:"method-multi-required-no-payload"`
		MethodMultiRequiredPayload   struct {
			A string `help:"" name:"a" required:"" short:"a"`
		} `cmd:"" help:"MethodMultiRequiredPayload implements MethodMultiRequiredPayload." name:"method-multi-required-payload"`
	} `cmd:"" help:"Service is the ServiceMultiRequired2 service interface." name:"service-multi-required2"`
}

// ParseEndpoint returns the endpoint and payload as specified on the command
// line.
func ParseEndpoint(scheme string, host string, doer loomhttp.Doer, enc func(*http.Request) loomhttp.Encoder, dec func(*http.Response) loomhttp.Decoder, restore bool) (loom.Endpoint, any, error) {
	var (
		command                                                 commandLine
		args                                                    []string
		svcn                                                    string
		epn                                                     string
		serviceMultiRequired1MethodMultiRequiredPayloadBodyFlag *string
		serviceMultiRequired2MethodMultiRequiredPayloadAFlag    *string
	)
	{
		args = flag.Args()
		if len(args) == 0 {
			args = os.Args[1:]
		}
		path, err := loomhttpcli.Parse(&command, os.Args[0], args)
		if err != nil {
			return nil, nil, fmt.Errorf("parse command: %w", err)
		}
		serviceMultiRequired1MethodMultiRequiredPayloadBodyFlag = &command.ServiceMultiRequired1.MethodMultiRequiredPayload.Body
		serviceMultiRequired2MethodMultiRequiredPayloadAFlag = &command.ServiceMultiRequired2.MethodMultiRequiredPayload.A
		switch path {
		case "service-multi-required1 method-multi-required-payload":
			svcn = "service-multi-required1"
			epn = "method-multi-required-payload"
		case "service-multi-required2 method-multi-required-no-payload":
			svcn = "service-multi-required2"
			epn = "method-multi-required-no-payload"
		case "service-multi-required2 method-multi-required-payload":
			svcn = "service-multi-required2"
			epn = "method-multi-required-payload"
		}
	}

	var (
		data     any
		endpoint loom.Endpoint
		err      error
	)
	{
		switch svcn {
		case "service-multi-required1":
			c := servicemultirequired1c.NewClient(scheme, host, doer, enc, dec, restore)
			switch epn {
			case "method-multi-required-payload":
				endpoint = c.MethodMultiRequiredPayload()
				data, err = servicemultirequired1c.BuildMethodMultiRequiredPayloadPayload(*serviceMultiRequired1MethodMultiRequiredPayloadBodyFlag)
			}
		case "service-multi-required2":
			c := servicemultirequired2c.NewClient(scheme, host, doer, enc, dec, restore)
			switch epn {
			case "method-multi-required-no-payload":
				endpoint = c.MethodMultiRequiredNoPayload()
			case "method-multi-required-payload":
				endpoint = c.MethodMultiRequiredPayload()
				data, err = servicemultirequired2c.BuildMethodMultiRequiredPayloadPayload(*serviceMultiRequired2MethodMultiRequiredPayloadAFlag)
			}
		}
	}
	if err != nil {
		return nil, nil, err
	}
	return endpoint, data, nil
}
