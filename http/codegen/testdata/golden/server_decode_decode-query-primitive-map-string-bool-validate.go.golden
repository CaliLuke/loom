import "regexp"

// DecodeMethodQueryPrimitiveMapStringBoolValidateRequest returns a decoder for
// requests sent to the ServiceQueryPrimitiveMapStringBoolValidate
// MethodQueryPrimitiveMapStringBoolValidate endpoint.
func DecodeMethodQueryPrimitiveMapStringBoolValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (map[string]bool, error) {
	return func(r *http.Request) (map[string]bool, error) {
		var payload map[string]bool
		var (
			q   map[string]bool
			err error
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp
			qHasValues := false
			for keyRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					qHasValues = true
					break
				}
			}
			if !qHasValues {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
			for keyRaw, valRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					if q == nil {
						q = make(map[string]bool)
					}
					var keya string
					var keyaErr error
					{
						openIdx := strings.IndexRune(keyRaw, '[')
						closeIdx := strings.IndexRune(keyRaw, ']')
						if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
							keyaErr = loom.DecodePayloadError("invalid query string: malformed brackets")
							err = loom.MergeErrors(err, keyaErr)
						} else {
							keya = keyRaw[openIdx+1 : closeIdx]
						}
					}
					if keyaErr != nil {
						continue
					}
					var vala bool
					{
						valaRaw := valRaw[0]
						v, err2 := strconv.ParseBool(valaRaw)
						if err2 != nil {
							err = loom.MergeErrors(err, loom.InvalidFieldTypeError("query", valaRaw, "boolean"))
						}
						vala = v
					}
					q[keya] = vala
				}
			}
		}
		if len(q) < 1 {
			err = loom.MergeErrors(err, loom.InvalidLengthError("q", q, len(q), 1, true))
		}
		for k, v := range q {
			err = loom.MergeErrors(err, loom.ValidatePatternCompiled("q.key", k, loomPatternTest0))
			if !(v == true) {
				err = loom.MergeErrors(err, loom.InvalidEnumValueError("q[key]", v, []any{true}))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = q

		return payload, nil
	}
}

var loomPatternTest0 = regexp.MustCompile("key")
