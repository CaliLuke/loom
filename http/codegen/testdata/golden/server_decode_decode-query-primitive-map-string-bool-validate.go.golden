			if decodeErr != nil {
				return payload, loom.DecodePayloadError(loomhttp.SafeDecodePayloadMessage(decodeErr))
			}
			if present {
				if len(decoded) < 1 {
					err = loom.MergeErrors(err, loom.InvalidLengthError("q", len(decoded), 1, true))
				}
				for k, v := range decoded {
					err = loom.MergeErrors(err, loom.ValidatePatternCompiled("q.key", k, loomPatternTest0))
					if actual, ok := v.Value(); ok {
						if !(actual == true) {
							err = loom.MergeErrors(err, loom.InvalidEnumValueError("q[key]", actual, []any{true}))
						}
					} else {
						err = loom.MergeErrors(err, loom.InvalidNullMapValueError("q[key]"))
					}
				}
				if err != nil {
					return payload, err
				}
				if decoded != nil {
					q = make(map[string]bool, len(decoded))
					for key, val := range decoded {
						tk := key
						actual, ok := val.Value()
						if !ok {
							var qMissingValue bool
							q[tk] = qMissingValue
							continue
						}
						tv := actual
						q[tk] = tv
					}
				} else {
					q = nil
				}
			}
			if !present {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
		}
		if err != nil {
