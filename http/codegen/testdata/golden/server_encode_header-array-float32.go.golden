// EncodeMethodHeaderArrayFloat32Response returns an encoder for responses
// returned by the ServiceHeaderArrayFloat32 MethodHeaderArrayFloat32 endpoint.
func EncodeMethodHeaderArrayFloat32Response(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, ok := v.(*serviceheaderarrayfloat32.MethodHeaderArrayFloat32Result)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceHeaderArrayFloat32", "MethodHeaderArrayFloat32", "*serviceheaderarrayfloat32.MethodHeaderArrayFloat32Result", v)
		}
		if res.H != nil {
			val := res.H
			var hs []string
			if val != nil {
				hs = make([]string, len(val))
				for i, e := range val {
					hs[i] = strconv.FormatFloat(float64(e), 'f', -1, 32)
				}
			}
			if err := loomhttp.SetHeaderValues(w.Header(), "H", hs); err != nil {
				return err
			}
		}
		w.WriteHeader(http.StatusOK)
		return nil
	}
}
