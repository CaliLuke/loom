// DecodeMethodQueryMapBoolStringRequest returns a decoder for requests sent to
// the ServiceQueryMapBoolString MethodQueryMapBoolString endpoint.
func DecodeMethodQueryMapBoolStringRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerymapboolstring.MethodQueryMapBoolStringPayload, error) {
	return func(r *http.Request) (*servicequerymapboolstring.MethodQueryMapBoolStringPayload, error) {
		var payload *servicequerymapboolstring.MethodQueryMapBoolStringPayload
		var (
			q   map[bool]string
			err error
		)
		{
			qRaw := r.URL.Query()
			qHasValues := false
			for keyRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					qHasValues = true
					break
				}
			}
			if qHasValues {
				for keyRaw, valRaw := range qRaw {
					if strings.HasPrefix(keyRaw, "q[") {
						if q == nil {
							q = make(map[bool]string)
						}
						var keya bool
						var keyaErr error
						{
							openIdx := strings.IndexRune(keyRaw, '[')
							closeIdx := strings.IndexRune(keyRaw, ']')
							if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
								keyaErr = loom.DecodePayloadError("invalid query string: malformed brackets")
								err = loom.MergeErrors(err, keyaErr)
							} else {
								keyaRaw := keyRaw[openIdx+1 : closeIdx]
								v, err2 := strconv.ParseBool(keyaRaw)
								if err2 != nil {
									keyaErr = loom.InvalidFieldTypeError("query", keyaRaw, "boolean")
									err = loom.MergeErrors(err, keyaErr)
								}
								keya = bool(v)
							}
						}
						if keyaErr != nil {
							continue
						}
						q[keya] = valRaw[0]
					}
				}
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodQueryMapBoolStringPayload(q)

		return payload, nil
	}
}
