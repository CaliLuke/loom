// DecodeMethodQueryMapStringArrayStringRequest returns a decoder for requests
// sent to the ServiceQueryMapStringArrayString MethodQueryMapStringArrayString
// endpoint.
func DecodeMethodQueryMapStringArrayStringRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerymapstringarraystring.MethodQueryMapStringArrayStringPayload, error) {
	return func(r *http.Request) (*servicequerymapstringarraystring.MethodQueryMapStringArrayStringPayload, error) {
		var payload *servicequerymapstringarraystring.MethodQueryMapStringArrayStringPayload
		var (
			q   map[string][]string
			err error
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp
			qHasValues := false
			for keyRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					qHasValues = true
					break
				}
			}
			if qHasValues {
				for keyRaw, valRaw := range qRaw {
					if strings.HasPrefix(keyRaw, "q[") {
						if q == nil {
							q = make(map[string][]string)
						}
						var keya string
						var keyaErr error
						{
							openIdx := strings.IndexRune(keyRaw, '[')
							closeIdx := strings.IndexRune(keyRaw, ']')
							if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
								keyaErr = loom.DecodePayloadError("invalid query string: malformed brackets")
								err = loom.MergeErrors(err, keyaErr)
							} else {
								keya = keyRaw[openIdx+1 : closeIdx]
							}
						}
						if keyaErr != nil {
							continue
						}
						q[keya] = valRaw
					}
				}
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodQueryMapStringArrayStringPayload(q)

