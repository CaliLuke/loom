// SSEDataIDFieldMethodServerStream implements the
// ssedataidfieldservice.SSEDataIDFieldMethodServerStream interface using
// Server-Sent Events.
type SSEDataIDFieldMethodServerStream struct {
	// writer owns the serialized SSE response lifecycle.
	writer *loomhttp.SSEStreamWriter
}

// Send streams instances of "ssedataidfieldservice.SSEDataIDFieldMethodResult"
// to the "SSEDataIDFieldMethod" endpoint SSE connection.
func (s *SSEDataIDFieldMethodServerStream) Send(v *ssedataidfieldservice.SSEDataIDFieldMethodResult) error {
	return s.SendWithContext(s.writer.Context(), v)
}

func (s *SSEDataIDFieldMethodServerStream) started() bool {
	return s.writer.Started()
}

// Open commits and flushes the successful SSE response before the first event.
func (s *SSEDataIDFieldMethodServerStream) Open(ctx context.Context) error {
	return s.writer.Open(ctx)
}

// SendComment writes and flushes an SSE heartbeat comment.
func (s *SSEDataIDFieldMethodServerStream) SendComment(ctx context.Context, text string) error {
	return s.writer.SendComment(ctx, text)
}

// SendWithContext streams instances of
// "ssedataidfieldservice.SSEDataIDFieldMethodResult" to the
// "SSEDataIDFieldMethod" endpoint SSE connection with context.
func (s *SSEDataIDFieldMethodServerStream) SendWithContext(ctx context.Context, v *ssedataidfieldservice.SSEDataIDFieldMethodResult) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	res := v

	var payload any
	body := NewSSEDataIDFieldMethodResponseBody(res)
	payload = body.Data
	data, err := loomhttp.EncodeSSEData(payload)
	if err != nil {
		return err
	}

	msg := loomhttp.SSEMessage{Data: data}

	if id := res.ID; id != "" {
		msg.ID = id
	}

	return s.writer.WriteEvent(ctx, func(w io.Writer) error {
		return loomhttp.WriteSSEEvent(w, msg)
	})
}

// Close prevents later SSE control or event writes.
func (s *SSEDataIDFieldMethodServerStream) Close() error {
	return s.writer.Close()
}
