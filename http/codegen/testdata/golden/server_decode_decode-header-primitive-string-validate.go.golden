// DecodeMethodHeaderPrimitiveStringValidateRequest returns a decoder for
// requests sent to the ServiceHeaderPrimitiveStringValidate
// MethodHeaderPrimitiveStringValidate endpoint.
func DecodeMethodHeaderPrimitiveStringValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (string, error) {
	return func(r *http.Request) (string, error) {
		var payload string
		var err error
		var (
			h string
		)
		{
			hRaw := r.Header.Get("h")
			hPresent := len(r.Header.Values("h")) > 0

			if hPresent {
				h = hRaw
				if !(h == "val") {
					err = loom.MergeErrors(err, loom.InvalidEnumValueError("h", h, []any{"val"}))
				}
			} else {
				err = loom.MergeErrors(err, loom.MissingFieldError("h", "header"))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = h

		return payload, nil
	}
}
