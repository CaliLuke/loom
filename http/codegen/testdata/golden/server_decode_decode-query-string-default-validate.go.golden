// DecodeMethodQueryStringDefaultValidateRequest returns a decoder for requests
// sent to the ServiceQueryStringDefaultValidate
// MethodQueryStringDefaultValidate endpoint.
func DecodeMethodQueryStringDefaultValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerystringdefaultvalidate.MethodQueryStringDefaultValidatePayload, error) {
	return func(r *http.Request) (*servicequerystringdefaultvalidate.MethodQueryStringDefaultValidatePayload, error) {
		var payload *servicequerystringdefaultvalidate.MethodQueryStringDefaultValidatePayload
		var err error
		var (
			q string
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp.Get("q")
			qPresent := qp.Has("q")

			if qPresent {
				q = qRaw
				if !(q == "def") {
					err = loom.MergeErrors(err, loom.InvalidEnumValueError("q", q, []any{"def"}))
				}
			} else {
				q = "def"
				if !(q == "def") {
					err = loom.MergeErrors(err, loom.InvalidEnumValueError("q", q, []any{"def"}))
				}
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodQueryStringDefaultValidatePayload(q)

		return payload, nil
	}
}
