// DecodeMethodQueryPrimitiveStringDefaultRequest returns a decoder for
// requests sent to the ServiceQueryPrimitiveStringDefault
// MethodQueryPrimitiveStringDefault endpoint.
func DecodeMethodQueryPrimitiveStringDefaultRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (string, error) {
	return func(r *http.Request) (string, error) {
		var payload string
		var err error
		var (
			q string
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp.Get("q")
			qPresent := qp.Has("q")

			if qPresent {
				q = qRaw
			} else {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = q

		return payload, nil
	}
}
