// SSERequestIDMethodServerStream implements the
// sserequestidservice.SSERequestIDMethodServerStream interface using
// Server-Sent Events.
type SSERequestIDMethodServerStream struct {
	// writer owns the serialized SSE response lifecycle.
	writer *loomhttp.SSEStreamWriter
}

// Send streams instances of "string" to the "SSERequestIDMethod" endpoint SSE
// connection.
func (s *SSERequestIDMethodServerStream) Send(v string) error {
	return s.SendWithContext(s.writer.Context(), v)
}

func (s *SSERequestIDMethodServerStream) started() bool {
	return s.writer.Started()
}

// Open commits and flushes the successful SSE response before the first event.
func (s *SSERequestIDMethodServerStream) Open(ctx context.Context) error {
	return s.writer.Open(ctx)
}

// SendComment writes and flushes an SSE heartbeat comment.
func (s *SSERequestIDMethodServerStream) SendComment(ctx context.Context, text string) error {
	return s.writer.SendComment(ctx, text)
}

// SendWithContext streams instances of "string" to the "SSERequestIDMethod"
// endpoint SSE connection with context.
func (s *SSERequestIDMethodServerStream) SendWithContext(ctx context.Context, v string) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	res := v

	var payload any
	body := NewSSERequestIDMethodResponseBody(res)
	payload = body
	data, err := loomhttp.EncodeSSEData(payload)
	if err != nil {
		return err
	}

	msg := loomhttp.SSEMessage{Data: data}

	return s.writer.WriteEvent(ctx, func(w io.Writer) error {
		return loomhttp.WriteSSEEvent(w, msg)
	})
}

// Close prevents later SSE control or event writes.
func (s *SSERequestIDMethodServerStream) Close() error {
	return s.writer.Close()
}
