// DecodeMethodQueryCustomNameRequest returns a decoder for requests sent to
// the ServiceQueryCustomName MethodQueryCustomName endpoint.
func DecodeMethodQueryCustomNameRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerycustomname.MethodQueryCustomNamePayload, error) {
	return func(r *http.Request) (*servicequerycustomname.MethodQueryCustomNamePayload, error) {
		var payload *servicequerycustomname.MethodQueryCustomNamePayload
		var (
			q *string
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp.Get("q")
			qPresent := qp.Has("q")

			if qPresent {
				q = &qRaw
			}
		}
		payload = NewMethodQueryCustomNamePayload(q)

		return payload, nil
	}
}
