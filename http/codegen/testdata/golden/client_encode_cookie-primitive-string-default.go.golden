// EncodeMethodCookiePrimitiveStringDefaultRequest returns an encoder for
// requests sent to the ServiceCookiePrimitiveStringDefault
// MethodCookiePrimitiveStringDefault server.
func EncodeMethodCookiePrimitiveStringDefaultRequest(encoder func(*http.Request) loomhttp.Encoder) func(*http.Request, any) error {
	return func(req *http.Request, v any) error {
		p, ok := v.(string)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceCookiePrimitiveStringDefault", "MethodCookiePrimitiveStringDefault", "string", v)
		}
		{
			v := p
			req.AddCookie(&http.Cookie{
				Name:  "c",
				Value: v,
			})
		}
		return nil
	}
}
