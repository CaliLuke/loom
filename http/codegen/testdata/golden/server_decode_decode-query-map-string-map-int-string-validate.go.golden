// DecodeMethodQueryMapStringMapIntStringValidateRequest returns a decoder for
// requests sent to the ServiceQueryMapStringMapIntStringValidate
// MethodQueryMapStringMapIntStringValidate endpoint.
func DecodeMethodQueryMapStringMapIntStringValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (map[string]map[int]string, error) {
	return func(r *http.Request) (map[string]map[int]string, error) {
		var payload map[string]map[int]string
		var err error
		var (
			q map[string]map[int]string
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			var decoded map[string]loom.Optional[map[int]loom.Optional[string]]
			present, decodeErr := loomhttp.DecodeJSONField(qp, "q", &decoded, false, loomhttp.FieldValue)
			if decodeErr != nil {
				return payload, loom.DecodePayloadError(loomhttp.SafeDecodePayloadMessage(decodeErr))
			}
			if present {
				for k, v := range decoded {
					if !(k == "foo") {
						err = loom.MergeErrors(err, loom.InvalidEnumValueError("q.key", k, []any{"foo"}))
					}
					if actual, ok := v.Value(); ok {
						for _, v := range actual {
							if _, ok := v.Value(); !ok {
								err = loom.MergeErrors(err, loom.InvalidNullMapValueError("q[key][key]"))
							}
						}
					} else {
						err = loom.MergeErrors(err, loom.InvalidNullMapValueError("q[key]"))
					}
				}
				if err != nil {
					return payload, err
				}
				if decoded != nil {
					q = make(map[string]map[int]string, len(decoded))
					for key, val := range decoded {
						tk := key
						actual, ok := val.Value()
						if !ok {
							var qMissingValue map[int]string
							q[tk] = qMissingValue
							continue
						}
						var tvb map[int]string
						if actual != nil {
							tvb = make(map[int]string, len(actual))
							for key, val := range actual {
								tk := key
								actual, ok := val.Value()
								if !ok {
									var tvbMissingValue string
									tvb[tk] = tvbMissingValue
									continue
								}
								tv := actual
								tvb[tk] = tv
							}
						}
						q[tk] = tvb
					}
				} else {
					q = nil
				}
			}
			if !present {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
		}
		if err != nil {
