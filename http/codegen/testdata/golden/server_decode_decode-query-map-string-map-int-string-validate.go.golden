// DecodeMethodQueryMapStringMapIntStringValidateRequest returns a decoder for
// requests sent to the ServiceQueryMapStringMapIntStringValidate
// MethodQueryMapStringMapIntStringValidate endpoint.
func DecodeMethodQueryMapStringMapIntStringValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (map[string]map[int]string, error) {
	return func(r *http.Request) (map[string]map[int]string, error) {
		var payload map[string]map[int]string
		var (
			q   map[string]map[int]string
			err error
		)
		{
			qRaw := r.URL.Query()
			qHasValues := false
			for keyRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					qHasValues = true
					break
				}
			}
			if !qHasValues {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
			for keyRaw, valRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					if q == nil {
						q = make(map[string]map[int]string)
					}
					var keya string
					var keyaErr error
					{
						openIdx := strings.IndexRune(keyRaw, '[')
						closeIdx := strings.IndexRune(keyRaw, ']')
						if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
							keyaErr = loom.DecodePayloadError("invalid query string: malformed brackets")
							err = loom.MergeErrors(err, keyaErr)
						} else {
							keya = keyRaw[openIdx+1 : closeIdx]
							keyRaw = keyRaw[closeIdx+1:]
						}
					}
					if keyaErr != nil {
						continue
					}
					if q[keya] == nil {
						q[keya] = make(map[int]string)
					}
					var keyb int
					var keybErr error
					{
						openIdx := strings.IndexRune(keyRaw, '[')
						closeIdx := strings.IndexRune(keyRaw, ']')
						if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
							keybErr = loom.DecodePayloadError("invalid query string: malformed brackets")
							err = loom.MergeErrors(err, keybErr)
						} else {
							keybRaw := keyRaw[openIdx+1 : closeIdx]
							v, err2 := strconv.ParseInt(keybRaw, 10, strconv.IntSize)
							if err2 != nil {
								keybErr = loom.InvalidFieldTypeError("query", keybRaw, "integer")
								err = loom.MergeErrors(err, keybErr)
							}
							keyb = int(v)
						}
					}
					if keybErr != nil {
						continue
					}
					q[keya][keyb] = valRaw[0]
				}
			}
		}
		for k, _ := range q {
			if !(k == "foo") {
				err = loom.MergeErrors(err, loom.InvalidEnumValueError("q.key", k, []any{"foo"}))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = q

		return payload, nil
	}
}
