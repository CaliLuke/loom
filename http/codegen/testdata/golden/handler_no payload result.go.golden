// NewMethodNoPayloadResultHandler creates a HTTP handler which loads the HTTP
// request and calls the "ServiceNoPayloadResult" service
// "MethodNoPayloadResult" endpoint.
func NewMethodNoPayloadResultHandler(
	endpoint loom.Endpoint,
	mux loomhttp.Muxer,
	decoder func(*http.Request) loomhttp.Decoder,
	encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder,
	errhandler func(context.Context, http.ResponseWriter, error),
	formatter func(ctx context.Context, err error) loomhttp.Statuser,
) http.Handler {
	var (
		encodeResponse = EncodeMethodNoPayloadResultResponse(encoder)
		encodeError    = loomhttp.ErrorEncoder(encoder, formatter)
	)
	return loomhttp.NewUnaryHandler(loomhttp.UnaryHandlerSpec[struct{}, loomhttp.UnaryResult[*servicenopayloadresult.MethodNoPayloadResultResult]]{
		Service: "ServiceNoPayloadResult",
		Method:  "MethodNoPayloadResult",
		Invoke: func(ctx context.Context, _ struct{}) (loomhttp.UnaryResult[*servicenopayloadresult.MethodNoPayloadResultResult], error) {
			res, err := endpoint(ctx, nil)
			if err != nil {
				var zero loomhttp.UnaryResult[*servicenopayloadresult.MethodNoPayloadResultResult]
				return zero, err
			}
			return loomhttp.UnaryResult[*servicenopayloadresult.MethodNoPayloadResultResult]{Value: res}, nil
		},
		EncodeResponse: func(ctx context.Context, w http.ResponseWriter, result loomhttp.UnaryResult[*servicenopayloadresult.MethodNoPayloadResultResult]) error {
			return encodeResponse(ctx, w, result.Value)
		},
		EncodeError:   encodeError,
		HandleFailure: errhandler,
	})
}
