// DecodeMethodQueryStringSliceDefaultRequest returns a decoder for requests
// sent to the ServiceQueryStringSliceDefault MethodQueryStringSliceDefault
// endpoint.
func DecodeMethodQueryStringSliceDefaultRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerystringslicedefault.MethodQueryStringSliceDefaultPayload, error) {
	return func(r *http.Request) (*servicequerystringslicedefault.MethodQueryStringSliceDefaultPayload, error) {
		var payload *servicequerystringslicedefault.MethodQueryStringSliceDefaultPayload
		var (
			q []string
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		q = qp["q"]
		if q == nil {
			q = []string{"hello", "goodbye"}
		}
		payload = NewMethodQueryStringSliceDefaultPayload(q)

		return payload, nil
	}
}
