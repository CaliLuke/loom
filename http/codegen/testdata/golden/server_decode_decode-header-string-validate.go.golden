import "regexp"

// DecodeMethodHeaderStringValidateRequest returns a decoder for requests sent
// to the ServiceHeaderStringValidate MethodHeaderStringValidate endpoint.
func DecodeMethodHeaderStringValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*serviceheaderstringvalidate.MethodHeaderStringValidatePayload, error) {
	return func(r *http.Request) (*serviceheaderstringvalidate.MethodHeaderStringValidatePayload, error) {
		var payload *serviceheaderstringvalidate.MethodHeaderStringValidatePayload
		var (
			h   *string
			err error
		)
		hRaw := r.Header.Get("h")
		if hRaw != "" {
			h = &hRaw
		}
		if h != nil {
			err = loom.MergeErrors(err, loom.ValidatePatternCompiled("h", *h, loomPatternTest0))
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodHeaderStringValidatePayload(h)

		return payload, nil
	}
}

var loomPatternTest0 = regexp.MustCompile("header")
