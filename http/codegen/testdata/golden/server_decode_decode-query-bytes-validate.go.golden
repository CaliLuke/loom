// DecodeMethodQueryBytesValidateRequest returns a decoder for requests sent to
// the ServiceQueryBytesValidate MethodQueryBytesValidate endpoint.
func DecodeMethodQueryBytesValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerybytesvalidate.MethodQueryBytesValidatePayload, error) {
	return func(r *http.Request) (*servicequerybytesvalidate.MethodQueryBytesValidatePayload, error) {
		var payload *servicequerybytesvalidate.MethodQueryBytesValidatePayload
		var err error
		var (
			q []byte
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp.Get("q")
			qPresent := qp.Has("q")

			if qPresent {
				q = []byte(qRaw)
				if len(q) < 1 {
					err = loom.MergeErrors(err, loom.InvalidLengthError("q", len(q), 1, true))
				}
			} else {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodQueryBytesValidatePayload(q)

		return payload, nil
	}
}
