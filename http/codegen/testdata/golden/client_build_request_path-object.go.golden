// BuildMethodPathObjectRequest instantiates a HTTP request object with method
// and path set to call the "ServicePathObject" service "MethodPathObject"
// endpoint
func (c *Client) BuildMethodPathObjectRequest(ctx context.Context, v any) (*http.Request, error) {
	var (
		id string
	)
	{
		p, ok := v.(*servicepathobject.MethodPathObjectPayload)
		if !ok {
			return nil, loomhttp.ErrInvalidType("ServicePathObject", "MethodPathObject", "*servicepathobject.MethodPathObjectPayload", v)
		}
		if p.ID != nil {
			id = *p.ID
		}
	}
	u, err := loomhttp.RequestURL(c.scheme, c.host, MethodPathObjectServicePathObjectPath(id))
	if err != nil {
		return nil, loomhttp.ErrInvalidURL("ServicePathObject", "MethodPathObject", u.String(), err)
	}
	req, err := http.NewRequest("PUT", u.String(), nil)
	if err != nil {
		return nil, loomhttp.ErrInvalidURL("ServicePathObject", "MethodPathObject", u.String(), err)
	}
	if ctx != nil {
		req = req.WithContext(ctx)
	}

	return req, nil
}
