// EncodeMethodFormBodyInvalidRequest returns an encoder for requests sent to
// the ServiceFormBodyInvalid MethodFormBodyInvalid server.
func EncodeMethodFormBodyInvalidRequest(encoder func(*http.Request) loomhttp.Encoder) func(*http.Request, any) error {
	return func(req *http.Request, v any) error {
		p, ok := v.(*serviceformbodyinvalid.MethodFormBodyInvalidPayload)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceFormBodyInvalid", "MethodFormBodyInvalid", "*serviceformbodyinvalid.MethodFormBodyInvalidPayload", v)
		}
		if p == nil {
			return loom.MissingPayloadError()
		}
		body := NewMethodFormBodyInvalidMethodFormBodyInvalidRequestBodyForm(p)
		{
			parameterEncoded, parameterError := func() (string, error) {
				parameterForm := make(map[string][]string)
				var parameterBuilder loomhttp.RawPairsBuilder
				if _, parameterError := loomhttp.EncodeFormValue(parameterForm, "count", body.Count); parameterError != nil {
					return "", parameterError
				}
				return parameterBuilder.Encode(parameterForm), nil
			}()
			if parameterError != nil {
				return parameterError
			}
			if parameterError := loomhttp.SetRawFormRequest(req, parameterEncoded); parameterError != nil {
				return parameterError
			}
		}

		return nil
	}
}
