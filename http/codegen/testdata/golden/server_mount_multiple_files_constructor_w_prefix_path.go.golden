// Mount configures the mux to serve the ServiceFileServer endpoints.
func Mount(mux loomhttp.Muxer, h *Server) {
	mux.Handle("GET", "/server_file_server/file.json", http.StripPrefix("/server_file_server", h.PathToFileJSON).ServeHTTP)
	mux.Handle("GET", "/server_file_server", h.PathToFileJSON2.ServeHTTP)
	mux.Handle("GET", "/server_file_server/relative-file.json", http.StripPrefix("/server_file_server", h.FileJSON).ServeHTTP)
	mux.Handle("GET", "/server_file_server/static/", http.StripPrefix("/server_file_server/static", h.PathToFolder).ServeHTTP)
	mux.Handle("GET", "/server_file_server/static/{*wildcard}", http.StripPrefix("/server_file_server/static", h.PathToFolder).ServeHTTP)
}

// Mount configures the mux to serve the ServiceFileServer endpoints.
func (s *Server) Mount(mux loomhttp.Muxer) {
	Mount(mux, s)
}
