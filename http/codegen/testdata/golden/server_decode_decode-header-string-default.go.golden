// DecodeMethodHeaderStringDefaultRequest returns a decoder for requests sent
// to the ServiceHeaderStringDefault MethodHeaderStringDefault endpoint.
func DecodeMethodHeaderStringDefaultRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*serviceheaderstringdefault.MethodHeaderStringDefaultPayload, error) {
	return func(r *http.Request) (*serviceheaderstringdefault.MethodHeaderStringDefaultPayload, error) {
		var payload *serviceheaderstringdefault.MethodHeaderStringDefaultPayload
		var (
			h string
		)
		{
			hRaw := r.Header.Get("h")
			hPresent := len(r.Header.Values("h")) > 0

			if hPresent {
				h = hRaw
			} else {
				h = "def"
			}
		}
		payload = NewMethodHeaderStringDefaultPayload(h)

		return payload, nil
	}
}
