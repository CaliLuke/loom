// EncodeMethodCookieCustomTextUnmarshalerDefaultRequest returns an encoder for
// requests sent to the ServiceCookieCustomTextUnmarshalerDefault
// MethodCookieCustomTextUnmarshalerDefault server.
func EncodeMethodCookieCustomTextUnmarshalerDefaultRequest(encoder func(*http.Request) loomhttp.Encoder) func(*http.Request, any) error {
	return func(req *http.Request, v any) error {
		p, ok := v.(*servicecookiecustomtextunmarshalerdefault.MethodCookieCustomTextUnmarshalerDefaultPayload)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceCookieCustomTextUnmarshalerDefault", "MethodCookieCustomTextUnmarshalerDefault", "*servicecookiecustomtextunmarshalerdefault.MethodCookieCustomTextUnmarshalerDefaultPayload", v)
		}
		{
			v := fmt.Sprint(p.ID)
			req.AddCookie(&http.Cookie{
				Name:  "id",
				Value: v,
			})
		}
		return nil
	}
}
