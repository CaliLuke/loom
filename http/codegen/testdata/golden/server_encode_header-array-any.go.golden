// EncodeMethodHeaderArrayAnyResponse returns an encoder for responses returned
// by the ServiceHeaderArrayAny MethodHeaderArrayAny endpoint.
func EncodeMethodHeaderArrayAnyResponse(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, ok := v.(*serviceheaderarrayany.MethodHeaderArrayAnyResult)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceHeaderArrayAny", "MethodHeaderArrayAny", "*serviceheaderarrayany.MethodHeaderArrayAnyResult", v)
		}
		if res.H != nil {
			val := res.H
			hsSlice := make([]string, len(val))
			for i, e := range val {
				es := loom.JSONValueString(e)
				hsSlice[i] = es
			}
			hs := strings.Join(hsSlice, ", ")
			w.Header().Set("H", hs)
		}
		w.WriteHeader(http.StatusOK)
		return nil
	}
}
