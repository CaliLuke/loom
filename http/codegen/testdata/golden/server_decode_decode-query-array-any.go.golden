// DecodeMethodQueryArrayAnyRequest returns a decoder for requests sent to the
// ServiceQueryArrayAny MethodQueryArrayAny endpoint.
func DecodeMethodQueryArrayAnyRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequeryarrayany.MethodQueryArrayAnyPayload, error) {
	return func(r *http.Request) (*servicequeryarrayany.MethodQueryArrayAnyPayload, error) {
		var payload *servicequeryarrayany.MethodQueryArrayAnyPayload
		var (
			q []loom.JSONValue
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp["q"]
			if qRaw != nil {
				q = make([]loom.JSONValue, len(qRaw))
				for i, rv := range qRaw {
					q[i] = loom.JSONValueFromString(rv)
				}
			}
		}
		payload = NewMethodQueryArrayAnyPayload(q)

		return payload, nil
	}
}
