// DecodeMethodFormBodyInvalidRequest returns a decoder for requests sent to
// the ServiceFormBodyInvalid MethodFormBodyInvalid endpoint.
func DecodeMethodFormBodyInvalidRequest(mux loomhttp.Muxer, decoder func(*http.Request) loomhttp.Decoder) func(*http.Request) (*serviceformbodyinvalid.MethodFormBodyInvalidPayload, error) {
	return func(r *http.Request) (*serviceformbodyinvalid.MethodFormBodyInvalidPayload, error) {
		var payload *serviceformbodyinvalid.MethodFormBodyInvalidPayload
		var (
			body MethodFormBodyInvalidRequestBody
			err  error
		)
		if err = r.ParseForm(); err != nil {
			return payload, loom.DecodePayloadError(loomhttp.SafeDecodePayloadMessage(err))
		}
		if len(r.PostForm) == 0 {
			return payload, loom.MissingPayloadError()
		} else {
			if _, err = loomhttp.DecodeFormValue(r.PostForm, "", &body); err != nil {
				var gerr *loom.ServiceError
				if errors.As(err, &gerr) {
					return payload, gerr
				}
				return payload, loom.DecodePayloadError(loomhttp.SafeDecodePayloadMessage(err))
			}
		}
		err = ValidateMethodFormBodyInvalidRequestBody(&body)
		if err != nil {
			return payload, err
		}
		payload = NewMethodFormBodyInvalidPayload(&body)

		return payload, nil
	}
}
