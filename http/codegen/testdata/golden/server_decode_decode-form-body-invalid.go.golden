// DecodeMethodFormBodyInvalidRequest returns a decoder for requests sent to
// the ServiceFormBodyInvalid MethodFormBodyInvalid endpoint.
func DecodeMethodFormBodyInvalidRequest(mux goahttp.Muxer, decoder func(*http.Request) goahttp.Decoder) func(*http.Request) (*serviceformbodyinvalid.MethodFormBodyInvalidPayload, error) {
	return func(r *http.Request) (*serviceformbodyinvalid.MethodFormBodyInvalidPayload, error) {
		var payload *serviceformbodyinvalid.MethodFormBodyInvalidPayload
		var (
			body MethodFormBodyInvalidRequestBody
			err  error
		)
		if err = r.ParseForm(); err != nil {
			return payload, goa.DecodePayloadError(err.Error())
		}
		if len(r.PostForm) == 0 {
			return payload, goa.MissingPayloadError()
		} else {
			if _, err = goahttp.DecodeFormValue(r.PostForm, "", &body); err != nil {
				var gerr *goa.ServiceError
				if errors.As(err, &gerr) {
					return payload, gerr
				}
				return payload, goa.DecodePayloadError(err.Error())
			}
		}
		err = ValidateMethodFormBodyInvalidRequestBody(&body)
		if err != nil {
			return payload, err
		}
		payload = NewMethodFormBodyInvalidPayload(&body)

		return payload, nil
	}
}
