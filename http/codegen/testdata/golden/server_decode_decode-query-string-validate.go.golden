// DecodeMethodQueryStringValidateRequest returns a decoder for requests sent
// to the ServiceQueryStringValidate MethodQueryStringValidate endpoint.
func DecodeMethodQueryStringValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerystringvalidate.MethodQueryStringValidatePayload, error) {
	return func(r *http.Request) (*servicequerystringvalidate.MethodQueryStringValidatePayload, error) {
		var payload *servicequerystringvalidate.MethodQueryStringValidatePayload
		var err error
		var (
			q string
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp.Get("q")
			qPresent := qp.Has("q")

			if qPresent {
				q = qRaw
				if !(q == "val") {
					err = loom.MergeErrors(err, loom.InvalidEnumValueError("q", q, []any{"val"}))
				}
			} else {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodQueryStringValidatePayload(q)

		return payload, nil
	}
}
