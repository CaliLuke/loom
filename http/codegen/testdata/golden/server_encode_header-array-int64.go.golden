// EncodeMethodHeaderArrayInt64Response returns an encoder for responses
// returned by the ServiceHeaderArrayInt64 MethodHeaderArrayInt64 endpoint.
func EncodeMethodHeaderArrayInt64Response(encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder) func(context.Context, http.ResponseWriter, any) error {
	return func(ctx context.Context, w http.ResponseWriter, v any) error {
		res, ok := v.(*serviceheaderarrayint64.MethodHeaderArrayInt64Result)
		if !ok {
			return loomhttp.ErrInvalidType("ServiceHeaderArrayInt64", "MethodHeaderArrayInt64", "*serviceheaderarrayint64.MethodHeaderArrayInt64Result", v)
		}
		if res.H != nil {
			val := res.H
			var hs []string
			if val != nil {
				hs = make([]string, len(val))
				for i, e := range val {
					hs[i] = strconv.FormatInt(e, 10)
				}
			}
			if err := loomhttp.SetHeaderValues(w.Header(), "H", hs); err != nil {
				return err
			}
		}
		w.WriteHeader(http.StatusOK)
		return nil
	}
}
