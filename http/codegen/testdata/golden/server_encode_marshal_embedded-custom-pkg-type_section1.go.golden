// marshalFooFooToFooResponseBody builds a value of type *FooResponseBody from
// a value of type *foo.Foo.
func marshalFooFooToFooResponseBody(v *foo.Foo) *FooResponseBody {
	if v == nil {
		return nil
	}
	res := &FooResponseBody{}
	if v.Bar != nil {
		resBarValue := *v.Bar
		res.Bar = loom.OptionalValue(resBarValue)
	}

	return res
}
