// DecodeMethodPathStringRequest returns a decoder for requests sent to the
// ServicePathString MethodPathString endpoint.
func DecodeMethodPathStringRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicepathstring.MethodPathStringPayload, error) {
	return func(r *http.Request) (*servicepathstring.MethodPathStringPayload, error) {
		var payload *servicepathstring.MethodPathStringPayload
		var (
			p   string
			err error

			params = mux.Vars(r)
		)
		p = params["p"]
		if err != nil {
			return payload, err
		}
		payload = NewMethodPathStringPayload(p)

		return payload, nil
	}
}
