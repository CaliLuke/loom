// CreateServerStream implements the mixedresultsservice.CreateServerStream
// interface using Server-Sent Events.
type CreateServerStream struct {
	// writer owns the serialized SSE response lifecycle.
	writer *loomhttp.SSEStreamWriter
}

// Send streams instances of "mixedresultsservice.Event" to the "Create"
// endpoint SSE connection.
func (s *CreateServerStream) Send(v *mixedresultsservice.Event) error {
	return s.SendWithContext(s.writer.Context(), v)
}

func (s *CreateServerStream) started() bool {
	return s.writer.Started()
}

// Open commits and flushes the successful SSE response before the first event.
func (s *CreateServerStream) Open(ctx context.Context) error {
	return s.writer.Open(ctx)
}

// SendComment writes and flushes an SSE heartbeat comment.
func (s *CreateServerStream) SendComment(ctx context.Context, text string) error {
	return s.writer.SendComment(ctx, text)
}

// SendWithContext streams instances of "mixedresultsservice.Event" to the
// "Create" endpoint SSE connection with context.
func (s *CreateServerStream) SendWithContext(ctx context.Context, v *mixedresultsservice.Event) error {
	if err := ctx.Err(); err != nil {
		return err
	}
	res := v

	var payload any
	payload = res
	data, err := loomhttp.EncodeSSEData(payload)
	if err != nil {
		return err
	}

	msg := loomhttp.SSEMessage{Data: data}

	return s.writer.WriteEvent(ctx, func(w io.Writer) error {
		return loomhttp.WriteSSEEvent(w, msg)
	})
}

// Close prevents later SSE control or event writes.
func (s *CreateServerStream) Close() error {
	return s.writer.Close()
}
