				if err2 != nil {
					err = loom.MergeErrors(err, loom.InvalidFieldTypeError("q", qRaw, "array of floats"))
				}
				q[i] = float32(v)
			}
		}
		if len(q) < 1 {
			err = loom.MergeErrors(err, loom.InvalidLengthError("q", q, len(q), 1, true))
		}
		for _, e := range q {
			if e < 1 {
				err = loom.MergeErrors(err, loom.InvalidRangeError("q[*]", e, 1, true))
			}
		}
		if err != nil {
