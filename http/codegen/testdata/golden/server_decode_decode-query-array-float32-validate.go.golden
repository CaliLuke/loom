func DecodeMethodQueryArrayFloat32ValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequeryarrayfloat32validate.MethodQueryArrayFloat32ValidatePayload, error) {
	return func(r *http.Request) (*servicequeryarrayfloat32validate.MethodQueryArrayFloat32ValidatePayload, error) {
		var payload *servicequeryarrayfloat32validate.MethodQueryArrayFloat32ValidatePayload
		var (
