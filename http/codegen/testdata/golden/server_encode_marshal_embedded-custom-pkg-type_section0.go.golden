// unmarshalFooRequestBodyToFooFoo builds a value of type *foo.Foo from a value
// of type *FooRequestBody.
func unmarshalFooRequestBodyToFooFoo(v *FooRequestBody) *foo.Foo {
	if v == nil {
		return nil
	}
	res := &foo.Foo{}
	if actual, ok := v.Bar.Value(); ok {
		resBarValue := actual

		res.Bar = &resBarValue
	}

	return res
}
