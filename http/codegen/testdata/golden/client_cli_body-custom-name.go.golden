// BuildMethodBodyCustomNamePayload builds the payload for the
// ServiceBodyCustomName MethodBodyCustomName endpoint from CLI flags.
func BuildMethodBodyCustomNamePayload(serviceBodyCustomNameMethodBodyCustomNameBody string) (*servicebodycustomname.MethodBodyCustomNamePayload, error) {
	var err error
	var body CLIMethodBodyCustomNameRequestBody
	{
		err = loomhttpcli.UnmarshalNonNullableJSON([]byte(serviceBodyCustomNameMethodBodyCustomNameBody), &body)
		if err != nil {
			return nil, fmt.Errorf("invalid JSON for body, \nerror: %w, \nexample of valid JSON:\n%s", err, "'{\n      \"b\": \"Architecto dignissimos ratione illo.\"\n   }'")
		}
	}
	v := &servicebodycustomname.MethodBodyCustomNamePayload{}
	if actual, ok := body.Body.Value(); ok {
		vBodyValue := actual

		v.Body = &vBodyValue
	}

	return v, nil
}
