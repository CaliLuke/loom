// DecodeMethodQueryArrayBytesRequest returns a decoder for requests sent to
// the ServiceQueryArrayBytes MethodQueryArrayBytes endpoint.
func DecodeMethodQueryArrayBytesRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequeryarraybytes.MethodQueryArrayBytesPayload, error) {
	return func(r *http.Request) (*servicequeryarraybytes.MethodQueryArrayBytesPayload, error) {
		var payload *servicequeryarraybytes.MethodQueryArrayBytesPayload
		var (
			q   [][]byte
			err error
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp["q"]
			if qRaw != nil {
				q = make([][]byte, len(qRaw))
				for i, rv := range qRaw {
					q[i] = []byte(rv)
				}
			}
		}
		for i, e := range q {
			if e == nil {
				err = loom.MergeErrors(err, loom.InvalidNullElementError("q", i))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodQueryArrayBytesPayload(q)

		return payload, nil
	}
}
