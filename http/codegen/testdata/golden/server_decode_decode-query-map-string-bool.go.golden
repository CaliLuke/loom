// DecodeMethodQueryMapStringBoolRequest returns a decoder for requests sent to
// the ServiceQueryMapStringBool MethodQueryMapStringBool endpoint.
func DecodeMethodQueryMapStringBoolRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (*servicequerymapstringbool.MethodQueryMapStringBoolPayload, error) {
	return func(r *http.Request) (*servicequerymapstringbool.MethodQueryMapStringBoolPayload, error) {
		var payload *servicequerymapstringbool.MethodQueryMapStringBoolPayload
		var (
			q   map[string]bool
			err error
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			qRaw := qp
			qHasValues := false
			for keyRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					qHasValues = true
					break
				}
			}
			if qHasValues {
				for keyRaw, valRaw := range qRaw {
					if strings.HasPrefix(keyRaw, "q[") {
						if q == nil {
							q = make(map[string]bool)
						}
						var keya string
						var keyaErr error
						{
							openIdx := strings.IndexRune(keyRaw, '[')
							closeIdx := strings.IndexRune(keyRaw, ']')
							if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
								keyaErr = loom.DecodePayloadError("invalid query string: malformed brackets")
								err = loom.MergeErrors(err, keyaErr)
							} else {
								keya = keyRaw[openIdx+1 : closeIdx]
							}
						}
						if keyaErr != nil {
							continue
						}
						var vala bool
						{
							valaRaw := valRaw[0]
							v, err2 := strconv.ParseBool(valaRaw)
							if err2 != nil {
								err = loom.MergeErrors(err, loom.InvalidFieldTypeError("query", valaRaw, "boolean"))
							}
							vala = v
						}
						q[keya] = vala
					}
				}
			}
		}
		if err != nil {
			return payload, err
		}
		payload = NewMethodQueryMapStringBoolPayload(q)

		return payload, nil
	}
}
