// DecodeMethodFormBodyObjectRequest returns a decoder for requests sent to the
// ServiceFormBodyObject MethodFormBodyObject endpoint.
func DecodeMethodFormBodyObjectRequest(mux goahttp.Muxer, decoder func(*http.Request) goahttp.Decoder) func(*http.Request) (*serviceformbodyobject.MethodFormBodyObjectPayload, error) {
	return func(r *http.Request) (*serviceformbodyobject.MethodFormBodyObjectPayload, error) {
		var payload *serviceformbodyobject.MethodFormBodyObjectPayload
		var (
			body MethodFormBodyObjectRequestBody
			err  error
		)
		if err = r.ParseForm(); err != nil {
			return payload, goa.DecodePayloadError(err.Error())
		}
		if len(r.PostForm) == 0 {
			return payload, goa.MissingPayloadError()
		} else {
			if _, err = goahttp.DecodeFormValue(r.PostForm, "", &body); err != nil {
				var gerr *goa.ServiceError
				if errors.As(err, &gerr) {
					return payload, gerr
				}
				return payload, goa.DecodePayloadError(err.Error())
			}
		}
		err = ValidateMethodFormBodyObjectRequestBody(&body)
		if err != nil {
			return payload, err
		}
		payload = NewMethodFormBodyObjectPayload(&body)

		return payload, nil
	}
}
