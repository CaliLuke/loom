import "regexp"

// DecodeMethodQueryPrimitiveMapStringArrayStringValidateRequest returns a
// decoder for requests sent to the
// ServiceQueryPrimitiveMapStringArrayStringValidate
// MethodQueryPrimitiveMapStringArrayStringValidate endpoint.
func DecodeMethodQueryPrimitiveMapStringArrayStringValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (map[string][]string, error) {
	return func(r *http.Request) (map[string][]string, error) {
		var payload map[string][]string
		var err error
		var (
			q map[string][]string
		)
		qp, queryErr := url.ParseQuery(r.URL.RawQuery)
		if queryErr != nil {
			return payload, loom.DecodePayloadError("invalid query string")
		}
		{
			var decoded map[string]loom.Optional[[]loom.Optional[string]]
			present, decodeErr := loomhttp.DecodeJSONField(qp, "q", &decoded)
			if decodeErr != nil {
				return payload, loom.DecodePayloadError(loomhttp.SafeDecodePayloadMessage(decodeErr))
			}
			if present {
				if decoded != nil {
					q = make(map[string][]string, len(decoded))
					for key, val := range decoded {
						actual, ok := val.Value()
						if !ok {
							continue
						}
						tk := key
						var tv []string
						if actual != nil {
							tv = make([]string, len(actual))
							for i, val := range actual {
								actual, ok := val.Value()
								if !ok {
									continue
								}
								tv[i] = actual
							}
						}
						q[tk] = tv
					}
				} else {
					q = nil
				}
			}
			if !present {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
		}
		if len(q) < 1 {
			err = loom.MergeErrors(err, loom.InvalidLengthError("q", len(q), 1, true))
		}
		for k, v := range q {
			err = loom.MergeErrors(err, loom.ValidatePatternCompiled("q.key", k, loomPatternTest0))
			if len(v) < 2 {
				err = loom.MergeErrors(err, loom.InvalidLengthError("q[key]", len(v), 2, true))
			}
			for _, e := range v {
				err = loom.MergeErrors(err, loom.ValidatePatternCompiled("q[key][*]", e, loomPatternTest1))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = q

		return payload, nil
	}
}

var (
	loomPatternTest0 = regexp.MustCompile("key")
	loomPatternTest1 = regexp.MustCompile("val")
)
