// DecodeMethodQueryMapIntMapStringArrayIntValidateRequest returns a decoder
// for requests sent to the ServiceQueryMapIntMapStringArrayIntValidate
// MethodQueryMapIntMapStringArrayIntValidate endpoint.
func DecodeMethodQueryMapIntMapStringArrayIntValidateRequest(mux loomhttp.Muxer, _ func(*http.Request) loomhttp.Decoder) func(*http.Request) (map[int]map[string][]int, error) {
	return func(r *http.Request) (map[int]map[string][]int, error) {
		var payload map[int]map[string][]int
		var (
			q   map[int]map[string][]int
			err error
		)
		{
			qRaw := r.URL.Query()
			qHasValues := false
			for keyRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					qHasValues = true
					break
				}
			}
			if !qHasValues {
				err = loom.MergeErrors(err, loom.MissingFieldError("q", "query string"))
			}
			for keyRaw, valRaw := range qRaw {
				if strings.HasPrefix(keyRaw, "q[") {
					if q == nil {
						q = make(map[int]map[string][]int)
					}
					var keya int
					var keyaErr error
					{
						openIdx := strings.IndexRune(keyRaw, '[')
						closeIdx := strings.IndexRune(keyRaw, ']')
						if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
							keyaErr = loom.DecodePayloadError("invalid query string: malformed brackets")
							err = loom.MergeErrors(err, keyaErr)
						} else {
							keyaRaw := keyRaw[openIdx+1 : closeIdx]
							v, err2 := strconv.ParseInt(keyaRaw, 10, strconv.IntSize)
							if err2 != nil {
								keyaErr = loom.InvalidFieldTypeError("query", keyaRaw, "integer")
								err = loom.MergeErrors(err, keyaErr)
							}
							keya = int(v)
							keyRaw = keyRaw[closeIdx+1:]
						}
					}
					if keyaErr != nil {
						continue
					}
					if q[keya] == nil {
						q[keya] = make(map[string][]int)
					}
					var keyb string
					var keybErr error
					{
						openIdx := strings.IndexRune(keyRaw, '[')
						closeIdx := strings.IndexRune(keyRaw, ']')
						if openIdx == -1 || closeIdx == -1 || closeIdx <= openIdx {
							keybErr = loom.DecodePayloadError("invalid query string: malformed brackets")
							err = loom.MergeErrors(err, keybErr)
						} else {
							keyb = keyRaw[openIdx+1 : closeIdx]
						}
					}
					if keybErr != nil {
						continue
					}
					var val []int
					{
						val = make([]int, len(valRaw))
						for i, rv := range valRaw {
							v, err2 := strconv.ParseInt(rv, 10, strconv.IntSize)
							if err2 != nil {
								err = loom.MergeErrors(err, loom.InvalidFieldTypeError("query", valRaw, "array of integers"))
							}
							val[i] = int(v)
						}
					}
					q[keya][keyb] = val
				}
			}
		}
		for k, _ := range q {
			if !(k == 1 || k == 2 || k == 3) {
				err = loom.MergeErrors(err, loom.InvalidEnumValueError("q.key", k, []any{1, 2, 3}))
			}
		}
		if err != nil {
			return payload, err
		}
		payload = q

		return payload, nil
	}
}
