{
  "openapi": "3.1.1",
  "info": {
    "title": "Pet API",
    "description": "A small import fixture.",
    "version": "1.2.3"
  },
  "paths": {
    "/pets/{id}": {
      "get": {
        "operationId": "pets.get",
        "summary": "Get a pet",
        "description": "Returns one pet.",
        "tags": ["pets"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Found pet.",
            "headers": {
              "X-Trace-ID": {
                "description": "Request trace identifier.",
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Pet"}
              }
            }
          },
          "404": {
            "description": "Pet was not found.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Problem"}
              }
            }
          }
        }
      }
    },
    "/pets": {
      "post": {
        "operationId": "pets.create",
        "tags": ["pets"],
        "requestBody": {
          "required": true,
          "description": "Pet to create.",
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/NewPet"}
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created pet.",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/Pet"}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewPet": {
        "type": "object",
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 80},
          "kind": {"type": "string", "enum": ["cat", "dog"]}
        },
        "required": ["name"],
        "additionalProperties": false
      },
      "Pet": {
        "type": "object",
        "properties": {
          "id": {"type": "integer", "format": "int64"},
          "name": {"type": "string"},
          "labels": {"type": "array", "items": {"type": "string"}}
        },
        "required": ["id", "name"]
      },
      "Problem": {
        "type": "object",
        "properties": {"detail": {"type": "string"}},
        "required": ["detail"]
      }
    }
  }
}
