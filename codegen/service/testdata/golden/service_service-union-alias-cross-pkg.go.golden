
// Service is the UnionWithAliasCrossPkg service interface.
type Service interface {
	// A implements A.
	A(context.Context, *Scope) (res *Scope, err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "UnionWithAliasCrossPkg"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [1]string{"A"}

// Scope is the payload type of the UnionWithAliasCrossPkg service A method.
type Scope struct {
	Values *Values `json:"Values,omitempty"`
}

// Values is a sum-type union.
type Values struct {
	kind   ValuesKind
	Device alias.Alias
	Metric alias.Alias
}

// ValuesKind enumerates the union variants for Values.
type ValuesKind string

const (
	// ValuesKindDevice identifies the Device branch of the union.
	ValuesKindDevice ValuesKind = "Device"
	// ValuesKindMetric identifies the Metric branch of the union.
	ValuesKindMetric ValuesKind = "Metric"
)

// Kind returns the discriminator value of the union.
func (u Values) Kind() ValuesKind {
	return u.kind
}

// NewValuesDevice constructs a Values with the Device branch set.
func NewValuesDevice(v alias.Alias) Values {
	return Values{
		kind:   ValuesKindDevice,
		Device: v,
	}
}

// AsDevice returns the value of the Device branch if set.
func (u Values) AsDevice() (_ alias.Alias, ok bool) {
	if u.kind != ValuesKindDevice {
		return
	}
	return u.Device, true
}

// SetDevice sets the Device branch of the union.
func (u *Values) SetDevice(v alias.Alias) {
	u.kind = ValuesKindDevice
	u.Device = v
}

// NewValuesMetric constructs a Values with the Metric branch set.
func NewValuesMetric(v alias.Alias) Values {
	return Values{
		kind:   ValuesKindMetric,
		Metric: v,
	}
}

// AsMetric returns the value of the Metric branch if set.
func (u Values) AsMetric() (_ alias.Alias, ok bool) {
	if u.kind != ValuesKindMetric {
		return
	}
	return u.Metric, true
}

// SetMetric sets the Metric branch of the union.
func (u *Values) SetMetric(v alias.Alias) {
	u.kind = ValuesKindMetric
	u.Metric = v
}

// Validate ensures the union discriminant is valid.
func (u Values) Validate() error {
	switch u.kind {
	case "":
		return loom.InvalidEnumValueError("type", "", []any{
			string(ValuesKindDevice),
			string(ValuesKindMetric),
		})
	case ValuesKindDevice:
		return nil
	case ValuesKindMetric:
		return nil
	default:
		return loom.InvalidEnumValueError("type", u.kind, []any{
			string(ValuesKindDevice),
			string(ValuesKindMetric),
		})
	}
}

// MarshalJSON marshals the union into the canonical {type,value} JSON shape.
func (u Values) MarshalJSON() ([]byte, error) {
	if err := u.Validate(); err != nil {
		return nil, err
	}
	var (
		value any
	)
	switch u.kind {
	case ValuesKindDevice:
		value = u.Device
	case ValuesKindMetric:
		value = u.Metric
	default:
		return nil, fmt.Errorf("unexpected Values discriminant %q", u.kind)
	}
	return json.Marshal(struct {
		Type  string `json:"type"`
		Value any    `json:"value"`
	}{
		Type:  string(u.kind),
		Value: value,
	})
}

// MarshalFormValues marshals the union into application/x-www-form-urlencoded
// values using the discriminator field plus flattened object fields for
// object-shaped branches and the canonical {type,value} form shape for scalar
// branches.
func (u Values) MarshalFormValues(values url.Values, prefix string) error {
	if err := u.Validate(); err != nil {
		return err
	}
	values.Set(loomhttp.FormChildKey(prefix, "type"), string(u.kind))
	switch u.kind {
	case ValuesKindDevice:
		_, err := loomhttp.EncodeFormValue(values, loomhttp.FormChildKey(prefix, "value"), u.Device)
		return err
	case ValuesKindMetric:
		_, err := loomhttp.EncodeFormValue(values, loomhttp.FormChildKey(prefix, "value"), u.Metric)
		return err
	default:
		return fmt.Errorf("unexpected Values discriminant %q", u.kind)
	}
}

// UnmarshalFormValues unmarshals the union from application/x-www-form-urlencoded
// values using the discriminator field plus flattened object fields for
// object-shaped branches and the canonical {type,value} form shape for scalar
// branches.
func (u *Values) UnmarshalFormValues(values url.Values, prefix string) error {
	typeKey := loomhttp.FormChildKey(prefix, "type")
	valueKey := loomhttp.FormChildKey(prefix, "value")
	rawType := values.Get(typeKey)
	if rawType == "" {
		return loom.MissingFieldError("type", "body")
	}
	switch rawType {
	case string(ValuesKindDevice):
		var v alias.Alias
		seen, err := loomhttp.DecodeFormValue(values, valueKey, &v)
		if err != nil {
			return err
		}
		if !seen {
			return loom.MissingFieldError("value", "body")
		}
		u.kind = ValuesKindDevice
		u.Device = v
	case string(ValuesKindMetric):
		var v alias.Alias
		seen, err := loomhttp.DecodeFormValue(values, valueKey, &v)
		if err != nil {
			return err
		}
		if !seen {
			return loom.MissingFieldError("value", "body")
		}
		u.kind = ValuesKindMetric
		u.Metric = v
	default:
		return loom.InvalidEnumValueError("type", rawType, []any{
			string(ValuesKindDevice),
			string(ValuesKindMetric),
		})
	}
	return nil
}

// UnmarshalJSON unmarshals the union from the canonical {type,value} JSON shape.
func (u *Values) UnmarshalJSON(data []byte) error {
	var raw struct {
		Type  string         `json:"type"`
		Value jsontext.Value `json:"value"`
	}
	if err := json.Unmarshal(data, &raw); err != nil {
		return err
	}
	switch raw.Type {
	case string(ValuesKindDevice):
		var v alias.Alias
		if len(raw.Value) == 0 || string(raw.Value) == "null" {
			return loom.MissingFieldError("value", "body")
		}
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.kind = ValuesKindDevice
		u.Device = v
	case string(ValuesKindMetric):
		var v alias.Alias
		if len(raw.Value) == 0 || string(raw.Value) == "null" {
			return loom.MissingFieldError("value", "body")
		}
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.kind = ValuesKindMetric
		u.Metric = v
	default:
		return loom.InvalidEnumValueError("type", raw.Type, []any{
			string(ValuesKindDevice),
			string(ValuesKindMetric),
		})
	}
	return nil
}
