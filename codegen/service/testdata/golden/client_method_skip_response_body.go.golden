// Download calls the "Download" endpoint of the "DownloadService" service.
func (c *Client) Download(ctx context.Context) (res *DownloadResult, resp io.ReadCloser, err error) {
	var ires any
	ires, err = c.DownloadEndpoint(ctx, nil)
	if err != nil {
		return
	}
	o := ires.(*DownloadResponseData)
	return o.Result, o.Body, nil
}
