// NewRT2FromRT2View converts projected type RT2View to service type RT2.
func NewRT2FromRT2View(vres *resultwithresulttypecollectionviews.RT2View) *RT2 {
	res := &RT2{}
	if vres.C != nil {
		res.C = *vres.C
	}
	if vres.D != nil {
		res.D = *vres.D
	}
	return res
}

// NewRT2FromRT2ViewExtended converts projected type RT2View to service type
