
// Service is the ResultWithResultTypeCollection service interface.
type Service interface {
	// A implements A.
	// The "view" return value must have one of the following views
	//   - "default"
	//   - "extended"
	//   - "tiny"
	A(context.Context) (res *RT, view string, err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "ResultWithResultTypeCollection"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [1]string{"A"}

// RT is the result type of the ResultWithResultTypeCollection service A method.
type RT struct {
	A RT2Collection `json:"a,omitempty"`
}

type RT2 struct {
	C string  `json:"c"`
	D int     `json:"d"`
	E *string `json:"e,omitempty"`
}

type RT2Collection []*RT2

// NewRT initializes result type RT from viewed result type RT.
func NewRT(vres *resultwithresulttypecollectionviews.RT) *RT {

	var res *RT
	switch vres.View {
	case "default", "":
		res = NewRTFromRTView(vres.Projected)
	case "extended":
		res = NewRTFromRTViewExtended(vres.Projected)
	case "tiny":
		res = NewRTFromRTViewTiny(vres.Projected)
	default:
		panic(loom.InvalidEnumValueError("view", vres.View, []any{
			"default",
			"extended",
			"tiny",
		}))
	}
	return res
}

// NewViewedRT initializes viewed result type RT from result type RT using the
// given view.
func NewViewedRT(res *RT, view string) *resultwithresulttypecollectionviews.RT {

	var vres *resultwithresulttypecollectionviews.RT
	switch view {
	case "default", "":
		p := ProjectRT(res)
		vres = &resultwithresulttypecollectionviews.RT{Projected: p, View: "default"}
	case "extended":
		p := ProjectRTExtended(res)
		vres = &resultwithresulttypecollectionviews.RT{Projected: p, View: "extended"}
	case "tiny":
		p := ProjectRTTiny(res)
		vres = &resultwithresulttypecollectionviews.RT{Projected: p, View: "tiny"}
	default:
		panic(loom.InvalidEnumValueError("view", view, []any{
			"default",
			"extended",
			"tiny",
		}))
	}
	return vres
}

// NewRTFromRTView converts projected type RTView to service type RT.
func NewRTFromRTView(vres *resultwithresulttypecollectionviews.RTView) *RT {
	res := &RT{}
	if vres.A != nil {
		res.A = newRT2Collection(vres.A)
	}
	return res
}

// NewRTFromRTViewExtended converts projected type RTView to service type RT.
func NewRTFromRTViewExtended(vres *resultwithresulttypecollectionviews.RTView) *RT {
	res := &RT{}
	if vres.A != nil {
		res.A = newRT2CollectionExtended(vres.A)
	}
	return res
}

// NewRTFromRTViewTiny converts projected type RTView to service type RT.
func NewRTFromRTViewTiny(vres *resultwithresulttypecollectionviews.RTView) *RT {
	res := &RT{}
	if vres.A != nil {
		res.A = newRT2CollectionTiny(vres.A)
	}
	return res
}

// ProjectRT projects result type RT to projected type RTView using the
// "default" view.
func ProjectRT(res *RT) *resultwithresulttypecollectionviews.RTView {
	vres := &resultwithresulttypecollectionviews.RTView{}
	if res.A != nil {
		vres.A = newRT2CollectionView(res.A)
	}
	return vres
}

// ProjectRTExtended projects result type RT to projected type RTView using the
// "extended" view.
func ProjectRTExtended(res *RT) *resultwithresulttypecollectionviews.RTView {
	vres := &resultwithresulttypecollectionviews.RTView{}
	if res.A != nil {
		vres.A = newRT2CollectionViewExtended(res.A)
	}
	return vres
}

// ProjectRTTiny projects result type RT to projected type RTView using the
// "tiny" view.
func ProjectRTTiny(res *RT) *resultwithresulttypecollectionviews.RTView {
	vres := &resultwithresulttypecollectionviews.RTView{}
	if res.A != nil {
		vres.A = newRT2CollectionViewTiny(res.A)
	}
	return vres
}

// NewRT2CollectionFromRT2CollectionView converts projected type
// RT2CollectionView to service type RT2Collection.
func NewRT2CollectionFromRT2CollectionView(vres resultwithresulttypecollectionviews.RT2CollectionView) RT2Collection {
	res := make(RT2Collection, len(vres))
	for i, n := range vres {
		res[i] = newRT2(n)
	}
	return res
}

// NewRT2CollectionFromRT2CollectionViewExtended converts projected type
// RT2CollectionView to service type RT2Collection.
func NewRT2CollectionFromRT2CollectionViewExtended(vres resultwithresulttypecollectionviews.RT2CollectionView) RT2Collection {
