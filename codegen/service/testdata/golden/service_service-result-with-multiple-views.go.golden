// NewMultipleViewsFromMultipleViewsView converts projected type
// MultipleViewsView to service type MultipleViews.
func NewMultipleViewsFromMultipleViewsView(vres *multiplemethodsresultmultipleviewsviews.MultipleViewsView) *MultipleViews {
	res := &MultipleViews{
		A: vres.A,
