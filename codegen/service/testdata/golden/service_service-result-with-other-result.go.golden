
// Service is the ResultWithOtherResult service interface.
type Service interface {
	// A implements A.
	// The "view" return value must have one of the following views
	//	- "default"
	//	- "tiny"
	A(context.Context) (res *MultipleViews, view string, err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "ResultWithOtherResult"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [1]string{"A"}

// MultipleViews is the result type of the ResultWithOtherResult service A
// method.
type MultipleViews struct {
	A string          `json:"a"`
	B *MultipleViews2 `json:"b"`
}

type MultipleViews2 struct {
	A string  `json:"a"`
	B *string `json:"b,omitempty"`
}

// NewMultipleViews initializes result type MultipleViews from viewed result
// type MultipleViews.
func NewMultipleViews(vres *resultwithotherresultviews.MultipleViews) *MultipleViews {

	var res *MultipleViews
	switch vres.View {
	case "default", "":
		res = NewMultipleViewsFromMultipleViewsView(vres.Projected)
	case "tiny":
		res = NewMultipleViewsFromMultipleViewsViewTiny(vres.Projected)
	default:
		panic(loom.InvalidEnumValueError("view", vres.View, []any{
			"default",
			"tiny",
		}))
	}
	return res
}

// NewViewedMultipleViews initializes viewed result type MultipleViews from
// result type MultipleViews using the given view.
func NewViewedMultipleViews(res *MultipleViews, view string) *resultwithotherresultviews.MultipleViews {

	var vres *resultwithotherresultviews.MultipleViews
	switch view {
	case "default", "":
		p := ProjectMultipleViews(res)
		vres = &resultwithotherresultviews.MultipleViews{Projected: p, View: "default"}
	case "tiny":
		p := ProjectMultipleViewsTiny(res)
		vres = &resultwithotherresultviews.MultipleViews{Projected: p, View: "tiny"}
	default:
		panic(loom.InvalidEnumValueError("view", view, []any{
			"default",
			"tiny",
		}))
	}
	return vres
}

// NewMultipleViewsFromMultipleViewsView converts projected type
// MultipleViewsView to service type MultipleViews.
func NewMultipleViewsFromMultipleViewsView(vres *resultwithotherresultviews.MultipleViewsView) *MultipleViews {
	res := &MultipleViews{}
	if vres.A != nil {
		res.A = *vres.A
	}
	if vres.B != nil {
		res.B = newMultipleViews2(vres.B)
	}
	return res
}

// NewMultipleViewsFromMultipleViewsViewTiny converts projected type
// MultipleViewsView to service type MultipleViews.
func NewMultipleViewsFromMultipleViewsViewTiny(vres *resultwithotherresultviews.MultipleViewsView) *MultipleViews {
	res := &MultipleViews{}
	if vres.A != nil {
		res.A = *vres.A
	}
	if vres.B != nil {
		res.B = newMultipleViews2(vres.B)
	}
	return res
}

// ProjectMultipleViews projects result type MultipleViews to projected type
// MultipleViewsView using the "default" view.
func ProjectMultipleViews(res *MultipleViews) *resultwithotherresultviews.MultipleViewsView {
	vres := &resultwithotherresultviews.MultipleViewsView{
		A: &res.A,
	}
	if res.B != nil {
		vres.B = newMultipleViews2View(res.B)
	}
	return vres
}

// ProjectMultipleViewsTiny projects result type MultipleViews to projected
// type MultipleViewsView using the "tiny" view.
func ProjectMultipleViewsTiny(res *MultipleViews) *resultwithotherresultviews.MultipleViewsView {
	vres := &resultwithotherresultviews.MultipleViewsView{
		A: &res.A,
	}
	return vres
}

// NewMultipleViews2FromMultipleViews2View converts projected type
// MultipleViews2View to service type MultipleViews2.
func NewMultipleViews2FromMultipleViews2View(vres *resultwithotherresultviews.MultipleViews2View) *MultipleViews2 {
	res := &MultipleViews2{
		B: vres.B,
	}
	if vres.A != nil {
		res.A = *vres.A
	}
	return res
}

// NewMultipleViews2FromMultipleViews2ViewTiny converts projected type
// MultipleViews2View to service type MultipleViews2.
func NewMultipleViews2FromMultipleViews2ViewTiny(vres *resultwithotherresultviews.MultipleViews2View) *MultipleViews2 {
	res := &MultipleViews2{}
	if vres.A != nil {
		res.A = *vres.A
	}
	return res
}

// ProjectMultipleViews2 projects result type MultipleViews2 to projected type
// MultipleViews2View using the "default" view.
func ProjectMultipleViews2(res *MultipleViews2) *resultwithotherresultviews.MultipleViews2View {
	vres := &resultwithotherresultviews.MultipleViews2View{
		A: &res.A,
		B: res.B,
	}
	return vres
}

// ProjectMultipleViews2Tiny projects result type MultipleViews2 to projected
// type MultipleViews2View using the "tiny" view.
func ProjectMultipleViews2Tiny(res *MultipleViews2) *resultwithotherresultviews.MultipleViews2View {
	vres := &resultwithotherresultviews.MultipleViews2View{
		A: &res.A,
	}
	return vres
}
