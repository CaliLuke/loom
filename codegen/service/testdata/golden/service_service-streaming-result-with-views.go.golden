
// Service is the StreamingResultWithViewsService service interface.
type Service interface {
	// StreamingResultWithViewsMethod implements StreamingResultWithViewsMethod.
	// The "view" return value must have one of the following views
	//	- "default"
	//	- "tiny"
	StreamingResultWithViewsMethod(context.Context, string, StreamingResultWithViewsMethodServerStream) (err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "StreamingResultWithViewsService"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [1]string{"StreamingResultWithViewsMethod"}

// StreamingResultWithViewsMethodServerStream allows streaming instances of
// *MultipleViews to the client.
type StreamingResultWithViewsMethodServerStream interface {
	// Send streams instances of "MultipleViews".
	Send(*MultipleViews) error
	// SendWithContext streams instances of "MultipleViews" with context.
	SendWithContext(context.Context, *MultipleViews) error
	// Close closes the stream.
	Close() error
	// SetView sets the view used to render the result before streaming.
	SetView(view string)
}

// StreamingResultWithViewsMethodClientStream allows streaming instances of
// *MultipleViews to the client.
type StreamingResultWithViewsMethodClientStream interface {
	// Recv reads instances of "MultipleViews" from the stream.
	Recv() (*MultipleViews, error)
	// RecvWithContext reads instances of "MultipleViews" from the stream with
	// context.
	RecvWithContext(context.Context) (*MultipleViews, error)
}

// MultipleViews is the result type of the StreamingResultWithViewsService
// service StreamingResultWithViewsMethod method.
type MultipleViews struct {
	A *string `json:"a,omitempty"`
	B *string `json:"b,omitempty"`
}

// NewMultipleViews initializes result type MultipleViews from viewed result
// type MultipleViews.
func NewMultipleViews(vres *streamingresultwithviewsserviceviews.MultipleViews) *MultipleViews {

	var res *MultipleViews
	switch vres.View {
	case "default", "":
		res = NewMultipleViewsFromMultipleViewsView(vres.Projected)
	case "tiny":
		res = NewMultipleViewsFromMultipleViewsViewTiny(vres.Projected)
	default:
		panic(loom.InvalidEnumValueError("view", vres.View, []any{
			"default",
			"tiny",
		}))
	}
	return res
}

// NewViewedMultipleViews initializes viewed result type MultipleViews from
// result type MultipleViews using the given view.
func NewViewedMultipleViews(res *MultipleViews, view string) *streamingresultwithviewsserviceviews.MultipleViews {

	var vres *streamingresultwithviewsserviceviews.MultipleViews
	switch view {
	case "default", "":
		p := ProjectMultipleViews(res)
		vres = &streamingresultwithviewsserviceviews.MultipleViews{Projected: p, View: "default"}
	case "tiny":
		p := ProjectMultipleViewsTiny(res)
		vres = &streamingresultwithviewsserviceviews.MultipleViews{Projected: p, View: "tiny"}
	default:
		panic(loom.InvalidEnumValueError("view", view, []any{
			"default",
			"tiny",
		}))
	}
	return vres
}

// NewMultipleViewsFromMultipleViewsView converts projected type
// MultipleViewsView to service type MultipleViews.
func NewMultipleViewsFromMultipleViewsView(vres *streamingresultwithviewsserviceviews.MultipleViewsView) *MultipleViews {
	res := &MultipleViews{
		A: vres.A,
		B: vres.B,
	}
	return res
}

// NewMultipleViewsFromMultipleViewsViewTiny converts projected type
// MultipleViewsView to service type MultipleViews.
func NewMultipleViewsFromMultipleViewsViewTiny(vres *streamingresultwithviewsserviceviews.MultipleViewsView) *MultipleViews {
	res := &MultipleViews{
		A: vres.A,
	}
	return res
}

// ProjectMultipleViews projects result type MultipleViews to projected type
// MultipleViewsView using the "default" view.
func ProjectMultipleViews(res *MultipleViews) *streamingresultwithviewsserviceviews.MultipleViewsView {
	vres := &streamingresultwithviewsserviceviews.MultipleViewsView{
		A: res.A,
		B: res.B,
	}
	return vres
}

// ProjectMultipleViewsTiny projects result type MultipleViews to projected
// type MultipleViewsView using the "tiny" view.
func ProjectMultipleViewsTiny(res *MultipleViews) *streamingresultwithviewsserviceviews.MultipleViewsView {
	vres := &streamingresultwithviewsserviceviews.MultipleViewsView{
		A: res.A,
	}
	return vres
}
