
// Service is the MultiUnionService service interface.
type Service interface {
	// MultiUnion implements MultiUnion.
	MultiUnion(context.Context, *Union) (res *Union, err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "MultiUnionService"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [1]string{"MultiUnion"}

type TypeA struct {
	A *int `json:"a,omitempty"`
}

type TypeB struct {
	B *string `json:"b,omitempty"`
}

// Union is the payload type of the MultiUnionService service MultiUnion method.
type Union struct {
	Values *Values `json:"Values,omitempty"`
}

// Values is a sum-type union.
type Values struct {
	kind ValuesKind
	A    *TypeA
	B    *TypeB
}

// ValuesKind enumerates the union variants for Values.
type ValuesKind string

const (
	// ValuesKindA identifies the a branch of the union.
	ValuesKindA ValuesKind = "a"
	// ValuesKindB identifies the b branch of the union.
	ValuesKindB ValuesKind = "b"
)

// Kind returns the discriminator value of the union.
func (u Values) Kind() ValuesKind {
	return u.kind
}

// NewValuesA constructs a Values with the a branch set.
func NewValuesA(v *TypeA) Values {
	return Values{
		kind: ValuesKindA,
		A:    v,
	}
}

// AsA returns the value of the a branch if set.
func (u Values) AsA() (_ *TypeA, ok bool) {
	if u.kind != ValuesKindA {
		return
	}
	return u.A, true
}

// SetA sets the a branch of the union.
func (u *Values) SetA(v *TypeA) {
	u.kind = ValuesKindA
	u.A = v
}

// NewValuesB constructs a Values with the b branch set.
func NewValuesB(v *TypeB) Values {
	return Values{
		kind: ValuesKindB,
		B:    v,
	}
}

// AsB returns the value of the b branch if set.
func (u Values) AsB() (_ *TypeB, ok bool) {
	if u.kind != ValuesKindB {
		return
	}
	return u.B, true
}

// SetB sets the b branch of the union.
func (u *Values) SetB(v *TypeB) {
	u.kind = ValuesKindB
	u.B = v
}

// Validate ensures the union discriminant is valid.
func (u Values) Validate() error {
	switch u.kind {
	case "":
		return loom.InvalidEnumValueError("type", "", []any{
			string(ValuesKindA),
			string(ValuesKindB),
		})
	case ValuesKindA:
		return nil
	case ValuesKindB:
		return nil
	default:
		return loom.InvalidEnumValueError("type", u.kind, []any{
			string(ValuesKindA),
			string(ValuesKindB),
		})
	}
}

// MarshalJSON marshals the union into the canonical {type,value} JSON shape.
func (u Values) MarshalJSON() ([]byte, error) {
	if err := u.Validate(); err != nil {
		return nil, err
	}
	var (
		value any
	)
	switch u.kind {
	case ValuesKindA:
		value = u.A
	case ValuesKindB:
		value = u.B
	default:
		return nil, fmt.Errorf("unexpected Values discriminant %q", u.kind)
	}
	return json.Marshal(struct {
		Type  string `json:"type"`
		Value any    `json:"value"`
	}{
		Type:  string(u.kind),
		Value: value,
	})
}

// MarshalFormValues marshals the union into application/x-www-form-urlencoded
// values using the discriminator field plus flattened object fields for
// object-shaped branches and the canonical {type,value} form shape for scalar
// branches.
func (u Values) MarshalFormValues(values url.Values, prefix string) error {
	if err := u.Validate(); err != nil {
		return err
	}
	values.Set(loomhttp.FormChildKey(prefix, "type"), string(u.kind))
	switch u.kind {
	case ValuesKindA:
		_, err := loomhttp.EncodeFormValue(values, prefix, u.A)
		return err
	case ValuesKindB:
		_, err := loomhttp.EncodeFormValue(values, prefix, u.B)
		return err
	default:
		return fmt.Errorf("unexpected Values discriminant %q", u.kind)
	}
}

// UnmarshalFormValues unmarshals the union from application/x-www-form-urlencoded
// values using the discriminator field plus flattened object fields for
// object-shaped branches and the canonical {type,value} form shape for scalar
// branches.
func (u *Values) UnmarshalFormValues(values url.Values, prefix string) error {
	typeKey := loomhttp.FormChildKey(prefix, "type")
	rawType := values.Get(typeKey)
	if rawType == "" {
		return loom.MissingFieldError("type", "body")
	}
	switch rawType {
	case string(ValuesKindA):
		var v *TypeA
		seen, err := loomhttp.DecodeFormValue(values, prefix, &v)
		if err != nil {
			return err
		}
		if !seen {
			v = &TypeA{}
		}
		u.kind = ValuesKindA
		u.A = v
	case string(ValuesKindB):
		var v *TypeB
		seen, err := loomhttp.DecodeFormValue(values, prefix, &v)
		if err != nil {
			return err
		}
		if !seen {
			v = &TypeB{}
		}
		u.kind = ValuesKindB
		u.B = v
	default:
		return loom.InvalidEnumValueError("type", rawType, []any{
			string(ValuesKindA),
			string(ValuesKindB),
		})
	}
	return nil
}

// UnmarshalJSON unmarshals the union from the canonical {type,value} JSON shape.
func (u *Values) UnmarshalJSON(data []byte) error {
	var raw struct {
		Type  string          `json:"type"`
		Value json.RawMessage `json:"value"`
	}
	if err := json.Unmarshal(data, &raw); err != nil {
		return err
	}
	switch raw.Type {
	case string(ValuesKindA):
		var v *TypeA
		if len(raw.Value) == 0 || string(raw.Value) == "null" {
			return loom.MissingFieldError("value", "body")
		}
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.kind = ValuesKindA
		u.A = v
	case string(ValuesKindB):
		var v *TypeB
		if len(raw.Value) == 0 || string(raw.Value) == "null" {
			return loom.MissingFieldError("value", "body")
		}
		if err := json.Unmarshal(raw.Value, &v); err != nil {
			return err
		}
		u.kind = ValuesKindB
		u.B = v
	default:
		return loom.InvalidEnumValueError("type", raw.Type, []any{
			string(ValuesKindA),
			string(ValuesKindB),
		})
	}
	return nil
}
