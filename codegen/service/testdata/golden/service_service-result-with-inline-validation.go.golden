// ProjectResultInlineValidation projects result type ResultInlineValidation to
// projected type ResultInlineValidationView using the "default" view.
func ProjectResultInlineValidation(res *ResultInlineValidation) *resultwithinlinevalidationviews.ResultInlineValidationView {
