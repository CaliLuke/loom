// NewResultInlineValidation initializes result type ResultInlineValidation
// from viewed result type ResultInlineValidation.
func NewResultInlineValidation(vres *resultwithinlinevalidationviews.ResultInlineValidation) (*ResultInlineValidation, error) {

	var res *ResultInlineValidation
	switch vres.View {
	case "default", "":
		res = NewResultInlineValidationFromResultInlineValidationView(vres.Projected)
	default:
		err := loom.InvalidEnumValueError("view", vres.View, []any{
			"default",
		})
		return res, err
	}
	return res, nil
}

// NewViewedResultInlineValidation projects result type ResultInlineValidation
// to viewed result type ResultInlineValidation and validates the selected
// view. Invalid views and result constraints return a fault that wraps the
// validation error. It returns a fault error when res is nil.
func NewViewedResultInlineValidation(res *ResultInlineValidation, view string) (*resultwithinlinevalidationviews.ResultInlineValidation, error) {

	var vres *resultwithinlinevalidationviews.ResultInlineValidation
	if res == nil {
		return vres, loom.Fault("missing result")
	}
	switch view {
	case "default", "":
		p := ProjectResultInlineValidation(res)
		vres = &resultwithinlinevalidationviews.ResultInlineValidation{Projected: p, View: "default"}
	default:
		err := loom.InvalidEnumValueError("view", view, []any{
			"default",
		})
		return vres, loom.NewServiceError(err, "fault", false, false, true)
	}
	if err := resultwithinlinevalidationviews.ValidateResultInlineValidation(vres); err != nil {
		var zero *resultwithinlinevalidationviews.ResultInlineValidation
		return zero, loom.NewServiceError(err, "fault", false, false, true)
	}
	return vres, nil
}

