// NewResultInlineValidationFromResultInlineValidationView converts projected
// type ResultInlineValidationView to service type ResultInlineValidation.
func NewResultInlineValidationFromResultInlineValidationView(vres *resultwithinlinevalidationviews.ResultInlineValidationView) *ResultInlineValidation {
