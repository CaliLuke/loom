// MultipleViews is the result type of the
// BidirectionalStreamingResultWithViewsService service
// BidirectionalStreamingResultWithViewsMethod method.
type MultipleViews struct {
	A *string `json:"a,omitempty"`
	B *string `json:"b,omitempty"`
}

// NewMultipleViews initializes result type MultipleViews from viewed result
// type MultipleViews.
func NewMultipleViews(vres *bidirectionalstreamingresultwithviewsserviceviews.MultipleViews) *MultipleViews {

	var res *MultipleViews
	switch vres.View {
	case "default", "":
		res = NewMultipleViewsFromMultipleViewsView(vres.Projected)
	case "tiny":
		res = NewMultipleViewsFromMultipleViewsViewTiny(vres.Projected)
	default:
		panic(goa.InvalidEnumValueError("view", vres.View, []any{
			"default",
			"tiny",
		}))
	}
	return res
}

// NewViewedMultipleViews initializes viewed result type MultipleViews from
// result type MultipleViews using the given view.
func NewViewedMultipleViews(res *MultipleViews, view string) *bidirectionalstreamingresultwithviewsserviceviews.MultipleViews {

	var vres *bidirectionalstreamingresultwithviewsserviceviews.MultipleViews
	switch view {
	case "default", "":
		p := ProjectMultipleViews(res)
		vres = &bidirectionalstreamingresultwithviewsserviceviews.MultipleViews{Projected: p, View: "default"}
	case "tiny":
		p := ProjectMultipleViewsTiny(res)
		vres = &bidirectionalstreamingresultwithviewsserviceviews.MultipleViews{Projected: p, View: "tiny"}
	default:
		panic(goa.InvalidEnumValueError("view", view, []any{
			"default",
			"tiny",
		}))
	}
	return vres
}

// NewMultipleViewsFromMultipleViewsView converts projected type
// MultipleViewsView to service type MultipleViews.
func NewMultipleViewsFromMultipleViewsView(vres *bidirectionalstreamingresultwithviewsserviceviews.MultipleViewsView) *MultipleViews {
	res := &MultipleViews{
		A: vres.A,
		B: vres.B,
	}
	return res
}

// NewMultipleViewsFromMultipleViewsViewTiny converts projected type
// MultipleViewsView to service type MultipleViews.
func NewMultipleViewsFromMultipleViewsViewTiny(vres *bidirectionalstreamingresultwithviewsserviceviews.MultipleViewsView) *MultipleViews {
	res := &MultipleViews{
		A: vres.A,
	}
	return res
}

// ProjectMultipleViews projects result type MultipleViews to projected type
// MultipleViewsView using the "default" view.
func ProjectMultipleViews(res *MultipleViews) *bidirectionalstreamingresultwithviewsserviceviews.MultipleViewsView {
	vres := &bidirectionalstreamingresultwithviewsserviceviews.MultipleViewsView{
		A: res.A,
		B: res.B,
	}
	return vres
}

// ProjectMultipleViewsTiny projects result type MultipleViews to projected
// type MultipleViewsView using the "tiny" view.
func ProjectMultipleViewsTiny(res *MultipleViews) *bidirectionalstreamingresultwithviewsserviceviews.MultipleViewsView {
	vres := &bidirectionalstreamingresultwithviewsserviceviews.MultipleViewsView{
		A: res.A,
	}
	return vres
}
