
// Service is the CustomErrors service interface.
type Service interface {
	// A implements A.
	A(context.Context) (err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "CustomErrors"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [1]string{"A"}

// Custom error fallback.
type APayload struct {
	IntField      int     `json:"IntField"`
	StringField   string  `json:"StringField"`
	BooleanField  bool    `json:"BooleanField"`
	BytesField    []byte  `json:"BytesField"`
	OptionalField *string `json:"OptionalField,omitempty"`
	Message       *string `json:"message,omitempty"`
}

type Result struct {
	A *string `json:"a,omitempty"`
	B string  `json:"b"`
}

// primitive error description
type Primitive string

// Error returns an error description.
func (e *APayload) Error() string {
	if e != nil && e.Message != nil && *e.Message != "" {
		return *e.Message
	}
	return "Custom error fallback."
}

// LoomErrorName returns the error name.
func (e *APayload) LoomErrorName() string {
	return "user_type"
}

// Error returns an error description.
func (e *Result) Error() string {
	return ""
}

// LoomErrorName returns the error name.
func (e *Result) LoomErrorName() string {
	return e.B
}

// Error returns an error description.
func (e Primitive) Error() string {
	return "primitive error description"
}

// LoomErrorName returns the error name.
func (e Primitive) LoomErrorName() string {
	return "primitive"
}
