
// Service is the WithExplicitAndDefaultViews service interface.
type Service interface {
	// A implements A.
	// The "view" return value must have one of the following views
	//   - "default"
	//   - "tiny"
	A(context.Context) (res *MultipleViews, view string, err error)
	// B implements B.
	B(context.Context) (res *MultipleViews, err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "WithExplicitAndDefaultViews"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [2]string{"A", "B"}

// MultipleViews is the result type of the WithExplicitAndDefaultViews service
// A method.
type MultipleViews struct {
	A string `json:"a"`
	B int    `json:"b"`
}

// NewMultipleViews initializes result type MultipleViews from viewed result
// type MultipleViews.
func NewMultipleViews(vres *withexplicitanddefaultviewsviews.MultipleViews) (*MultipleViews, error) {

	var res *MultipleViews
	switch vres.View {
	case "default", "":
		res = NewMultipleViewsFromMultipleViewsView(vres.Projected)
	case "tiny":
		res = NewMultipleViewsFromMultipleViewsViewTiny(vres.Projected)
	default:
		err := loom.InvalidEnumValueError("view", vres.View, []any{
			"default",
			"tiny",
		})
		return res, err
	}
	return res, nil
}

// NewViewedMultipleViews projects result type MultipleViews to viewed result
// type MultipleViews and validates the selected view. Invalid views and result
// constraints return a fault that wraps the validation error. It returns a
// fault error when res is nil.
func NewViewedMultipleViews(res *MultipleViews, view string) (*withexplicitanddefaultviewsviews.MultipleViews, error) {

	var vres *withexplicitanddefaultviewsviews.MultipleViews
	if res == nil {
		return vres, loom.Fault("missing result")
	}
	switch view {
	case "default", "":
		p := ProjectMultipleViews(res)
		vres = &withexplicitanddefaultviewsviews.MultipleViews{Projected: p, View: "default"}
	case "tiny":
		p := ProjectMultipleViewsTiny(res)
		vres = &withexplicitanddefaultviewsviews.MultipleViews{Projected: p, View: "tiny"}
	default:
		err := loom.InvalidEnumValueError("view", view, []any{
			"default",
			"tiny",
		})
		return vres, loom.NewServiceError(err, "fault", false, false, true)
	}
	if err := withexplicitanddefaultviewsviews.ValidateMultipleViews(vres); err != nil {
		var zero *withexplicitanddefaultviewsviews.MultipleViews
		return zero, loom.NewServiceError(err, "fault", false, false, true)
	}
	return vres, nil
}

// NewMultipleViewsFromMultipleViewsView converts projected type
// MultipleViewsView to service type MultipleViews.
func NewMultipleViewsFromMultipleViewsView(vres *withexplicitanddefaultviewsviews.MultipleViewsView) *MultipleViews {
	if vres == nil {
		return nil
	}
	res := &MultipleViews{}
	if vres.A != nil {
		res.A = *vres.A
	}
	if vres.B != nil {
		res.B = *vres.B
	}
	return res
}

// NewMultipleViewsFromMultipleViewsViewTiny converts projected type
// MultipleViewsView to service type MultipleViews.
func NewMultipleViewsFromMultipleViewsViewTiny(vres *withexplicitanddefaultviewsviews.MultipleViewsView) *MultipleViews {
	if vres == nil {
		return nil
	}
	res := &MultipleViews{}
	if vres.A != nil {
		res.A = *vres.A
	}
	return res
}

// ProjectMultipleViews projects result type MultipleViews to projected type
// MultipleViewsView using the "default" view.
func ProjectMultipleViews(res *MultipleViews) *withexplicitanddefaultviewsviews.MultipleViewsView {
	if res == nil {
		return nil
	}
	vres := &withexplicitanddefaultviewsviews.MultipleViewsView{
		A: &res.A,
		B: &res.B,
	}
	return vres
}

// ProjectMultipleViewsTiny projects result type MultipleViews to projected
// type MultipleViewsView using the "tiny" view.
func ProjectMultipleViewsTiny(res *MultipleViews) *withexplicitanddefaultviewsviews.MultipleViewsView {
	if res == nil {
		return nil
	}
	vres := &withexplicitanddefaultviewsviews.MultipleViewsView{
		A: &res.A,
	}
	return vres
}
