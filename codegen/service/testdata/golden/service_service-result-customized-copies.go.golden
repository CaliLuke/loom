// NewMenuM1Result initializes result type MenuM1Result from viewed result type
// MenuM1Result.
func NewMenuM1Result(vres *customizedresultcopiesviews.MenuM1Result) (*MenuM1Result, error) {

	var res *MenuM1Result
	switch vres.View {
	case "default", "":
		res = NewMenuM1ResultFromMenuM1ResultView(vres.Projected)
	case "tiny":
		res = NewMenuM1ResultFromMenuM1ResultViewTiny(vres.Projected)
	default:
		return res, loom.InvalidEnumValueError("view", vres.View, []any{
			"default",
			"tiny",
		})
	}
	return res, nil
}

// NewViewedMenuM1Result initializes viewed result type MenuM1Result from
// result type MenuM1Result using the given view.
func NewViewedMenuM1Result(res *MenuM1Result, view string) (*customizedresultcopiesviews.MenuM1Result, error) {

	var vres *customizedresultcopiesviews.MenuM1Result
	switch view {
	case "default", "":
		p := ProjectMenuM1Result(res)
		vres = &customizedresultcopiesviews.MenuM1Result{Projected: p, View: "default"}
	case "tiny":
		p := ProjectMenuM1ResultTiny(res)
		vres = &customizedresultcopiesviews.MenuM1Result{Projected: p, View: "tiny"}
	default:
		return vres, loom.InvalidEnumValueError("view", view, []any{
			"default",
			"tiny",
		})
	}
	return vres, nil
}

