
// Service is the CustomizedResultCopies service interface.
type Service interface {
	// M1 implements M1.
	// The "view" return value must have one of the following views
	//   - "default"
	//   - "tiny"
	M1(context.Context) (res *MenuM1Result, view string, err error)
	// M2 implements M2.
	M2(context.Context) (res *MenuM2Result, err error)
	// M3 implements M3.
	// The "view" return value must have one of the following views
	//   - "default"
	//   - "tiny"
	M3(context.Context) (res *Menu, view string, err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "CustomizedResultCopies"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [3]string{"M1", "M2", "M3"}

// Menu is the result type of the CustomizedResultCopies service M3 method.
type Menu struct {
	X *string `json:"x,omitempty"`
	Y *string `json:"y,omitempty"`
}

// MenuM1Result is the result type of the CustomizedResultCopies service M1
// method.
type MenuM1Result struct {
	X string  `json:"x"`
	Y *string `json:"y,omitempty"`
}

// MenuM2Result is the result type of the CustomizedResultCopies service M2
// method.
