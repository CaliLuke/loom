// NewMenu initializes result type Menu from viewed result type Menu.
func NewMenu(vres *customizedresultcopiesviews.Menu) (*Menu, error) {

	var res *Menu
	switch vres.View {
	case "default", "":
		res = NewMenuFromMenuView(vres.Projected)
	case "tiny":
		res = NewMenuFromMenuViewTiny(vres.Projected)
	case "optional":
		res = NewMenuFromMenuViewOptional(vres.Projected)
	case "required":
		res = NewMenuFromMenuViewRequired(vres.Projected)
	default:
		err := loom.InvalidEnumValueError("view", vres.View, []any{
			"default",
			"tiny",
			"optional",
			"required",
		})
		return res, err
	}
	return res, nil
}

// NewViewedMenu projects result type Menu to viewed result type Menu and
// validates the selected view. Invalid views and result constraints return a
// fault that wraps the validation error. It returns a fault error when res is
// nil.
func NewViewedMenu(res *Menu, view string) (*customizedresultcopiesviews.Menu, error) {

	var vres *customizedresultcopiesviews.Menu
	if res == nil {
		return vres, loom.Fault("missing result")
	}
	switch view {
	case "default", "":
		p := ProjectMenu(res)
		vres = &customizedresultcopiesviews.Menu{Projected: p, View: "default"}
	case "tiny":
		p := ProjectMenuTiny(res)
		vres = &customizedresultcopiesviews.Menu{Projected: p, View: "tiny"}
	case "optional":
		p := ProjectMenuOptional(res)
		vres = &customizedresultcopiesviews.Menu{Projected: p, View: "optional"}
	case "required":
		p := ProjectMenuRequired(res)
		vres = &customizedresultcopiesviews.Menu{Projected: p, View: "required"}
	default:
		err := loom.InvalidEnumValueError("view", view, []any{
			"default",
			"tiny",
			"optional",
			"required",
		})
		return vres, loom.NewServiceError(err, "fault", false, false, true)
	}
	if err := customizedresultcopiesviews.ValidateMenu(vres); err != nil {
		var zero *customizedresultcopiesviews.Menu
		return zero, loom.NewServiceError(err, "fault", false, false, true)
	}
	return vres, nil
}

