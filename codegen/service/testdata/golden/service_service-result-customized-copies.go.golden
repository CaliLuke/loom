
// Service is the CustomizedResultCopies service interface.
type Service interface {
	// M1 implements M1.
	// The "view" return value must have one of the following views
	//   - "default"
	//   - "tiny"
	//   - "optional"
	//   - "required"
	M1(context.Context) (res *MenuM1Result, view string, err error)
	// M2 implements M2.
	M2(context.Context) (res *MenuM2Result, err error)
	// M3 implements M3.
	// The "view" return value must have one of the following views
	//   - "default"
	//   - "tiny"
	//   - "optional"
	//   - "required"
	M3(context.Context) (res *Menu, view string, err error)
}

// APIName is the name of the API as defined in the design.
const APIName = "test api"

// APIVersion is the version of the API as defined in the design.
const APIVersion = "0.0.1"

// ServiceName is the name of the service as defined in the design. This is the
// same value that is set in the endpoint request contexts under the ServiceKey
// key.
const ServiceName = "CustomizedResultCopies"

// MethodNames lists the service method names as defined in the design. These
// are the same values that are set in the endpoint request contexts under the
// MethodKey key.
var MethodNames = [3]string{"M1", "M2", "M3"}

// Menu is the result type of the CustomizedResultCopies service M3 method.
type Menu struct {
	X *string `json:"x,omitempty"`
	Y *string `json:"y,omitempty"`
}

// MenuM1Result is the result type of the CustomizedResultCopies service M1
// method.
type MenuM1Result struct {
	X string  `json:"x"`
	Y *string `json:"y,omitempty"`
}

// MenuM2Result is the result type of the CustomizedResultCopies service M2
// method.
type MenuM2Result struct {
	X string  `json:"x"`
	Y *string `json:"y,omitempty"`
}

// NewMenuM1Result initializes result type MenuM1Result from viewed result type
// MenuM1Result.
func NewMenuM1Result(vres *customizedresultcopiesviews.MenuM1Result) (*MenuM1Result, error) {

	var res *MenuM1Result
	switch vres.View {
	case "default", "":
		res = NewMenuM1ResultFromMenuM1ResultView(vres.Projected)
	case "tiny":
		res = NewMenuM1ResultFromMenuM1ResultViewTiny(vres.Projected)
	case "optional":
		res = NewMenuM1ResultFromMenuM1ResultViewOptional(vres.Projected)
	case "required":
		res = NewMenuM1ResultFromMenuM1ResultViewRequired(vres.Projected)
	default:
		err := loom.InvalidEnumValueError("view", vres.View, []any{
			"default",
			"tiny",
			"optional",
			"required",
		})
		return res, err
	}
	return res, nil
}

// NewViewedMenuM1Result projects result type MenuM1Result to viewed result
// type MenuM1Result and validates the selected view. Invalid views and result
// constraints return a fault that wraps the validation error. It returns a
// fault error when res is nil.
func NewViewedMenuM1Result(res *MenuM1Result, view string) (*customizedresultcopiesviews.MenuM1Result, error) {

	var vres *customizedresultcopiesviews.MenuM1Result
	if res == nil {
		return vres, loom.Fault("missing result")
	}
	switch view {
	case "default", "":
		p := ProjectMenuM1Result(res)
		vres = &customizedresultcopiesviews.MenuM1Result{Projected: p, View: "default"}
	case "tiny":
		p := ProjectMenuM1ResultTiny(res)
		vres = &customizedresultcopiesviews.MenuM1Result{Projected: p, View: "tiny"}
	case "optional":
		p := ProjectMenuM1ResultOptional(res)
		vres = &customizedresultcopiesviews.MenuM1Result{Projected: p, View: "optional"}
	case "required":
		p := ProjectMenuM1ResultRequired(res)
		vres = &customizedresultcopiesviews.MenuM1Result{Projected: p, View: "required"}
	default:
		err := loom.InvalidEnumValueError("view", view, []any{
			"default",
			"tiny",
			"optional",
			"required",
		})
		return vres, loom.NewServiceError(err, "fault", false, false, true)
	}
	if err := customizedresultcopiesviews.ValidateMenuM1Result(vres); err != nil {
		var zero *customizedresultcopiesviews.MenuM1Result
		return zero, loom.NewServiceError(err, "fault", false, false, true)
	}
	return vres, nil
}

