

// wrappedPlainServerStream is a server interceptor wrapper for the
// PlainServerStream stream.
type wrappedPlainServerStream struct {
	ctx             context.Context
	sendWithContext func(context.Context, *PlainMessage) error
	recvWithContext func(context.Context) (*PlainStreamingPayload, error)
	stream          PlainServerStream
}

// wrappedViewedServerStream is a server interceptor wrapper for the
// ViewedServerStream stream.
type wrappedViewedServerStream struct {
	ctx             context.Context
	sendWithContext func(context.Context, *Message) error
	recvWithContext func(context.Context) (*ViewedStreamingPayload, error)
	stream          ViewedServerStream
}

