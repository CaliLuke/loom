// wrapClientPlainAudit applies the audit client interceptor to endpoints.
func wrapClientPlainAudit(endpoint loom.Endpoint, i ClientInterceptors) loom.Endpoint {
	return func(ctx context.Context, req any) (any, error) {
		info := &AuditInfo{
			service:    "final",
			method:     "Plain",
			callType:   loom.InterceptorUnary,
			rawPayload: req,
		}
		res, err := i.Audit(ctx, info, endpoint)
		if err != nil {
			return res, err
		}
		stream := res.(PlainClientStream)
		return &wrappedPlainClientStream{
			ctx: ctx,
			sendWithContext: func(ctx context.Context, req *PlainStreamingPayload) error {
				info := &AuditInfo{
					service:    "final",
					method:     "Plain",
					callType:   loom.InterceptorStreamingSend,
					rawPayload: req,
				}
				_, err := i.Audit(ctx, info, func(ctx context.Context, req any) (any, error) {
					castReq, _ := req.(*PlainStreamingPayload)
					return nil, stream.SendWithContext(ctx, castReq)
				})
				return err
			},
			recvWithContext: func(ctx context.Context) (*PlainMessage, error) {
				info := &AuditInfo{
					service:  "final",
					method:   "Plain",
					callType: loom.InterceptorStreamingRecv,
				}
				res, err := i.Audit(ctx, info, func(ctx context.Context, _ any) (any, error) {
					return stream.CloseAndRecvWithContext(ctx)
				})
				castRes, _ := res.(*PlainMessage)
				return castRes, err
			},
			stream: stream,
		}, nil
	}
}

