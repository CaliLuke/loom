// wrapPlainAudit applies the audit server interceptor to endpoints.
func wrapPlainAudit(endpoint loom.Endpoint, i ServerInterceptors) loom.Endpoint {
	return func(ctx context.Context, req any) (any, error) {
		stream := req.(*PlainEndpointInput).Stream
		req.(*PlainEndpointInput).Stream = &wrappedPlainServerStream{
			ctx: ctx,
			sendWithContext: func(ctx context.Context, req *PlainMessage) error {
				info := &AuditInfo{
					service:    "final",
					method:     "Plain",
					callType:   loom.InterceptorStreamingSend,
					rawPayload: req,
				}
				_, err := i.Audit(ctx, info, func(ctx context.Context, req any) (any, error) {
					castReq, _ := req.(*PlainMessage)
					return nil, stream.SendAndCloseWithContext(ctx, castReq)
				})
				return err
			},
			recvWithContext: func(ctx context.Context) (*PlainStreamingPayload, error) {
				info := &AuditInfo{
					service:  "final",
					method:   "Plain",
					callType: loom.InterceptorStreamingRecv,
				}
				res, err := i.Audit(ctx, info, func(ctx context.Context, _ any) (any, error) {
					return stream.RecvWithContext(ctx)
				})
				castRes, _ := res.(*PlainStreamingPayload)
				return castRes, err
			},
			stream: stream,
		}
		info := &AuditInfo{
			service:    "final",
			method:     "Plain",
			callType:   loom.InterceptorUnary,
			rawPayload: req,
		}
		return i.Audit(ctx, info, endpoint)
	}
}

