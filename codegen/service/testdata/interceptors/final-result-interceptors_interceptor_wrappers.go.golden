// Unwrap returns the underlying stream type.
func (w *wrappedPlainServerStream) Unwrap() any {
	return w.stream
}

// SendAndClose streams instances of "PlainServerStream" after executing the
// applied interceptor.
func (w *wrappedPlainServerStream) SendAndClose(v *PlainMessage) error {
	return w.SendAndCloseWithContext(w.ctx, v)
}

// SendAndCloseWithContext streams instances of "PlainServerStream" after
// executing the applied interceptor with context.
func (w *wrappedPlainServerStream) SendAndCloseWithContext(ctx context.Context, v *PlainMessage) error {
	if w.sendWithContext == nil {
		return w.stream.SendAndCloseWithContext(ctx, v)
	}
	return w.sendWithContext(ctx, v)
}

// Recv reads instances of "PlainServerStream" from the stream after executing
// the applied interceptor.
func (w *wrappedPlainServerStream) Recv() (*PlainStreamingPayload, error) {
	return w.RecvWithContext(w.ctx)
}

// RecvWithContext reads instances of "PlainServerStream" from the stream after
// executing the applied interceptor with context.
func (w *wrappedPlainServerStream) RecvWithContext(ctx context.Context) (*PlainStreamingPayload, error) {
	if w.recvWithContext == nil {
		return w.stream.RecvWithContext(ctx)
	}
	return w.recvWithContext(ctx)
}

