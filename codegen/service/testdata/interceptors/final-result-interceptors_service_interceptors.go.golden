	return *p.payload.Chunk
}
func (r *auditFixedStreamingResult) Data() string {
	if r.result.Data == nil {
		var zero string
		return zero
	}
	return *r.result.Data
}
func (r *auditFixedStreamingResult) SetData(v string) {
	r.result.Data = &v
}
