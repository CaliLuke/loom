

// wrapAuditDirect applies the audit server interceptor to endpoints.
func wrapDirectAudit(endpoint loom.Endpoint, i ServerInterceptors) loom.Endpoint {
	return func(ctx context.Context, req any) (any, error) {
		info := &AuditInfo{
			service:    "LowerCaseInterceptorNames",
			method:     "Direct",
			callType:   loom.InterceptorUnary,
			rawPayload: req,
		}
		return i.Audit(ctx, info, endpoint)
	}
}

