

// wrapLoggingMethod applies the logging server interceptor to endpoints.
func wrapMethodLogging(endpoint loom.Endpoint, i ServerInterceptors) loom.Endpoint {
	return func(ctx context.Context, req any) (any, error) {
		info := &LoggingInfo{
			service:    "SingleAPIServerInterceptor",
			method:     "Method",
			callType:   loom.InterceptorUnary,
			rawPayload: req,
		}
		return i.Logging(ctx, info, endpoint)
	}
}

