

// wrapValidationMethod applies the validation server interceptor to endpoints.
func wrapMethodValidation(endpoint loom.Endpoint, i ServerInterceptors) loom.Endpoint {
	return func(ctx context.Context, req any) (any, error) {
		info := &ValidationInfo{
			service:    "InterceptorWithReadPayload",
			method:     "Method",
			callType:   loom.InterceptorUnary,
			rawPayload: req,
		}
		return i.Validation(ctx, info, endpoint)
	}
}

// wrapClientValidationMethod applies the validation client interceptor to
// endpoints.
func wrapClientMethodValidation(endpoint loom.Endpoint, i ClientInterceptors) loom.Endpoint {
	return func(ctx context.Context, req any) (any, error) {
		info := &ValidationInfo{
			service:    "InterceptorWithReadPayload",
			method:     "Method",
			callType:   loom.InterceptorUnary,
			rawPayload: req,
		}
		return i.Validation(ctx, info, endpoint)
	}
}
