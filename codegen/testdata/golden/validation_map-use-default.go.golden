import "regexp"

func Validate() (err error) {
	if target.RequiredMap == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("required_map", "target"))
	}
	if len(target.RequiredMap) < 5 {
		err = loom.MergeErrors(err, loom.InvalidLengthError("target.required_map", target.RequiredMap, len(target.RequiredMap), 5, true))
	}
	if len(target.DefaultMap) > 3 {
		err = loom.MergeErrors(err, loom.InvalidLengthError("target.default_map", target.DefaultMap, len(target.DefaultMap), 3, false))
	}
	for k, v := range target.Map {
		err = loom.MergeErrors(err, loom.ValidatePatternCompiled("target.map.key", k, loomPatternTest0))
		if v > 5 {
			err = loom.MergeErrors(err, loom.InvalidRangeError("target.map[key]", v, 5, false))
		}
	}
}

var loomPatternTest0 = regexp.MustCompile("^[A-Z]")
