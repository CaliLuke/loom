func transform() {
	target := &proto.Optional{
		Float:  source.Float_,
		String: source.String_,
		Bytes:  source.Bytes_,
		Any: func() any {
			// Convert protobuf Value to Go any directly
			if source.Any != nil {
				return source.Any.AsInterface()
			}
			return nil
		}(),
	}
	if source.Int != nil {
		int_ := int(*source.Int)
		target.Int = &int_
	}
	if source.Uint != nil {
		uint_ := uint(*source.Uint)
		target.Uint = &uint_
	}
	if source.Array != nil {
		target.Array = make([]string, len(source.Array))
		copy(target.Array, source.Array)
	}
	if source.Map_ != nil {
		target.Map = make(map[int]string, len(source.Map_))
		for key, val := range source.Map_ {
			tk := int(key)
			target.Map[tk] = val
		}
	}
	if source.UserType != nil {
		target.UserType = protobufProtoOptionalToProtoOptional(source.UserType)
	}
}
