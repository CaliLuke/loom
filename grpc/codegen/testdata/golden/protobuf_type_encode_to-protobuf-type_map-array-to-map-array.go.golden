func transform() {
	target := &proto.MapArray{}
	if source.MapArray != nil {
		target.MapArray = make([]*proto.MapOfSint64String, len(source.MapArray))
		for i, val := range source.MapArray {
			target.MapArray[i] = &proto.MapOfSint64String{}
			target.MapArray[i].Field = make(map[int64]string, len(val))
			for key, val := range val {
				tk := int64(key)
				target.MapArray[i].Field[tk] = val
			}
		}
	}
}
