// MethodClientStreamingRPC calls the "MethodClientStreamingRPC" function in
// service_client_streaming_rpcpb.ServiceClientStreamingRPCClient interface.
func (c *Client) MethodClientStreamingRPC() loom.Endpoint {
	return func(ctx context.Context, v any) (any, error) {
		inv := loomgrpc.NewInvoker(func(ctx context.Context, reqpb any, opts ...grpc.CallOption) (any, error) {
			res, err := BuildMethodClientStreamingRPCFunc(c.grpccli, c.opts...)(ctx, reqpb, opts...)
			if err != nil {
				resp := loomgrpc.DecodeError(err)
				switch message := resp.(type) {
				case *loompb.ErrorResponse:
					return nil, loomgrpc.NewServiceErrorWithCause(message, err)
				default:
					return nil, err
				}
			}
			return res, nil
		}, nil, DecodeMethodClientStreamingRPCResponse)
		return inv.Invoke(ctx, v)
	}
}
