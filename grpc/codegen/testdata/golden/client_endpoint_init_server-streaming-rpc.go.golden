// MethodServerStreamingRPC calls the "MethodServerStreamingRPC" function in
// service_server_streaming_rpcpb.ServiceServerStreamingRPCClient interface.
func (c *Client) MethodServerStreamingRPC() loom.Endpoint {
	return func(ctx context.Context, v any) (any, error) {
		inv := loomgrpc.NewInvoker(func(ctx context.Context, reqpb any, opts ...grpc.CallOption) (any, error) {
			res, err := BuildMethodServerStreamingRPCFunc(c.grpccli, c.opts...)(ctx, reqpb, opts...)
			if err != nil {
				resp := loomgrpc.DecodeError(err)
				switch message := resp.(type) {
				case *loompb.ErrorResponse:
					return nil, loomgrpc.NewServiceErrorWithCause(message, err)
				default:
					return nil, err
				}
			}
			return res, nil
		}, EncodeMethodServerStreamingRPCRequest, DecodeMethodServerStreamingRPCResponse)
		return inv.Invoke(ctx, v)
	}
}
