// MethodUnaryRPCNoResult calls the "MethodUnaryRPCNoResult" function in
// service_unary_rpc_no_resultpb.ServiceUnaryRPCNoResultClient interface.
func (c *Client) MethodUnaryRPCNoResult() loom.Endpoint {
	return func(ctx context.Context, v any) (any, error) {
		inv := loomgrpc.NewInvoker(BuildMethodUnaryRPCNoResultFunc(c.grpccli, c.opts...), EncodeMethodUnaryRPCNoResultRequest, nil)
		res, err := inv.Invoke(ctx, v)
		if err != nil {
			resp := loomgrpc.DecodeError(err)
			// Try to decode a Loom error response detail before falling back to Fault.
			if eresp, ok := resp.(*loompb.ErrorResponse); ok {
				return nil, loomgrpc.NewServiceError(eresp)
			}
			return nil, loom.Fault("%s", err.Error())
		}
		return res, nil
	}
}
