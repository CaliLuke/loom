// NewProtoMethodRequest builds the gRPC request type from the payload of the
// "Method" endpoint of the "UsingMetaTypes" service.
func NewProtoMethodRequest(payload *usingmetatypes.MethodPayload) *using_meta_typespb.MethodRequest {
	message := &using_meta_typespb.MethodRequest{
		A: &payload.Foo,
	}
	if payload.Bar != nil {
		message.B = make([]int64, len(payload.Bar))
		copy(message.B, payload.Bar)
	}
	return message
}

// NewMethodResult builds the result type of the "Method" endpoint of the
// "UsingMetaTypes" service from the gRPC response type.
func NewMethodResult(message *using_meta_typespb.MethodResponse) *usingmetatypes.MethodResult {
	result := &usingmetatypes.MethodResult{}
	if message.A != nil {
		result.Foo = *message.A
	}
	if message.A == nil {
		result.Foo = 1
	}
	if message.B != nil {
		result.Bar = make([]int64, len(message.B))
		copy(result.Bar, message.B)
	}
	return result
}

// ValidateMethodRequest runs the validations defined on MethodRequest.
func ValidateMethodRequest(message *using_meta_typespb.MethodRequest, validationContext ...string) (err error) {
	validationPath := "message"
	if len(validationContext) > 0 {
		validationPath = ""
		for _, validationPart := range validationContext {
			validationPath += validationPart
		}
	}
	if message.B == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("b", validationPath))
	}
	return
}

