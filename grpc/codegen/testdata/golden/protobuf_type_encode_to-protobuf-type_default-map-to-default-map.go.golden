func transform() {
	target := &proto.DefaultMap{}
	if source.Simple != nil {
		target.Simple = make(map[string]int64, len(source.Simple))
		for key, val := range source.Simple {
			tk := key
			tv := int64(val)
			target.Simple[tk] = tv
		}
	}
	if source.Simple == nil {
		target.Simple = map[string]int64{"foo": 1}
	}
}
