func (c *Client) MethodClientStreamingNoResult() loom.Endpoint {
	return func(ctx context.Context, v any) (any, error) {
		inv := loomgrpc.NewInvoker(BuildMethodClientStreamingNoResultFunc(c.grpccli, c.opts...), nil, DecodeMethodClientStreamingNoResultResponse)
		res, err := inv.Invoke(ctx, v)
		if err != nil {
			resp := loomgrpc.DecodeError(err)
			// Try to decode a Loom error response detail before falling back to Fault.
			if eresp, ok := resp.(*loompb.ErrorResponse); ok {
				return nil, loomgrpc.NewServiceError(eresp)
