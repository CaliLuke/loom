// NewMethodPayload builds the payload of the "Method" endpoint of the
// "DefaultFields" service from the gRPC request type.
func NewMethodPayload(message *default_fieldspb.MethodRequest) *defaultfields.MethodPayload {
	v := &defaultfields.MethodPayload{
		Req:  *message.Req,
		Opt:  message.Opt,
		Reqs: *message.Reqs,
		Opts: message.Opts,
		Rat:  *message.Rat,
		Flt:  message.Flt,
	}
	if message.Def0 != nil {
		v.Def0 = *message.Def0
	}
	if message.Def1 != nil {
		v.Def1 = *message.Def1
	}
	if message.Def2 != nil {
		v.Def2 = *message.Def2
	}
	if message.Defs != nil {
		v.Defs = *message.Defs
	}
	if message.Defe != nil {
		v.Defe = *message.Defe
	}
	if message.Flt0 != nil {
		v.Flt0 = *message.Flt0
	}
	if message.Flt1 != nil {
		v.Flt1 = *message.Flt1
	}
	if message.Def0 == nil {
		v.Def0 = 0
	}
	if message.Def1 == nil {
		v.Def1 = 1
	}
	if message.Def2 == nil {
		v.Def2 = 2
	}
	if message.Defs == nil {
		v.Defs = "!"
	}
	if message.Defe == nil {
		v.Defe = ""
	}
	if message.Flt0 == nil {
		v.Flt0 = 0
	}
	if message.Flt1 == nil {
		v.Flt1 = 1
	}
	return v
}

// NewProtoMethodResponse builds the gRPC response type from the result of the
// "Method" endpoint of the "DefaultFields" service.
func NewProtoMethodResponse() *default_fieldspb.MethodResponse {
	message := &default_fieldspb.MethodResponse{}
	return message
}

// ValidatePresenceBlob runs the validations defined on PresenceBlob.
func ValidatePresenceBlob(message *default_fieldspb.PresenceBlob, validationContext ...string) (err error) {
	validationPath := "message"
	if len(validationContext) > 0 {
		validationPath = ""
		for _, validationPart := range validationContext {
			validationPath += validationPart
		}
	}
	if message.Field == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("field", validationPath))
	}
	if message.Field != nil {
		if len(message.Field) > 3 {
			err = loom.MergeErrors(err, loom.InvalidLengthError(validationPath+".field", len(message.Field), 3, false))
		}
	}
	return
}

// ValidateScalarsRequest runs the validations defined on ScalarsRequest.
func ValidateScalarsRequest(message *default_fieldspb.ScalarsRequest, validationContext ...string) (err error) {
	validationPath := "message"
	if len(validationContext) > 0 {
		validationPath = ""
		for _, validationPart := range validationContext {
			validationPath += validationPart
		}
	}
	if message.Text == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("text", validationPath))
	}
	if message.Flag == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("flag", validationPath))
	}
	if message.Integer == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("integer", validationPath))
	}
	if message.Integer32 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("integer32", validationPath))
	}
	if message.Integer64 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("integer64", validationPath))
	}
	if message.Unsigned == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("unsigned", validationPath))
	}
	if message.Unsigned32 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("unsigned32", validationPath))
	}
	if message.Unsigned64 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("unsigned64", validationPath))
	}
	if message.Float32 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("float32", validationPath))
	}
	if message.Float64 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("float64", validationPath))
	}
	if message.Bytes_ == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("bytes", validationPath))
	}
	if message.RequiredDefault == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("required_default", validationPath))
	}
	if message.Text != nil {
		if utf8.RuneCountInString(*message.Text) > 3 {
			err = loom.MergeErrors(err, loom.InvalidLengthError(validationPath+".text", utf8.RuneCountInString(*message.Text), 3, false))
		}
	}
	if message.Bytes_ != nil {
		if len(message.Bytes_) > 3 {
			err = loom.MergeErrors(err, loom.InvalidLengthError(validationPath+".bytes", len(message.Bytes_), 3, false))
		}
	}
	return
}

