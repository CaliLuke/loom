// NewBlobPayload builds the payload of the "Blob" endpoint of the
// "DefaultFields" service from the gRPC request type.
func NewBlobPayload(message *default_fieldspb.PresenceBlob) defaultfields.PresenceBlob {
	v := defaultfields.PresenceBlob(message.Field)
	return v
}

// NewProtoPresenceBlob builds the gRPC response type from the result of the
// "Blob" endpoint of the "DefaultFields" service.
func NewProtoPresenceBlob(result defaultfields.PresenceBlob) *default_fieldspb.PresenceBlob {
	message := &default_fieldspb.PresenceBlob{}
	message.Field = []byte(result)
	return message
}

// NewScalarsPayload builds the payload of the "Scalars" endpoint of the
// "DefaultFields" service from the gRPC request type.
func NewScalarsPayload(message *default_fieldspb.ScalarsRequest) *defaultfields.PresenceScalars {
	v := &defaultfields.PresenceScalars{
		Text:            defaultfields.PresenceText(*message.Text),
		Flag:            *message.Flag,
		Integer:         int(*message.Integer),
		Integer32:       *message.Integer32,
		Integer64:       *message.Integer64,
		Unsigned:        uint(*message.Unsigned),
		Unsigned32:      *message.Unsigned32,
		Unsigned64:      *message.Unsigned64,
		Float32:         *message.Float32,
		Float64:         *message.Float64,
		Bytes:           defaultfields.PresenceBytes(message.Bytes_),
		RequiredDefault: *message.RequiredDefault,
		Optional:        message.Optional,
	}
	if message.OptionalDefault != nil {
		v.OptionalDefault = *message.OptionalDefault
	}
	if message.OptionalDefault == nil {
		v.OptionalDefault = "fallback"
	}
	return v
}

// NewProtoScalarsResponse builds the gRPC response type from the result of the
// "Scalars" endpoint of the "DefaultFields" service.
func NewProtoScalarsResponse(result *defaultfields.PresenceScalars) *default_fieldspb.ScalarsResponse {
	message := &default_fieldspb.ScalarsResponse{
		Flag:            &result.Flag,
		Integer32:       &result.Integer32,
		Integer64:       &result.Integer64,
		Unsigned32:      &result.Unsigned32,
		Unsigned64:      &result.Unsigned64,
		Float32:         &result.Float32,
		Float64:         &result.Float64,
		Bytes_:          []byte(result.Bytes),
		RequiredDefault: &result.RequiredDefault,
		OptionalDefault: &result.OptionalDefault,
		Optional:        result.Optional,
	}
	text := string(result.Text)
	message.Text = &text
	integer := int64(result.Integer)
	message.Integer = &integer
	unsigned := uint64(result.Unsigned)
	message.Unsigned = &unsigned
	return message
}

