// ValidateMethodRequest runs the validations defined on MethodRequest.
func ValidateMethodRequest(message *default_fieldspb.MethodRequest, validationContext ...string) (err error) {
	validationPath := "message"
	if len(validationContext) > 0 {
		validationPath = ""
		for _, validationPart := range validationContext {
			validationPath += validationPart
		}
	}
	if message.Req == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("req", validationPath))
	}
	if message.Reqs == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("reqs", validationPath))
	}
	if message.Rat == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("rat", validationPath))
	}
	return
}
