func transform() {
	target := &proto.NestedMap{}
	if source.NestedMap != nil {
		target.NestedMap = make(map[float64]*proto.MapOfSint64MapOfDoubleUint64, len(source.NestedMap))
		for key, val := range source.NestedMap {
			tvc := &proto.MapOfSint64MapOfDoubleUint64{}
			tvc.Field = make(map[int64]*proto.MapOfDoubleUint64, len(val))
			for key, val := range val {
				tk := int64(key)
				tvb := &proto.MapOfDoubleUint64{}
				tvb.Field = make(map[float64]uint64, len(val))
				for key, val := range val {
					tvb.Field[key] = val
				}
				tvc.Field[tk] = tvb
			}
			target.NestedMap[key] = tvc
		}
	}
}
