
syntax = "proto3";

package mapalias;

option go_package = "/mapaliaspb";

// Service is the mapalias service interface.
service Mapalias {
	// Echo implements echo.
	rpc Echo (EchoRequest) returns (EchoResponse);
	// Lookup implements lookup.
	rpc Lookup (Index) returns (Index);
	// Extend implements extend.
	rpc Extend (More) returns (More);
	// Upload implements upload.
	rpc Upload (stream UploadStreamingRequest) returns (Index);
	// UploadMore implements upload_more.
	rpc UploadMore (stream Index) returns (UploadMoreResponse);
}

message EchoRequest {
	Index index = 1;
	Index required_index = 2;
	LeafIndex leaf_index = 3;
	TagIndex tag_index = 4;
	More more = 5;
	repeated Index indexes = 6;
	map<string, Index> index_by_key = 7;
	Limited limited = 8;
}

message Index {
	map<string, sint64> field = 1;
}

message LeafIndex {
	map<string, Leaf> field = 1;
}

message Leaf {
	optional string name = 1;
}

message TagIndex {
	map<sint64, Tags> field = 1;
}

message Tags {
	repeated string field = 1;
}

message More {
	map<string, sint64> field = 1;
}

message Limited {
	map<string, string> field = 1;
}

message EchoResponse {
	Index index = 1;
	Index required_index = 2;
	LeafIndex leaf_index = 3;
	TagIndex tag_index = 4;
	More more = 5;
	repeated Index indexes = 6;
	map<string, Index> index_by_key = 7;
	Limited limited = 8;
}

message UploadStreamingRequest {
	map<string, sint64> field = 1;
}

message UploadMoreResponse {
}
