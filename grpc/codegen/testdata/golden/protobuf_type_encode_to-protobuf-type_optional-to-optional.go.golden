func transform() {
	target := &proto.Optional{
		Float_:  source.Float,
		String_: source.String,
		Bytes_:  source.Bytes,
		Any: func() *structpb.Value {
			// Convert Go any to protobuf Value directly
			if source.Any == nil {
				return structpb.NewNullValue()
			}
			value, err := loomgrpc.NewProtoValue(source.Any)
			if err != nil {
				*transformErr = err
				return nil
			}
			return value
		}(),
	}
	if source.Int != nil {
		int_ := int64(*source.Int)
		target.Int = &int_
	}
	if source.Uint != nil {
		uint_ := uint64(*source.Uint)
		target.Uint = &uint_
	}
	if source.Array != nil {
		target.Array = make([]string, len(source.Array))
		copy(target.Array, source.Array)
	}
	if source.Map != nil {
		target.Map_ = make(map[int64]string, len(source.Map))
		for key, val := range source.Map {
			tk := int64(key)
			target.Map_[tk] = val
		}
	}
	if source.UserType != nil {
		target.UserType = svcProtoOptionalToProtoOptional(source.UserType, transformErr)
	}
}
