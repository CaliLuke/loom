func transform() {
	target := &proto.WithDefaults{
		Int:            int64(source.Int),
		RawJson:        string(source.RawJSON),
		RequiredInt:    int64(source.RequiredInt),
		String_:        source.String,
		RequiredString: source.RequiredString,
		Bytes_:         source.Bytes,
		RequiredBytes:  source.RequiredBytes,
		Any:            source.Any,
		RequiredAny:    source.RequiredAny,
	}
	{
		var zero int64
		if target.Int == zero {
			target.Int = 100
		}
	}
	{
		var zero string
		if target.RawJson == zero {
			target.RawJson = jsontext.Value{0x66, 0x6f, 0x6f}
		}
	}
	{
		var zero string
		if target.String_ == zero {
			target.String_ = "foo"
		}
	}
	{
		var zero []byte
		if target.Bytes_ == zero {
			target.Bytes_ = []byte{0x66, 0x6f, 0x6f, 0x62, 0x61, 0x72}
		}
	}
	{
		var zero string
		if target.Any == zero {
			target.Any = "something"
		}
	}
	if source.Array != nil {
		target.Array = make([]string, len(source.Array))
		copy(target.Array, source.Array)
	}
	if source.Array == nil {
		target.Array = []string{"foo", "bar"}
	}
	if source.RequiredArray != nil {
		target.RequiredArray = make([]string, len(source.RequiredArray))
		copy(target.RequiredArray, source.RequiredArray)
	}
	if source.Map != nil {
		target.Map_ = make(map[int64]string, len(source.Map))
		for key, val := range source.Map {
			tk := int64(key)
			target.Map_[tk] = val
		}
	}
	if source.Map == nil {
		target.Map_ = map[int64]string{1: "foo"}
	}
	if source.RequiredMap != nil {
		target.RequiredMap = make(map[int64]string, len(source.RequiredMap))
		for key, val := range source.RequiredMap {
			tk := int64(key)
			target.RequiredMap[tk] = val
		}
	}
}
