// NewProtoPresenceBlob builds the gRPC request type from the payload of the
// "Blob" endpoint of the "DefaultFields" service.
func NewProtoPresenceBlob(payload defaultfields.PresenceBlob) *default_fieldspb.PresenceBlob {
	message := &default_fieldspb.PresenceBlob{}
	message.Field = []byte(payload)
	return message
}

// NewBlobResult builds the result type of the "Blob" endpoint of the
// "DefaultFields" service from the gRPC response type.
func NewBlobResult(message *default_fieldspb.PresenceBlob) defaultfields.PresenceBlob {
	result := defaultfields.PresenceBlob(message.Field)
	return result
}

// NewProtoScalarsRequest builds the gRPC request type from the payload of the
// "Scalars" endpoint of the "DefaultFields" service.
func NewProtoScalarsRequest(payload *defaultfields.PresenceScalars) *default_fieldspb.ScalarsRequest {
	message := &default_fieldspb.ScalarsRequest{
		Flag:            &payload.Flag,
		Integer32:       &payload.Integer32,
		Integer64:       &payload.Integer64,
		Unsigned32:      &payload.Unsigned32,
		Unsigned64:      &payload.Unsigned64,
		Float32:         &payload.Float32,
		Float64:         &payload.Float64,
		Bytes_:          []byte(payload.Bytes),
		RequiredDefault: &payload.RequiredDefault,
		OptionalDefault: &payload.OptionalDefault,
		Optional:        payload.Optional,
	}
	text := string(payload.Text)
	message.Text = &text
	integer := int64(payload.Integer)
	message.Integer = &integer
	unsigned := uint64(payload.Unsigned)
	message.Unsigned = &unsigned
	return message
}

// NewScalarsResult builds the result type of the "Scalars" endpoint of the
// "DefaultFields" service from the gRPC response type.
func NewScalarsResult(message *default_fieldspb.ScalarsResponse) *defaultfields.PresenceScalars {
	result := &defaultfields.PresenceScalars{
		Text:            defaultfields.PresenceText(*message.Text),
		Flag:            *message.Flag,
		Integer:         int(*message.Integer),
		Integer32:       *message.Integer32,
		Integer64:       *message.Integer64,
		Unsigned:        uint(*message.Unsigned),
		Unsigned32:      *message.Unsigned32,
		Unsigned64:      *message.Unsigned64,
		Float32:         *message.Float32,
		Float64:         *message.Float64,
		Bytes:           defaultfields.PresenceBytes(message.Bytes_),
		RequiredDefault: *message.RequiredDefault,
		Optional:        message.Optional,
	}
	if message.OptionalDefault != nil {
		result.OptionalDefault = *message.OptionalDefault
	}
	if message.OptionalDefault == nil {
		result.OptionalDefault = "fallback"
	}
	return result
}

