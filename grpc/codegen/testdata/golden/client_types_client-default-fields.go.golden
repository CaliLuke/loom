// NewProtoMethodRequest builds the gRPC request type from the payload of the
// "Method" endpoint of the "DefaultFields" service.
func NewProtoMethodRequest(payload *defaultfields.MethodPayload) *default_fieldspb.MethodRequest {
	message := &default_fieldspb.MethodRequest{
		Req:  &payload.Req,
		Opt:  payload.Opt,
		Def0: &payload.Def0,
		Def1: &payload.Def1,
		Def2: &payload.Def2,
		Reqs: &payload.Reqs,
		Opts: payload.Opts,
		Defs: &payload.Defs,
		Defe: &payload.Defe,
		Rat:  &payload.Rat,
		Flt:  payload.Flt,
		Flt0: &payload.Flt0,
		Flt1: &payload.Flt1,
	}
	return message
}

// ValidatePresenceBlob runs the validations defined on PresenceBlob.
func ValidatePresenceBlob(message *default_fieldspb.PresenceBlob) (err error) {
	if message.Field == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("field", "message"))
	}
	if message.Field != nil {
		if len(message.Field) > 3 {
			err = loom.MergeErrors(err, loom.InvalidLengthError("message.field", len(message.Field), 3, false))
		}
	}
	return
}

// ValidateScalarsRequest runs the validations defined on ScalarsRequest.
func ValidateScalarsRequest(message *default_fieldspb.ScalarsRequest) (err error) {
	if message.Text == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("text", "message"))
	}
	if message.Flag == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("flag", "message"))
	}
	if message.Integer == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("integer", "message"))
	}
	if message.Integer32 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("integer32", "message"))
	}
	if message.Integer64 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("integer64", "message"))
	}
	if message.Unsigned == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("unsigned", "message"))
	}
	if message.Unsigned32 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("unsigned32", "message"))
	}
	if message.Unsigned64 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("unsigned64", "message"))
	}
	if message.Float32 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("float32", "message"))
	}
	if message.Float64 == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("float64", "message"))
	}
	if message.Bytes_ == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("bytes", "message"))
	}
	if message.RequiredDefault == nil {
		err = loom.MergeErrors(err, loom.MissingFieldError("required_default", "message"))
	}
	if message.Text != nil {
		if utf8.RuneCountInString(*message.Text) > 3 {
			err = loom.MergeErrors(err, loom.InvalidLengthError("message.text", utf8.RuneCountInString(*message.Text), 3, false))
		}
	}
	if message.Bytes_ != nil {
		if len(message.Bytes_) > 3 {
			err = loom.MergeErrors(err, loom.InvalidLengthError("message.bytes", len(message.Bytes_), 3, false))
		}
	}
	return
