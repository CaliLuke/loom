
syntax = "proto3";

package pickunion;

option go_package = "/pickunionpb";

// Service is the pickunion service interface.
service Pickunion {
	// Echo implements echo.
	rpc Echo (EchoRequest) returns (EchoResponse);
}

message EchoRequest {
	optional string id = 1;
	oneof pick {
		Leaf leaf = 2;
		Other other = 3;
	}
	oneof must {
		Extra extra = 4;
		Holder holder = 5;
	}
	repeated Holder holders = 6;
}

message Leaf {
	optional string name = 1;
}

message Other {
	optional sint64 count = 1;
}

message Extra {
	optional bool flag = 1;
}

message Holder {
	optional string label = 1;
	oneof inner {
		Leaf leaf = 2;
		Other other = 3;
	}
}

message EchoResponse {
	optional string id = 1;
	oneof pick {
		Leaf leaf = 2;
		Other other = 3;
	}
	oneof must {
		Extra extra = 4;
		Holder holder = 5;
	}
	repeated Holder holders = 6;
}
