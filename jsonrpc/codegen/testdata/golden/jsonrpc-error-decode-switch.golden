func decodeDivideError(decoder func(*http.Response) loomhttp.Decoder, resp *http.Response, wire *jsonrpc.RawErrorResponse) error {
	switch wire.Code {
	case jsonrpc.InternalError:
		return jsonrpc.DecodeErrorResponse("calc", "divide", wire, resp, []jsonrpc.ErrorCandidate{{Name: "timeout", Decode: func(resp *http.Response) (error, error) {
			var (
				body DivideTimeoutResponseBody
				err  error
			)
			err = decoder(resp).Decode(&body)
			if err != nil {
				return nil, loomhttp.ErrDecodingError("calc", "divide", err)
			}
			err = ValidateDivideTimeoutResponseBody(&body)
			if err != nil {
				return nil, loomhttp.ErrValidationError("calc", "divide", err)
			}
			return NewDivideTimeout(&body), nil
		}}})
	case jsonrpc.ServerError:
		return jsonrpc.DecodeErrorResponse("calc", "divide", wire, resp, []jsonrpc.ErrorCandidate{{Name: "insufficient_funds", Decode: func(resp *http.Response) (error, error) {
			var (
				body DivideInsufficientFundsResponseBody
				err  error
			)
			err = decoder(resp).Decode(&body)
			if err != nil {
				return nil, loomhttp.ErrDecodingError("calc", "divide", err)
			}
			return NewDivideInsufficientFunds(&body), nil
		}}, {Name: "account_closed", Decode: func(resp *http.Response) (error, error) {
			var (
				body DivideAccountClosedResponseBody
				err  error
			)
			err = decoder(resp).Decode(&body)
			if err != nil {
				return nil, loomhttp.ErrDecodingError("calc", "divide", err)
			}
			return body, nil
		}}})
	default:
		return wire
	}
}
