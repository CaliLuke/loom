// Client lists the calc service endpoint HTTP clients.
type Client struct {
	// Doer is the HTTP client used to make requests to the calc service.
	Doer loomhttp.Doer
	// RestoreResponseBody controls whether the response bodies are reset after
	// decoding so they can be read again.
	RestoreResponseBody bool

	scheme  string
	host    string
	encoder func(*http.Request) loomhttp.Encoder
	decoder func(*http.Response) loomhttp.Decoder
}

// NewClient instantiates HTTP clients for all the calc service servers.
func NewClient(scheme string, host string, doer loomhttp.Doer, enc func(*http.Request) loomhttp.Encoder, dec func(*http.Response) loomhttp.Decoder, restoreBody bool) *Client {
	return &Client{
		Doer:                doer,
		RestoreResponseBody: restoreBody,
		decoder:             dec,
		encoder:             enc,
		host:                host,
		scheme:              scheme,
	}
}
