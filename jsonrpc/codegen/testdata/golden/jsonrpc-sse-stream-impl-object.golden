// jSONRPCSSEObjectServiceSSEStream implements the
// jsonrpcsseobjectservice.Stream interface for SSE transport.
type jSONRPCSSEObjectServiceSSEStream struct {
	// writer owns the serialized SSE response lifecycle.
	writer *loomhttp.SSEStreamWriter
	// w is the HTTP response writer used to send the SSE events.
	w http.ResponseWriter
	// r is the HTTP request.
	r *http.Request
	// encoder is the response encoder.
	encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder
	// decoder is the request decoder.
	decoder func(*http.Request) loomhttp.Decoder
}

// Open commits and flushes the successful SSE response before the first event.
func (s *jSONRPCSSEObjectServiceSSEStream) Open(ctx context.Context) error {
	return s.writer.Open(ctx)
}

// SendComment writes and flushes an SSE heartbeat comment.
func (s *jSONRPCSSEObjectServiceSSEStream) SendComment(ctx context.Context, text string) error {
	return s.writer.SendComment(ctx, text)
}
func (s *jSONRPCSSEObjectServiceSSEStream) sendSSEEvent(eventType string, v any) error {
	return s.writer.WriteEvent(s.r.Context(), func(w io.Writer) error {
		return loomhttp.WriteJSONSSEEvent(w, loomhttp.SSEMessage{Type: eventType}, v)
	})
}
func (s *jSONRPCSSEObjectServiceSSEStream) sendError(ctx context.Context, id any, code jsonrpc.Code, message string, data any) error {
	response := jsonrpc.MakeErrorResponse(id, code, message, data)
	return s.sendSSEEvent("message", response)
}

// Send sends an event (notification or response) to the client.
// For notifications, the result should not have an ID field.
// For responses, the result must have an ID field.
func (s *jSONRPCSSEObjectServiceSSEStream) Send(ctx context.Context, event jsonrpcsseobjectservice.Event) error {
	switch v := event.(type) {
	case *jsonrpcsseobjectservice.StreamResult:
		body := NewStreamResponseBody(v)
		var message map[string]any
		var id string
		var isResponse bool
		if v.ID != nil && *v.ID != "" {
			id = *v.ID
			isResponse = true
			v.ID = nil
		}
		if isResponse {
			resp := jsonrpc.MakeSuccessResponse(id, body)
			message = map[string]any{
				"id":      resp.ID,
				"jsonrpc": resp.JSONRPC,
				"result":  resp.Result,
			}
		} else {
			message = map[string]any{
				"jsonrpc": "2.0",
				"method":  "JSONRPCSSEObjectService/stream.event",
				"params":  body,
			}
		}
		return s.sendSSEEvent("message", message)
	default:
		return fmt.Errorf("unknown event type: %T", event)
	}
}
