// Mount configures the mux to serve the JSON-RPC JSONRPCCORS service methods.
func Mount(mux loomhttp.Muxer, h *Server) {
	// HTTP only
	mux.Handle("POST", "/rpc", h.ServeHTTP)
	mux.Handle("OPTIONS", "/rpc", func(w http.ResponseWriter, r *http.Request) {
		loomhttp.HandleCORSPreflight(w, r, loomhttp.CORSPolicy{Origins: []loomhttp.CORSOrigin{{
			Credentials: true,
			Headers:     []string{"Content-Type", "Authorization"},
			Methods:     []string{"POST"},
			Pattern:     "https://app.example.com",
		}}}, []string{"POST"})
	})
}

// Mount configures the mux to serve the JSON-RPC JSONRPCCORS service methods.
func (s *Server) Mount(mux loomhttp.Muxer) {
	Mount(mux, s)
}
