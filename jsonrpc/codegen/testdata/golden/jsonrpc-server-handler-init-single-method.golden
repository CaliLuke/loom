// NewAddHandler creates a JSON-RPC handler which calls the "calc" service
// "add" endpoint. The errhandler callback is optional and may be nil.
func NewAddHandler(endpoint loom.Endpoint, mux loomhttp.Muxer, decoder func(*http.Request) loomhttp.Decoder, encoder func(context.Context, http.ResponseWriter) loomhttp.Encoder, errhandler func(context.Context, http.ResponseWriter, error)) func(ctx context.Context, r *http.Request, req *jsonrpc.RawRequest, w http.ResponseWriter) error {
	decodeParams := DecodeAddRequest(mux, decoder)
	return func(ctx context.Context, r *http.Request, req *jsonrpc.RawRequest, w http.ResponseWriter) error {
		ctx = context.WithValue(ctx, loom.MethodKey, "add")
		ctx = context.WithValue(ctx, loom.ServiceKey, "calc")

		params, err := decodeParams(r, req)
		if err != nil {
			loomtransport.RequestObserverFromContext(ctx).Fail(loomtransport.ReasonInvalidJSONRPCParams)
			if req.HasID {
				code := jsonrpc.InternalError
				errorResponse := loom.ResolveErrorResponse(err)
				// nolint:errorlint // Response ownership is already resolved.
				if serviceError, ok := errorResponse.Owner.(*loom.ServiceError); ok {
					code = jsonrpc.CodeForServiceError(serviceError)
				}
				encodeJSONRPCError(ctx, w, req, code, loom.ErrorSafeMessage(err), jsonrpc.NewErrorData(err), encoder, errhandler)
			} else {
				jsonrpc.ReportFailure(ctx, w, errhandler, fmt.Errorf("failed to decode parameters: %w", err))
			}
			return nil
		}
		res, err := endpoint(ctx, params)
		if err != nil {
			loomtransport.RequestObserverFromContext(ctx).Fail(loomtransport.ReasonHandlerError)
			if req.HasID {
				errorResponse := loom.ResolveErrorResponse(err)
				if errorResponse.Owner == nil {
					code := jsonrpc.InternalError
					// nolint:errorlint // Response ownership is already resolved.
					if serviceError, ok := errorResponse.Owner.(*loom.ServiceError); ok {
						code = jsonrpc.CodeForServiceError(serviceError)
					}
					encodeJSONRPCError(ctx, w, req, code, loom.ErrorSafeMessage(err), jsonrpc.NewErrorData(err), encoder, errhandler)
					return nil
				}
				switch errorResponse.Name {
				case "invalid_params":
					encodeJSONRPCError(ctx, w, req, jsonrpc.InvalidParams, loom.ErrorSafeMessage(err), jsonrpc.NewErrorData(err), encoder, errhandler)
				case "method_not_found":
					encodeJSONRPCError(ctx, w, req, jsonrpc.MethodNotFound, loom.ErrorSafeMessage(err), jsonrpc.NewErrorData(err), encoder, errhandler)
				default:
					code := jsonrpc.InternalError
					// nolint:errorlint // Response ownership is already resolved.
					if serviceError, ok := errorResponse.Owner.(*loom.ServiceError); ok {
						code = jsonrpc.CodeForServiceError(serviceError)
					}
					encodeJSONRPCError(ctx, w, req, code, loom.ErrorSafeMessage(err), jsonrpc.NewErrorData(err), encoder, errhandler)
				}
			} else {
				jsonrpc.ReportFailure(ctx, w, errhandler, fmt.Errorf("endpoint error: %w", err))
			}
			return nil
		}

		id := req.ID
		if !req.HasID {
			return nil
		}
		var body any
		{
			res := res.(string)
			body = res
		}

		response := jsonrpc.MakeSuccessResponse(id, body)
		if err := encoder(ctx, w).Encode(response); err != nil {
			loomtransport.RequestObserverFromContext(ctx).Fail(loomtransport.ReasonResponseWriteFailed)
			jsonrpc.ReportFailure(ctx, w, errhandler, fmt.Errorf("failed to encode JSON-RPC response: %w", err))
		}
		return nil
	}
}
