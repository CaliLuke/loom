// DecodeTransferResponse returns a decoder for responses returned by the calc
// service transfer JSON-RPC method. restoreBody controls whether the response
// body should be restored after having been read.
func DecodeTransferResponse(decoder func(*http.Response) loomhttp.Decoder, restoreBody bool) func(*http.Response) (any, error) {
	return func(resp *http.Response) (any, error) {
		return loomhttp.DecodeResponse(resp, restoreBody, false, func(resp *http.Response) (any, error) {
			if resp.StatusCode != http.StatusOK {
				body, err := loomhttp.ReadUnexpectedResponseBody(resp)
				if err != nil {
					return nil, err
				}
				return nil, loomhttp.ErrInvalidResponse("calc", "transfer", resp.StatusCode, string(body))
			}

			var jresp jsonrpc.RawResponse
			if err := decoder(resp).Decode(&jresp); err != nil {
				return nil, loomhttp.ErrDecodingError("calc", "transfer", err)
			}

			if jresp.Error != nil {
				return nil, decodeTransferError(decoder, resp, jresp.Error)
			}

			resp.Body = io.NopCloser(bytes.NewBuffer(jresp.Result))
			var (
				body string
				err  error
			)
			err = decoder(resp).Decode(&body)
			if err != nil {
				return nil, loomhttp.ErrDecodingError("calc", "transfer", err)
			}
			return body, nil
		})
	}
}
func decodeTransferError(decoder func(*http.Response) loomhttp.Decoder, resp *http.Response, wire *jsonrpc.RawErrorResponse) error {
	switch wire.Code {
	case 4200:
		return jsonrpc.DecodeErrorResponse("calc", "transfer", wire, resp, []jsonrpc.ErrorCandidate{{Name: "insufficient_funds", Selector: []string{"code"}, Decode: func(resp *http.Response) (error, error) {
			var (
				body TransferInsufficientFundsResponseBody
				err  error
			)
			err = decoder(resp).Decode(&body)
			if err != nil {
				return nil, loomhttp.ErrDecodingError("calc", "transfer", err)
			}
			err = ValidateTransferInsufficientFundsResponseBody(&body)
			if err != nil {
				return nil, loomhttp.ErrValidationError("calc", "transfer", err)
			}
			return NewTransferInsufficientFunds(&body), nil
		}}, {Name: "account_closed", Selector: []string{"code"}, Decode: func(resp *http.Response) (error, error) {
			var (
				body TransferAccountClosedResponseBody
				err  error
			)
			err = decoder(resp).Decode(&body)
			if err != nil {
				return nil, loomhttp.ErrDecodingError("calc", "transfer", err)
			}
			err = ValidateTransferAccountClosedResponseBody(&body)
			if err != nil {
				return nil, loomhttp.ErrValidationError("calc", "transfer", err)
			}
			return NewTransferAccountClosed(&body), nil
		}}})
	default:
		return wire
	}
}
