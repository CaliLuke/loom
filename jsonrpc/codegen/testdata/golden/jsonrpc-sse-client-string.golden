// StreamClientStream implements the jsonrpcssestringservice.StreamClientStream
// interface using Server-Sent Events.
type StreamClientStream struct {
	reader   *loomhttp.SSEStreamReader
	decoder  func(*http.Response) loomhttp.Decoder
	closed   bool
	lock     sync.Mutex
	readLock sync.Mutex
}

func (s *StreamClientStream) markClosed() {
	s.lock.Lock()
	s.closed = true
	s.lock.Unlock()
}

// Recv reads instances of "string" from the stream.
func (s *StreamClientStream) Recv(ctx context.Context) (string, error) {
	s.readLock.Lock()
	defer s.readLock.Unlock()

	var zero string

	s.lock.Lock()
	if s.closed {
		s.lock.Unlock()
		return zero, io.EOF
	}
	s.lock.Unlock()

	for {
		parsedEvent, err := s.reader.ReadEvent(ctx)
		if err != nil {
			s.markClosed()
			return zero, err
		}

		eventType, data := parsedEvent.Type, []byte(parsedEvent.Data)

		switch eventType {
		case "notification":
			var notification struct {
				JSONRPC string         `json:"jsonrpc"`
				Method  string         `json:"method"`
				Params  jsontext.Value `json:"params"`
			}
			if err := json.Unmarshal(data, &notification); err != nil {
				return zero, fmt.Errorf("failed to parse notification: %w", err)
			}
			if notification.JSONRPC != "2.0" {
				return zero, fmt.Errorf("invalid JSON-RPC version: %s", notification.JSONRPC)
			}
			if notification.Method != "JSONRPCSSEStringService/stream.event" {
				continue
			}
			result, err := s.decodeResult(notification.Params)
			if err != nil {
				return zero, fmt.Errorf("failed to decode result: %w", err)
			}
			return result, nil
		case "response":
			var response jsonrpc.Response
			if err := json.Unmarshal(data, &response); err != nil {
				return zero, fmt.Errorf("failed to parse response: %w", err)
			}
			if response.Error != nil {
				{
					return zero, fmt.Errorf("JSON-RPC error %d: %s", response.Error.Code, response.Error.Message)
				}
			}
			if response.Result == nil {
				return zero, fmt.Errorf("missing result in response")
			}
			resultBytes, err := json.Marshal(response.Result)
			if err != nil {
				return zero, fmt.Errorf("failed to marshal result: %w", err)
			}
			result, err := s.decodeResult(jsontext.Value(resultBytes))
			if err != nil {
				return zero, fmt.Errorf("failed to decode final result: %w", err)
			}
			return result, nil
		case "error":
			var response jsonrpc.Response
			if err := json.Unmarshal(data, &response); err != nil {
				return zero, fmt.Errorf("failed to parse error response: %w", err)
			}
			s.markClosed()
			if response.Error != nil {
				return zero, fmt.Errorf("JSON-RPC error %d: %s", response.Error.Code, response.Error.Message)
			}
			return zero, fmt.Errorf("unexpected error response")
		case "", "message":
			var envelope map[string]jsontext.Value
			if err := json.Unmarshal(data, &envelope); err != nil {
				return zero, fmt.Errorf("failed to parse message event: %w", err)
			}
			if _, ok := envelope["method"]; ok {
				var notification struct {
					JSONRPC string         `json:"jsonrpc"`
					Method  string         `json:"method"`
					Params  jsontext.Value `json:"params"`
				}
				if err := json.Unmarshal(data, &notification); err != nil {
					return zero, fmt.Errorf("failed to parse notification: %w", err)
				}
				if notification.JSONRPC != "2.0" {
					return zero, fmt.Errorf("invalid JSON-RPC version: %s", notification.JSONRPC)
				}
				if notification.Method != "JSONRPCSSEStringService/stream.event" {
					continue
				}
				result, err := s.decodeResult(notification.Params)
				if err != nil {
					return zero, fmt.Errorf("failed to decode result: %w", err)
				}
				return result, nil
			}
			var response jsonrpc.Response
			if err := json.Unmarshal(data, &response); err != nil {
				return zero, fmt.Errorf("failed to parse response: %w", err)
			}
			if response.Error != nil {
				{
					s.markClosed()
					return zero, fmt.Errorf("JSON-RPC error %d: %s", response.Error.Code, response.Error.Message)
				}
			}
			if response.Result == nil {
				return zero, fmt.Errorf("missing result in response")
			}
			resultBytes, err := json.Marshal(response.Result)
			if err != nil {
				return zero, fmt.Errorf("failed to marshal result: %w", err)
			}
			result, err := s.decodeResult(jsontext.Value(resultBytes))
			if err != nil {
				return zero, fmt.Errorf("failed to decode final result: %w", err)
			}
			s.markClosed()
			return result, nil
		default:
			continue
		}
	}
}
func (s *StreamClientStream) decodeResult(data jsontext.Value) (string, error) {
	resp := &http.Response{
		Body:       io.NopCloser(bytes.NewReader(data)),
		StatusCode: http.StatusOK,
	}
	decoder := s.decoder(resp)
	var result string
	if err := decoder.Decode(&result); err != nil {
		return result, err
	}
	return result, nil
}

// Close closes the stream.
func (s *StreamClientStream) Close() error {
	s.markClosed()
	return s.reader.Close()
}
