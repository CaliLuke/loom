// DecodeShowResponse returns a decoder for responses returned by the viewer
// service show JSON-RPC method. restoreBody controls whether the response body
// should be restored after having been read.
func DecodeShowResponse(decoder func(*http.Response) loomhttp.Decoder, restoreBody bool) func(*http.Response) (any, error) {
	return func(resp *http.Response) (any, error) {
		return loomhttp.DecodeResponse(resp, restoreBody, false, func(resp *http.Response) (any, error) {
			if resp.StatusCode != http.StatusOK {
				body, err := loomhttp.ReadUnexpectedResponseBody(resp)
				if err != nil {
					return nil, err
				}
				return nil, loomhttp.ErrInvalidResponse("viewer", "show", resp.StatusCode, string(body))
			}

			var jresp jsonrpc.RawResponse
			if err := decoder(resp).Decode(&jresp); err != nil {
				return nil, loomhttp.ErrDecodingError("viewer", "show", err)
			}

			if jresp.Error != nil {
				switch jresp.Error.Code {
				default:
					return nil, jresp.Error
				}
			}

			resp.Body = io.NopCloser(bytes.NewBuffer(jresp.Result))
			var (
				body ShowResponseBodyTiny
				err  error
			)
			err = decoder(resp).Decode(&body)
			if err != nil {
				return nil, loomhttp.ErrDecodingError("viewer", "show", err)
			}
			p := NewShowFixedViewResultOK(&body)
			view := "tiny"
			vres := &viewerviews.FixedViewResult{Projected: p, View: view}
			if err = viewerviews.ValidateFixedViewResult(vres); err != nil {
				return nil, loomhttp.ErrValidationError("viewer", "show", err)
			}
			res, err := viewer.NewFixedViewResult(vres)
			if err != nil {
				return nil, loomhttp.ErrValidationError("viewer", "show", err)
			}
			return res, nil
		})
	}
}
