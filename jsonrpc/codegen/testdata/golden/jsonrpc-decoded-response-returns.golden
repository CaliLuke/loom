// case: result-init
func testcase() {
	res := NewShowResult(&body)
	return res, nil
}

// case: result-init-tag-value
func testcase() {
	res := NewShowResult(&body)
	res.Status = "ok"
	return res, nil
}

// case: result-init-tag-pointer
func testcase() {
	res := NewShowResult(&body)
	tmp := "ok"
	res.Status = &tmp
	return res, nil
}

